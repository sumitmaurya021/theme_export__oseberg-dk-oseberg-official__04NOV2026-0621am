<section class="swiper-section">
  <div class="container">
    <h2>{{ section.settings.main_heading }}</h2>
    <p>{{ section.settings.sub_heading }}</p>
    <div class="swiper mySwiper">
      <div class="swiper-wrapper">
        {% for block in section.blocks %}
          <div class="swiper-slide">
            <a href="{{ block.settings.feature_link }}">
              {% if block.settings.feature_image %}
                <img src="{{ block.settings.feature_image | img_url: 'medium' }}" alt="{{ block.settings.feature_title }}">
              {% endif %}
              <h3>{{ block.settings.feature_title }}</h3>
              <p>{{ block.settings.feature_description }}</p>
            </a>
          </div>
        {% endfor %}
      </div>

      <div class="swiper-button-next"></div>
      <div class="swiper-button-prev"></div>
      <div class="swiper-scrollbar"></div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Custom Swiper Section",
  "settings": [
    {
      "type": "text",
      "id": "main_heading",
      "label": "Main Heading",
      "default": "Our Features"
    },
    {
      "type": "text",
      "id": "sub_heading",
      "label": "Subtext Heading",
      "default": "Explore the best services we offer"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature Block",
      "settings": [
        {
          "type": "image_picker",
          "id": "feature_image",
          "label": "Feature Image"
        },
        {
          "type": "text",
          "id": "feature_title",
          "label": "Feature Title",
          "default": "Feature Name"
        },
        {
          "type": "textarea",
          "id": "feature_description",
          "label": "Feature Description",
          "default": "Short description of the feature."
        },
        {
          "type": "url",
          "id": "feature_link",
          "label": "Feature Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Swiper Section"
    }
  ]
}
{% endschema %}


