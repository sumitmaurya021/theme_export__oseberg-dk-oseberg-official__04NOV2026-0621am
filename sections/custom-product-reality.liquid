{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="custom-product-reality-section section-{{ section.id }}-padding">
<div class="custom-product-reality page-width">
  <h2>{{ section.settings.heading }}</h2>
  <div class="swiper custom-product-reality-swiper">
    <div class="swiper-wrapper">
      {% for block in section.blocks %}
        <div class="swiper-slide">
          <a href="{{ block.settings.link }}">
            <div class="slide-image">
              <img src="{{ block.settings.image | img_url: 'large' }}" alt="Slide Image">
              <button class="shop-button"><span class="shop-btn-text">{{ block.settings.button_text }}</span>{% render 'icon-cart-btn' %}</button>
            </div>
            <div class="user-info">
              <img src="{{ block.settings.profile_image | img_url: 'thumb' }}" alt="Profile">
              <div class="user-info-name">
                <span class="username">{{ block.settings.username }}</span>
                <span class="handle">{{ block.settings.handle }}</span>
              </div>
            </div>
          </a>
        </div>
      {% endfor %}
    </div>
    <div class="swiper-scrollbar"></div>
    <div class="swiper-button-next"></div>
    <div class="swiper-button-prev"></div>
  </div>
</div>
</div>

{% schema %}
{
  "name": "Custom Product Reality",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Slide Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Slide Link"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button Text",
          "default": "Shop Now"
        },
        {
          "type": "image_picker",
          "id": "profile_image",
          "label": "Profile Image"
        },
        {
          "type": "text",
          "id": "username",
          "label": "Username"
        },
        {
          "type": "text",
          "id": "handle",
          "label": "User Handle"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Product Reality",
      "category": "Image"
    }
  ]
}
{% endschema %}
{% comment %}
<script>
  document.addEventListener("DOMContentLoaded", function () {
    new Swiper(".custom-product-reality-swiper", {
      loop: false,
      slidesPerView: 1,
      spaceBetween: 10,
      navigation: {
        nextEl: ".swiper-button-next",
        prevEl: ".swiper-button-prev"
      },
      scrollbar: {
      el: ".swiper-scrollbar",
      hide: false,
      draggable: true,
      },
      pagination: {
        el: ".swiper-pagination",
        clickable: true
      },
      breakpoints: {
        768: { slidesPerView: 2 },
        1024: { slidesPerView: 4 }
      }
    });
  });
</script>
{% endcomment %}

<script>
  document.addEventListener("DOMContentLoaded", function () {
    let swiperContainer = document.querySelector(".custom-product-reality-swiper");
    let slides = swiperContainer.querySelectorAll(".swiper-slide");
    let totalSlides = slides.length;
    let isMobile = window.innerWidth < 1024;

    if (totalSlides > 4 || isMobile) {
      new Swiper(".custom-product-reality-swiper", {
        loop: false,
        slidesPerView: isMobile ? 1 : (totalSlides >= 4 ? 4 : totalSlides), // Mobile pe 1 slide, Desktop pe proper layout
        spaceBetween: 10,
        navigation: totalSlides > 4 ? {
          nextEl: ".swiper-button-next",
          prevEl: ".swiper-button-prev"
        } : false,
        scrollbar: {
          el: ".swiper-scrollbar",
          hide: false,
          draggable: true
        },
        breakpoints: {
          768: { slidesPerView: 2 },
          1024: { slidesPerView: totalSlides >= 4 ? 4 : totalSlides }
        }
      });
    } else {
      swiperContainer.classList.add("custom-product-grid-reality");
    }
  });
</script>


<style>
.custom-product-grid-reality {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
  justify-content: center;
}
.custom-product-grid-reality .swiper-slide {
  flex: 1 1 calc(25% - 10px); 
  max-width: calc(25% - 10px);
}
.custom-product-reality-section {
    background: #f0f7f4;
    overflow: hidden;
}
.custom-product-reality-section .swiper{
    overflow: visible;
    margin-top: 24px;
}
.custom-product-reality-section .swiper .swiper-scrollbar{
    position: relative;
    margin-top: 30px;
    background: transparent;
    border-bottom: 1px solid #9fa5aa;
    border-radius: 0;
    height: 8px;
    top: 0;
    bottom: auto;
    transition: all .2s !important;
    padding-top: 6px;
    cursor: grab;
}
.custom-product-reality-section .swiper .swiper-scrollbar:hover{
    padding-top: 0px;
}
.custom-product-reality-section .swiper .swiper-button-next{
    top: -50px;
    right: 0;
    width:32px;
    height:32px;
}
.custom-product-reality-section .swiper .swiper-button-prev{
    top: -50px;
    left: auto;
    right: 32px;
    width:32px;
    height:32px;
}
.custom-product-reality-section .swiper .swiper-button-next::after{
    font-size: 16px !important;
    color: rgba(18, 18, 18, 0.75);
}
.custom-product-reality-section .swiper .swiper-button-prev::after{
    font-size: 16px !important;
    color: rgba(18, 18, 18, 0.75);
}
.custom-product-reality-section .swiper .swiper-wrapper .swiper-slide{
    margin-right: 20px !important;
    background: transparent;
    padding:0px;
}
.custom-product-reality-section .swiper .swiper-wrapper .slide-image img{
    aspect-ratio: 1/1;
    object-fit: cover;
    border-radius: 20px;
    transition: 0.5s cubic-bezier(0,0,.2,1);
}
.custom-product-reality-section .swiper .swiper-wrapper .swiper-slide a:hover .slide-image img{
    transform: scale(1.05);
}
.custom-product-reality-section .swiper .swiper-wrapper .slide-image{
    line-height:0;
    margin-bottom:16px;
    border-radius: 20px;
    overflow:hidden;
}
.custom-product-reality-section .swiper .swiper-wrapper .user-info{
    padding-top: 0px;
    padding-left: 16px;
    gap: 16px;
}
.custom-product-reality-section .swiper .swiper-wrapper .user-info img{
    width: 48px;
    height: 48px;
    border-radius: 9999px;
}
.custom-product-reality-section .swiper .swiper-wrapper .user-info .user-info-name{
    display: flex;
    flex-direction: column;
    gap: 8px;
}
.custom-product-reality-section .swiper .swiper-slide a{
    text-decoration: none;
}
.custom-product-reality-section .swiper .swiper-wrapper .user-info .user-info-name .username {
    font-size: 14px;
    line-height: 20px;
    font-weight: 700;
    text-align: start;
    color:#0E1F2A;
}
.custom-product-reality-section .swiper .swiper-wrapper .user-info .user-info-name .handle {
    font-size: 14px;
    line-height: 1em;
    color: #0E1F2A;
    font-weight: 700;
}
.custom-product-reality-section .swiper .swiper-wrapper .swiper-slide a .shop-button{
    display: flex;
    padding: 10px;
    border-radius: 9999px;
    background: #FFFFFF;
    align-items:center;
    max-height:40px;
    gap:8px;
}
.custom-product-reality-section .swiper .swiper-wrapper .swiper-slide a .shop-button svg path{
    stroke: #6c8484;
}
.custom-product-reality-section .swiper .swiper-wrapper .swiper-slide a .shop-button .shop-btn-text{
    font-size: 16px;
    font-weight: 500;
    line-height: 1em;
    color: #6c8484;
}
/* .custom-product-reality-section .swiper .swiper-wrapper .swiper-slide a:hover .shop-button .shop-btn-text{
    width:calc(100% - 28px);
    opacity:1;
} */

@media (max-width: 1024px) {
  .custom-product-grid-reality .swiper-slide {
    flex: 1 1 calc(50% - 10px);
    max-width: calc(50% - 10px);
  }
}

@media (max-width: 768px) {
  .custom-product-grid-reality .swiper-slide {
    flex: 1 1 100%; 
    max-width: 100%;
  }
}
</style>


<style>
  .custom-product-reality {
    text-align: center;
  }
  .custom-product-reality-swiper {
    overflow: hidden;
    position: relative;
  }
  .swiper-slide {
    background: #fff;
    border-radius: 8px;
    padding: 10px;
  }
  .slide-image {
    position: relative;
  }
  .slide-image img {
    width: 100%;
    border-radius: 8px;
  }
  .shop-button {
    position: absolute;
    top: 10px;
    left: 10px;
    background: orange;
    color: white;
    padding: 5px 10px;
    border: none;
    cursor: pointer;
  }
  .user-info {
    display: flex;
    align-items: center;
    padding-top: 10px;
  }
  .user-info img {
    width: 40px;
    height: 40px;
    border-radius: 50%;
  }
  .username {
    font-weight: bold;
  }
  .handle {
    font-size: 12px;
    color: gray;
  }
</style>
