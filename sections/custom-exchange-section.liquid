<script>
  {% comment %}
  document.addEventListener("DOMContentLoaded", function () {
    const toggleBtn = document.getElementById("toggle-btn");
    const hiddenItems = document.querySelectorAll(".custom-list-item.hidden");
    let isExpanded = false; // Track if list is expanded

    if (toggleBtn) {
      toggleBtn.addEventListener("click", function () {
        hiddenItems.forEach(item => item.classList.toggle("hidden"));
        isExpanded = !isExpanded; // Toggle state

        // Change button text dynamically
        toggleBtn.textContent = isExpanded ? "Skjul " : "Read More";
      });
    }
  });
  {% endcomment %}

  document.addEventListener("DOMContentLoaded", function () {
  const toggleBtn = document.getElementById("toggle-btn");
  const hiddenItems = document.querySelectorAll(".custom-list-item.hidden");
  let isExpanded = false; // Track if list is expanded

  if (toggleBtn) {
    toggleBtn.addEventListener("click", function () {
      hiddenItems.forEach(item => item.classList.toggle("hidden"));
      isExpanded = !isExpanded; // Toggle state

      // Change button text dynamically with a span tag and an SVG
      toggleBtn.innerHTML = isExpanded 
        ? `<span title="Skjul">Skjul</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true" class="stroke-current" role="img" stroke="currentColor">
             <path d="M2.92893 11.9289L9.29289 5.56501C9.68342 5.17449 10.3166 5.17449 10.7071 5.56501L17.0711 11.9289" stroke-width="1.5" stroke-linecap="round"/>
             <title>chevron-up</title>
           </svg>` 
        : `<span title="Se mere">Se mere</span> <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true" class="stroke-current" role="img" stroke="currentColor">
             <path d="M17.0711 8.07107L10.7071 14.435C10.3166 14.8256 9.68342 14.8256 9.29289 14.435L2.92893 8.07107" stroke-width="1.5" stroke-linecap="round"/>
             <title>chevron-down</title>
           </svg>`; 
    });
  }
});


</script>
