{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<style>
  .custom-exchange-content .custom-exchange-details .ced-box-wrap .custom-list:after {
    background-image: linear-gradient(to top,#daeaea,#daeaea00);
    background-image: linear-gradient(to top,{{ section.settings.bg_color }},{{ section.settings.bg_color }}00);
  }
</style>
<section class="custom-exchange-section section-{{ section.id }}-padding" style="background-color: {{ section.settings.bg_color }};">
  <div class="page-width">
    <div class="custom-exchange-container">
      <div class="custom-exchange-header">
        <span class="custom-exchange-tag">{{ section.settings.tag }}</span>
        <h2 class="custom-exchange-title">{{ section.settings.title }}</h2>
      </div>
      <div class="custom-exchange-content">
        <div class="custom-exchange-box">
          <div class="ce-box-wrap">
            <p class="custom-exchange-text">{{ section.settings.content }}</p>
            <a href="{{ section.settings.button_link }}" class="custom-exchange-button">
              <span title="{{ section.settings.button_label }}">{{ section.settings.button_label }}</span>
            </a>
          </div>
        </div>
        <div class="custom-exchange-details">
          <div class="ced-box-wrap">
            <h3 class="custom-exchange-subtitle">{{ section.settings.info_title }}</h3>
            <ul class="custom-list">
              {% for block in section.blocks %}
                <li class="custom-list-item {% if forloop.index > 3 %}hidden{% endif %}">
                  {{ block.settings.item_list }}
                </li>
              {% endfor %}
            </ul>
            {% if section.blocks.size > 3 %}
              <button class="custom-exchange-toggle" id="toggle-btn">
                <span title="{{ section.settings.toggle_text }}">{{ section.settings.toggle_text }}</span>
                {{- 'custom-down-arrow.svg' | inline_asset_content -}}
              </button>
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Custom Exchange Section",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f9f3ee"
    },
    {
      "type": "text",
      "id": "tag",
      "label": "Tag",
      "default": "Ombytning"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Opret ombytning"
    },
    {
      "type": "textarea",
      "id": "content",
      "label": "Text Content"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Opret ombytning"
    },
    {
      "type": "text",
      "id": "info_title",
      "label": "Information Title",
      "default": "Praktiske oplysninger"
    },
    {
      "type": "text",
      "id": "toggle_text",
      "label": "Toggle Button Text",
      "default": "Read More"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "List",
      "settings": [
        {
          "type": "text",
          "id": "item_list",
          "label": "List Item"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Exchange Section"
    }
  ]
}
{% endschema %}
