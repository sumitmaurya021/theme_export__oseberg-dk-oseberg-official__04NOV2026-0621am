{%- style -%}
  #shero2-{{ section.id }} {
    --sh-eyebrow: {{ section.settings.eyebrow_color }};
    --sh-title: {{ section.settings.title_color }};
    --sh-subtitle: {{ section.settings.subtitle_color }};
    --sh-desc: {{ section.settings.desc_color }};
    --sh-btn-bg: {{ section.settings.button_bg }};
    --sh-btn-color: {{ section.settings.button_color }};
    --sh-btn-hover-bg: {{ section.settings.button_hover_bg }};
    --sh-btn-hover-color: {{ section.settings.button_hover_color }};
    --sh-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --sh-min-h: {{ section.settings.min_height }}px;
    --sh-min-h-mobile: {{ section.settings.min_height_mobile }}px;
    position: relative;
    background: {{ section.settings.bg_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    overflow: hidden;
  }

  #shero2-{{ section.id }} .sh__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  #shero2-{{ section.id }} .sh__bg picture,
  #shero2-{{ section.id }} .sh__bg img,
  #shero2-{{ section.id }} .sh__bg svg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: {{ section.settings.image_focus }};
    display: block;
  }

  #shero2-{{ section.id }} .sh__bg::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      to right,
      rgba(48, 40, 33, var(--sh-overlay)) 0%,
      rgba(48, 40, 33, calc(var(--sh-overlay) * 0.5)) 45%,
      rgba(48, 40, 33, 0) 75%
    );
  }

  #shero2-{{ section.id }} .sh__inner {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: {{ section.settings.vertical_align }};
    min-height: var(--sh-min-h);
  }

  #shero2-{{ section.id }} .sh__content {
    width: 100%;
    max-width: 520px;
    min-width: 0;
  }

  #shero2-{{ section.id }} .sh__eyebrow {
    margin: 0 0 16px;
    color: var(--sh-eyebrow);
    font-family: var(--font-sans, 'Jost', 'Helvetica Neue', Arial, sans-serif);
    font-size: 12px;
    font-weight: 400;
    line-height: 1.4;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  #shero2-{{ section.id }} .sh__title {
    margin: 0 0 8px;
    color: var(--sh-title);
    font-family: var(--font-serif, 'Playfair Display', Georgia, 'Times New Roman', serif);
    font-size: clamp(28px, 3.2vw, 48px);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: 0.01em;
    text-wrap: balance;
    overflow-wrap: break-word;
  }

  #shero2-{{ section.id }} .sh__subtitle {
    margin: 0 0 24px;
    color: var(--sh-subtitle);
    font-family: var(--font-serif, 'Playfair Display', Georgia, 'Times New Roman', serif);
    font-size: clamp(22px, 2.4vw, 36px);
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: 0.01em;
    text-wrap: balance;
    overflow-wrap: break-word;
  }

  #shero2-{{ section.id }} .sh__desc {
    margin: 0 0 32px;
    max-width: 440px;
    color: var(--sh-desc);
    font-family: var(--font-sans, 'Jost', 'Helvetica Neue', Arial, sans-serif);
    font-size: clamp(14px, 1.05vw, 16px);
    font-weight: 400;
    line-height: 1.6;
    letter-spacing: normal;
  }

  #shero2-{{ section.id }} .sh__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    max-width: 100%;
    padding: clamp(14px, 1.2vw, 18px) clamp(24px, 2.4vw, 36px);
    background: var(--sh-btn-bg);
    color: var(--sh-btn-color);
    font-family: var(--font-sans, 'Jost', 'Helvetica Neue', Arial, sans-serif);
    font-size: 12px;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: 0.15em;
    text-align: center;
    text-transform: uppercase;
    text-decoration: none;
    border: 1px solid var(--sh-btn-bg);
    border-radius: 0;
    transition: background 0.4s ease, color 0.4s ease, border-color 0.4s ease;
  }

  #shero2-{{ section.id }} .sh__button::before,
  #shero2-{{ section.id }} .sh__button::after {
    content: none !important;
    display: none !important;
  }

  #shero2-{{ section.id }} .sh__button:hover {
    background: var(--sh-btn-hover-bg);
    color: var(--sh-btn-hover-color);
    border-color: var(--sh-btn-hover-bg);
  }

  @media screen and (min-width: 750px) and (max-width: 989px) {
    #shero2-{{ section.id }} .sh__title { font-size: clamp(32px, 5vw, 44px); }
    #shero2-{{ section.id }} .sh__subtitle { font-size: clamp(24px, 3.6vw, 32px); }
    #shero2-{{ section.id }} .sh__content { max-width: 480px; }
  }

  @media screen and (max-width: 749px) {
    #shero2-{{ section.id }} .sh__inner {
      min-height: var(--sh-min-h-mobile);
      align-items: flex-end;
    }
    #shero2-{{ section.id }} .sh__content { max-width: 100%; }
    #shero2-{{ section.id }} .sh__title { margin-bottom: 6px; }
    #shero2-{{ section.id }} .sh__subtitle { margin-bottom: 18px; }
    #shero2-{{ section.id }} .sh__desc { margin-bottom: 24px; max-width: 100%; }
    #shero2-{{ section.id }} .sh__button { width: 100%; }

    #shero2-{{ section.id }} .sh__bg::after {
      background: linear-gradient(
        to top,
        rgba(48, 40, 33, calc(var(--sh-overlay) + 0.25)) 0%,
        rgba(48, 40, 33, calc(var(--sh-overlay) * 0.6)) 55%,
        rgba(48, 40, 33, 0) 100%
      );
    }
  }

  /* ============================================
     ANIMATIONS (premium, subtle)
     JS chalega to hi hide hota hai, warna content hamesha visible rahega
     ============================================ */
  #shero2-{{ section.id }}.sh-anim .sh__content > * {
    opacity: 0;
    transform: translateX(-28px);
    transition:
      opacity 1s cubic-bezier(0.22, 0.61, 0.36, 1),
      transform 1s cubic-bezier(0.22, 0.61, 0.36, 1),
      background 0.4s ease, color 0.4s ease, border-color 0.4s ease;
    transition-delay: calc(var(--sh-ci, 0) * 0.12s), calc(var(--sh-ci, 0) * 0.12s), 0s, 0s, 0s;
    will-change: opacity, transform;
  }

  #shero2-{{ section.id }}.sh-anim .sh__bg img,
  #shero2-{{ section.id }}.sh-anim .sh__bg svg {
    transform: scale(1.06);
    transition: transform 2.4s cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  #shero2-{{ section.id }}.sh-anim.is-visible .sh__content > * {
    opacity: 1;
    transform: translateX(0);
  }

  #shero2-{{ section.id }}.sh-anim.is-visible .sh__bg img,
  #shero2-{{ section.id }}.sh-anim.is-visible .sh__bg svg {
    transform: scale(1);
  }

  #shero2-{{ section.id }}.sh-anim.is-done .sh__content > * {
    transition-delay: 0s;
    will-change: auto;
  }

  @media screen and (max-width: 749px) {
    #shero2-{{ section.id }}.sh-anim .sh__content > * { transform: translateY(20px); }
    #shero2-{{ section.id }}.sh-anim.is-visible .sh__content > * { transform: translateY(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    #shero2-{{ section.id }}.sh-anim .sh__content > * {
      opacity: 1;
      transform: none;
      transition: none;
    }
    #shero2-{{ section.id }}.sh-anim .sh__bg img,
    #shero2-{{ section.id }}.sh-anim .sh__bg svg {
      transform: none;
      transition: none;
    }
  }
{%- endstyle -%}

<div id="shero2-{{ section.id }}" class="custom-story-hero-2">
  <div class="sh__bg">
    {%- if section.settings.image != blank -%}
      <picture>
        {%- if section.settings.image_mobile != blank -%}
          <source
            media="(max-width: 749px)"
            srcset="{{ section.settings.image_mobile | image_url: width: 750 }} 750w,
                    {{ section.settings.image_mobile | image_url: width: 1100 }} 1100w,
                    {{ section.settings.image_mobile | image_url: width: 1500 }} 1500w"
            sizes="100vw"
          >
        {%- endif -%}
        <img
          src="{{ section.settings.image | image_url: width: 2000 }}"
          srcset="{{ section.settings.image | image_url: width: 750 }} 750w,
                  {{ section.settings.image | image_url: width: 1100 }} 1100w,
                  {{ section.settings.image | image_url: width: 1500 }} 1500w,
                  {{ section.settings.image | image_url: width: 2000 }} 2000w,
                  {{ section.settings.image | image_url: width: 2400 }} 2400w"
          sizes="100vw"
          alt="{{ section.settings.image.alt | default: section.settings.title | escape }}"
          width="{{ section.settings.image.width }}"
          height="{{ section.settings.image.height }}"
          loading="lazy"
        >
      </picture>
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag }}
    {%- endif -%}
  </div>

  <div class="sh__inner {% unless section.settings.full_width %}page-width{% endunless %}">
    <div class="sh__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="sh__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      {%- if section.settings.title != blank -%}
        <h2 class="sh__title">{{ section.settings.title | escape | newline_to_br }}</h2>
      {%- endif -%}

      {%- if section.settings.subtitle != blank -%}
        <p class="sh__subtitle">{{ section.settings.subtitle | escape | newline_to_br }}</p>
      {%- endif -%}

      {%- if section.settings.description != blank -%}
        <p class="sh__desc">{{ section.settings.description | escape | newline_to_br }}</p>
      {%- endif -%}

      {%- if section.settings.button_text != blank and section.settings.button_link != blank -%}
        <a href="{{ section.settings.button_link }}" class="sh__button">{{ section.settings.button_text | escape }}</a>
      {%- endif -%}
    </div>
  </div>
</div>

<script>
  (function () {
    var section = document.getElementById('shero2-{{ section.id }}');
    if (!section) return;

    var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduced || !('IntersectionObserver' in window)) return;

    section.querySelectorAll('.sh__content > *').forEach(function (el, i) {
      el.style.setProperty('--sh-ci', i);
    });

    section.classList.add('sh-anim');

    var observer = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          section.classList.add('is-visible');
          observer.unobserve(section);
          window.setTimeout(function () {
            section.classList.add('is-done');
          }, 2200);
        }
      });
    }, { threshold: 0.15 });

    observer.observe(section);
  })();
</script>

{% schema %}
{
  "name": "Custom Story Hero 2",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "header", "content": "Background Image" },
    { "type": "image_picker", "id": "image", "label": "Image (Desktop)" },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Image (Mobile, optional)",
      "info": "Khaali = desktop image mobile pe bhi dikhegi."
    },
    {
      "type": "select",
      "id": "image_focus",
      "label": "Image Focus",
      "default": "center center",
      "info": "Image ka kaun sa hissa dikhna chahiye (crop hone par).",
      "options": [
        { "value": "center center", "label": "Center" },
        { "value": "center top", "label": "Top" },
        { "value": "center bottom", "label": "Bottom" },
        { "value": "left center", "label": "Left" },
        { "value": "right center", "label": "Right" }
      ]
    },
    { "type": "range", "id": "overlay_opacity", "min": 0, "max": 80, "step": 5, "unit": "%", "label": "Text Overlay Darkness", "default": 35 },

    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Small Heading", "default": "Vores historie" },
    { "type": "textarea", "id": "title", "label": "Title (new line = line break)", "default": "Mere end\nen sofa." },
    { "type": "textarea", "id": "subtitle", "label": "Subtitle (new line = line break)", "default": "Et sted at samles." },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description (new line = line break)",
      "default": "Oseberg er skabt med en enkel idé: At skabe sofaer, der bringer mennesker sammen. Sofaer, der indbyder til nærvær, hygge og samvær – uanset om det er en stille morgen, en travl hverdag eller en særlig aften med familie og venner."
    },
    { "type": "text", "id": "button_text", "label": "Button Text", "default": "Se vores sofaer →" },
    { "type": "url", "id": "button_link", "label": "Button Link" },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg_color", "label": "Section Background (image na ho tab)", "default": "#F5F1EA" },
    { "type": "color", "id": "eyebrow_color", "label": "Small Heading Color", "default": "#DED2C3" },
    { "type": "color", "id": "title_color", "label": "Title Color", "default": "#FFFFFF" },
    { "type": "color", "id": "subtitle_color", "label": "Subtitle Color", "default": "#F5F1EA" },
    { "type": "color", "id": "desc_color", "label": "Description Color", "default": "#FFFFFF" },
    { "type": "color", "id": "button_bg", "label": "Button Background", "default": "#A58C76" },
    { "type": "color", "id": "button_color", "label": "Button Text Color", "default": "#FFFFFF" },
    { "type": "color", "id": "button_hover_bg", "label": "Button Hover Background", "default": "#F5F1EA" },
    { "type": "color", "id": "button_hover_color", "label": "Button Hover Text Color", "default": "#302821" },

    { "type": "header", "content": "Layout" },
    {
      "type": "select",
      "id": "vertical_align",
      "label": "Content Vertical Position (Desktop)",
      "default": "center",
      "options": [
        { "value": "flex-start", "label": "Top" },
        { "value": "center", "label": "Middle" },
        { "value": "flex-end", "label": "Bottom" }
      ]
    },
    { "type": "range", "id": "min_height", "min": 320, "max": 900, "step": 20, "unit": "px", "label": "Section Height (Desktop / Tablet)", "default": 560 },
    { "type": "range", "id": "min_height_mobile", "min": 380, "max": 900, "step": 20, "unit": "px", "label": "Section Height (Mobile)", "default": 620 },
    { "type": "checkbox", "id": "full_width", "label": "Full Width", "default": false },

    { "type": "header", "content": "Section Spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding Top", "default": 48 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding Bottom", "default": 48 }
  ],
  "presets": [
    { "name": "Custom Story Hero 2" }
  ]
}
{% endschema %}