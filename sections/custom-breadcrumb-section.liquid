{% comment %} <nav class="custom-breadcrumb" style="background: {{ section.settings.background_color }}">
  <a href="{{ routes.root_url }}">Forside</a>

  {% if template contains 'page' %}
    / <span>{{ page.title }}</span>

  {% elsif template contains 'product' %}
    {% assign current_collection = collection %}
    {% unless current_collection %}
      {% assign current_collection = product.collections.first %}
    {% endunless %}
    {% if current_collection %}
      / <a href="{{ current_collection.url }}">{{ current_collection.title }}</a>
    {% endif %}
    / <span>{{ product.title }}</span>

  {% elsif template contains 'collection' %}
    / <span>{{ collection.title }}</span>

  {% elsif template contains 'blog' %}
    / <span>{{ blog.title }}</span>

  {% elsif template contains 'article' %}
    / <a href="{{ blog.url }}">{{ blog.title }}</a>
    / <span>{{ article.title }}</span>

  {% elsif template contains 'search' %}
    / <span>Search results for "{{ search.terms }}"</span>

  {% elsif template contains 'cart' %}
    / <span>Shopping Cart</span>

  {% endif %}
</nav>




{% schema %}
  {
    "name": "Custom custom-breadcrumb",
    "settings": [
       {
     "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#ebfafa"
    },
    ],
    "class": "custom-bundle-addons-breadcrumbs",
    "presets": [
      {
        "name": "Custom custom-breadcrumb"
      }
    ]
  }
{% endschema %}

