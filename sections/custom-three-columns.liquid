{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="custom-three-columns">
  <div class="custom-three-columns__inner page-width section-{{ section.id }}-padding">
    <div class="custom-three-columns__grid">
      {%- for block in section.blocks -%}
        <div class="custom-three-columns__item" {{ block.shopify_attributes }}>
          {%- if block.settings.number != blank -%}
            <p class="custom-three-columns__number">{{ block.settings.number | escape }}</p>
          {%- endif -%}
          {%- if block.settings.heading != blank -%}
            <h3 class="custom-three-columns__heading">{{ block.settings.heading | escape }}</h3>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <div class="custom-three-columns__text">{{ block.settings.text }}</div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

<style>
  .custom-three-columns {
    --oseberg-ivory: #F5F1EA;
    --oseberg-sand: #DED2C3;
    --oseberg-espresso: #302821;
    --oseberg-taupe: #A58C76;
    --oseberg-white: #FFFFFF;

    background: var(--oseberg-ivory);
    color: var(--oseberg-espresso);
    font-family: 'Jost', sans-serif;
  }

  .custom-three-columns__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 4rem;
  }

  @media screen and (min-width: 750px) {
    .custom-three-columns__grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 2.6rem;
    }
  }

  .custom-three-columns__item {
    border-top: 1px solid var(--oseberg-sand);
    padding-top: 2.4rem;
  }

  .custom-three-columns__number {
    margin: 0 0 1.6rem;
    font-family: 'Jost', sans-serif;
    font-size: 1.2rem;
    letter-spacing: 0.1em;
    color: var(--oseberg-taupe);
  }

  .custom-three-columns__heading {
    margin: 0 0 1.4rem;
    font-family: 'Playfair Display', serif;
    font-weight: 400;
    font-size: 2.4rem;
    line-height: 1.3;
    color: var(--oseberg-espresso);
  }

  .custom-three-columns__text,
  .custom-three-columns__text p {
    margin: 0;
    font-family: 'Jost', sans-serif;
    font-weight: 300;
    font-size: 1.4rem;
    line-height: 1.7;
    color: var(--oseberg-taupe);
  }
</style>

{% schema %}
{
  "name": "Custom Three Columns",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Number",
          "default": "01"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Ro"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Færre ting, bedre valgt. Vi skaber plads til lys, luft og eftertanke.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Three Columns",
      "blocks": [
        { "type": "column" },
        { "type": "column" },
        { "type": "column" }
      ]
    }
  ]
}
{% endschema %}