{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="custom-image-product-slider-container section-{{ section.id }}-padding"  style="background: {{ section.settings.background_color }}">
  <div class="page-width">
  <div class="custom-section-header">
    {% if section.settings.section_subtext %}<h3 class="custom0-section-subtext">{{ section.settings.section_subtext }}</h3>{% endif %}
    {% if section.settings.section_heading %}<h2 class="custom-section-heading">{{ section.settings.section_heading }}</h2>{% endif %}
  </div>
  <div class="custom-section-image-wrapper">
    {% if section.settings.image %}
      <img src="{{ section.settings.image | img_url: 'master' }}" class="custom-section-image">
    {% endif %}
    <span class="custom-overlay"></span>
    <div class="custom-section-content">
      
      <div class="custom-img-headings">
      {% if section.settings.subtext %}<h3 class="custom-subtext">{{ section.settings.subtext }}</h3>{% endif %}
      {% if section.settings.heading %}<h2 class="custom-heading">{{ section.settings.heading }}</h2>{% endif %}
      </div>
      
      <div class="custom-img-description">
      {% if section.settings.description %}<p class="custom-description">{{ section.settings.description }}</p>{% endif %}
      </div>
      
    </div>
  </div>

  <div class="custom-img-product-slider swiper">
  <div class="swiper-wrapper">
    {% for block in section.blocks %}
      <a class="custom-img-slide swiper-slide" href="{{ block.settings.button_link }}">
        {% if block.settings.image != blank %}
          <img src="{{ block.settings.image | img_url: '500x' }}" class="custom-img" loading="lazy" alt="{{ block.settings.title }}">
        {% endif %}
        <span class="custom-img-overlay"></span>
        <div class="custom-img-content">
          <div class="custom-img-titles">
            <span class="custom-img-subtitle">{{ block.settings.sub_Title }}</span>
            <h3 class="custom-img-title">{{ block.settings.main_title }}</h3>
          </div>
          <div class="custom-img-button-container">
            <span class="custom-img-button">
              <span title="{{ block.settings.button_label }}">{{ block.settings.button_label }}</span>
            </span>
          </div>
        </div>
      </a>
    {% endfor %}
  </div>
  <div class="swiper-scrollbar"></div>
</div>
    
  </div>
</div>


{% schema %}
{
  "name": "Custom Img Product Slider",
  "settings": [
     {
      "type": "color",
       "id": "background_color",
       "label": "Background Color",
       "default": "#ebfafa"
    },
    {
      "type": "text",
      "id": "section_subtext",
      "label": "Section Subtext",
      "default": "Den største komfort til de mindste mennesker"
    },
    {
      "type": "text",
      "id": "section_heading",
      "label": "Section Heading",
      "default": "God søvn ændrer alt. Også for børn."
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext",
      "default": "Den største komfort til de mindste mennesker"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "God søvn ændrer alt. Også for børn."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Vores Mini-univers favner tremmesenge, børnesenge, madrasser, sengetøj, dyner, puder og en legesofa — alt i den højeste kvalitet."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background Image"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product Slider",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "sub_Title",
          "label": "Sub Title",
          "default": "MIini-Komfort"
        },
         {
          "type": "text",
          "id": "main_title",
          "label": "Main Title",
          "default": "Sengetøj"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button Label",
          "default": "Se more"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Img Product Slider"
    }
  ]
}
{% endschema %}


<script>
  document.addEventListener("DOMContentLoaded", function() {
  var swiper = new Swiper(".custom-img-product-slider", {
    slidesPerView: 1.5,
    spaceBetween: 10,
    loop: false,
    grabCursor: true,
    scrollbar: {
      el: ".swiper-scrollbar",
      draggable: true
    },
    breakpoints: {
      576: { slidesPerView: 2, spaceBetween: 15 },
      768: { slidesPerView: 2.5, spaceBetween: 20 },
      1024: { slidesPerView: 3, spaceBetween: 25 }
    }
  });
});

</script>