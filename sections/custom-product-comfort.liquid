{%- liquid
  assign mf = product.metafields.custom
  assign cf_img_left = mf.komfort_billede_venstre.value
  assign cf_img_right = mf.komfort_billede_hojre.value
  assign cf_title = mf.komfort_titel.value
  assign cf_points = mf.komfort_punkter.value | strip | newline_to_br | split: '<br />'
-%}

{%- if cf_title != blank or cf_img_left != blank or cf_img_right != blank -%}

{%- style -%}
  #pcomfort-{{ section.id }} {
    --cf-title: {{ section.settings.title_color }};
    --cf-text: {{ section.settings.text_color }};
    --cf-check: {{ section.settings.check_color }};
    --cf-radius: {{ section.settings.image_radius }}px;
    --cf-ratio: {{ section.settings.image_ratio }};
    background: {{ section.settings.bg_color }};
    border-top: 1px solid {{ section.settings.border_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    overflow: hidden;
  }

  #pcomfort-{{ section.id }} .cf__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 28px;
    align-items: center;
  }

  /* ---------- Images ---------- */
  #pcomfort-{{ section.id }} .cf__media {
    position: relative;
    min-width: 0;
    width: 100%;
    aspect-ratio: var(--cf-ratio);
    overflow: hidden;
    border-radius: var(--cf-radius);
    background: #DED2C3;
  }

  #pcomfort-{{ section.id }} .cf__media img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s ease;
  }

  #pcomfort-{{ section.id }} .cf__media:hover img {
    transform: scale(1.04);
  }

  /* ---------- Content ---------- */
  #pcomfort-{{ section.id }} .cf__content { min-width: 0; }

  #pcomfort-{{ section.id }} .cf__title {
    margin: 0 0 24px;
    color: var(--cf-title);
    font-family: var(--font-serif, 'Playfair Display', Georgia, 'Times New Roman', serif);
    font-size: clamp(28px, 3.2vw, 48px);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: 0.01em;
    text-wrap: balance;
    overflow-wrap: break-word;
  }

  #pcomfort-{{ section.id }} .cf__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  #pcomfort-{{ section.id }} .cf__item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    margin: 0 0 12px;
    color: var(--cf-text);
    font-family: var(--font-sans, 'Jost', 'Helvetica Neue', Arial, sans-serif);
    font-size: clamp(14px, 1.05vw, 16px);
    font-weight: 400;
    line-height: 1.6;
    letter-spacing: normal;
  }

  #pcomfort-{{ section.id }} .cf__item:last-child { margin-bottom: 0; }

  #pcomfort-{{ section.id }} .cf__check {
    flex: 0 0 auto;
    width: 16px;
    height: 16px;
    margin-top: 0.35em;
    color: var(--cf-check);
  }

  #pcomfort-{{ section.id }} .cf__check svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* ---------- Tablet (750px - 989px) ---------- */
  @media screen and (min-width: 750px) and (max-width: 989px) {
    #pcomfort-{{ section.id }} .cf__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 32px;
    }
    #pcomfort-{{ section.id }} .cf__content {
      grid-column: 1 / -1;
      order: -1;
    }
    #pcomfort-{{ section.id }} .cf__title { font-size: clamp(32px, 5vw, 44px); }
  }

  /* ---------- Desktop (990px and up) ---------- */
  @media screen and (min-width: 990px) {
    #pcomfort-{{ section.id }} .cf__grid {
      grid-template-columns: minmax(0, 4fr) minmax(0, 4fr) minmax(0, 4fr);
      gap: clamp(24px, 3vw, 48px);
    }
  }

  /* ---------- Mobile (749px and below) ---------- */
  @media screen and (max-width: 749px) {
    #pcomfort-{{ section.id }} .cf__grid { gap: 24px; }
    #pcomfort-{{ section.id }} .cf__content { order: -1; }
    #pcomfort-{{ section.id }} .cf__title { margin-bottom: 18px; }
    #pcomfort-{{ section.id }} .cf__item { margin-bottom: 10px; }
  }

  /* ============================================
     ANIMATIONS (premium, subtle)
     JS chalega to hi hide hota hai, warna content hamesha visible rahega
     ============================================ */
  #pcomfort-{{ section.id }} {
    --cf-left-x: -28px;
    --cf-content-x: 0px;
    --cf-right-x: 28px;
  }

  #pcomfort-{{ section.id }}.cf-anim .cf__media--left {
    opacity: 0;
    transform: translateX(var(--cf-left-x));
    transition:
      opacity 1.1s cubic-bezier(0.22, 0.61, 0.36, 1),
      transform 1.1s cubic-bezier(0.22, 0.61, 0.36, 1);
    will-change: opacity, transform;
  }

  #pcomfort-{{ section.id }}.cf-anim .cf__media--right {
    opacity: 0;
    transform: translateX(var(--cf-right-x));
    transition:
      opacity 1.1s cubic-bezier(0.22, 0.61, 0.36, 1),
      transform 1.1s cubic-bezier(0.22, 0.61, 0.36, 1);
    transition-delay: 0.25s;
    will-change: opacity, transform;
  }

  #pcomfort-{{ section.id }}.cf-anim .cf__title,
  #pcomfort-{{ section.id }}.cf-anim .cf__item {
    opacity: 0;
    transform: translateY(20px);
    transition:
      opacity 1s cubic-bezier(0.22, 0.61, 0.36, 1),
      transform 1s cubic-bezier(0.22, 0.61, 0.36, 1);
    transition-delay: calc(0.12s + var(--cf-ci, 0) * 0.1s);
    will-change: opacity, transform;
  }

  #pcomfort-{{ section.id }}.cf-anim.is-visible .cf__media--left,
  #pcomfort-{{ section.id }}.cf-anim.is-visible .cf__media--right {
    opacity: 1;
    transform: translateX(0);
  }

  #pcomfort-{{ section.id }}.cf-anim.is-visible .cf__title,
  #pcomfort-{{ section.id }}.cf-anim.is-visible .cf__item {
    opacity: 1;
    transform: translateY(0);
  }

  #pcomfort-{{ section.id }}.cf-anim.is-done .cf__media,
  #pcomfort-{{ section.id }}.cf-anim.is-done .cf__title,
  #pcomfort-{{ section.id }}.cf-anim.is-done .cf__item {
    transition-delay: 0s;
    will-change: auto;
  }

  /* Mobile/tablet: side slide ki jagah halka fade-up */
  @media screen and (max-width: 989px) {
    #pcomfort-{{ section.id }} {
      --cf-left-x: 0px;
      --cf-right-x: 0px;
    }
    #pcomfort-{{ section.id }}.cf-anim .cf__media--left,
    #pcomfort-{{ section.id }}.cf-anim .cf__media--right {
      transform: translateY(20px);
    }
    #pcomfort-{{ section.id }}.cf-anim.is-visible .cf__media--left,
    #pcomfort-{{ section.id }}.cf-anim.is-visible .cf__media--right {
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #pcomfort-{{ section.id }}.cf-anim .cf__media,
    #pcomfort-{{ section.id }}.cf-anim .cf__title,
    #pcomfort-{{ section.id }}.cf-anim .cf__item {
      opacity: 1;
      transform: none;
      transition: none;
    }
    #pcomfort-{{ section.id }} .cf__media img { transition: none; }
  }
{%- endstyle -%}

<div id="pcomfort-{{ section.id }}" class="custom-product-comfort">
  <div class="{% unless section.settings.full_width %}page-width{% endunless %}">
    <div class="cf__grid">

      {%- if cf_img_left != blank -%}
        <div class="cf__media cf__media--left">
          <img
            src="{{ cf_img_left | image_url: width: 900 }}"
            srcset="{{ cf_img_left | image_url: width: 400 }} 400w,
                    {{ cf_img_left | image_url: width: 600 }} 600w,
                    {{ cf_img_left | image_url: width: 900 }} 900w,
                    {{ cf_img_left | image_url: width: 1200 }} 1200w"
            sizes="(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw"
            alt="{{ cf_img_left.alt | default: product.title | escape }}"
            width="{{ cf_img_left.width }}"
            height="{{ cf_img_left.height }}"
            loading="lazy"
          >
        </div>
      {%- endif -%}

      <div class="cf__content">
        {%- if cf_title != blank -%}
          <h2 class="cf__title">{{ cf_title | escape | newline_to_br }}</h2>
        {%- endif -%}

        <ul class="cf__list">
          {%- for point in cf_points -%}
            {%- assign point_clean = point | strip -%}
            {%- if point_clean != blank -%}
              <li class="cf__item">
                <span class="cf__check" aria-hidden="true">
                  <svg viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M3 8.5L6.5 12L13 4.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
                <span>{{ point_clean | escape }}</span>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>

      {%- if cf_img_right != blank -%}
        <div class="cf__media cf__media--right">
          <img
            src="{{ cf_img_right | image_url: width: 900 }}"
            srcset="{{ cf_img_right | image_url: width: 400 }} 400w,
                    {{ cf_img_right | image_url: width: 600 }} 600w,
                    {{ cf_img_right | image_url: width: 900 }} 900w,
                    {{ cf_img_right | image_url: width: 1200 }} 1200w"
            sizes="(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw"
            alt="{{ cf_img_right.alt | default: product.title | escape }}"
            width="{{ cf_img_right.width }}"
            height="{{ cf_img_right.height }}"
            loading="lazy"
          >
        </div>
      {%- endif -%}

    </div>
  </div>
</div>

<script>
  (function () {
    var section = document.getElementById('pcomfort-{{ section.id }}');
    if (!section) return;

    var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduced || !('IntersectionObserver' in window)) return;

    section.querySelectorAll('.cf__title, .cf__item').forEach(function (el, i) {
      el.style.setProperty('--cf-ci', i);
    });

    section.classList.add('cf-anim');

    var observer = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          section.classList.add('is-visible');
          observer.unobserve(section);
          window.setTimeout(function () {
            section.classList.add('is-done');
          }, 2200);
        }
      });
    }, { threshold: 0.15 });

    observer.observe(section);
  })();
</script>

{%- elsif request.design_mode -%}
  <div class="page-width" style="padding: 24px 0; text-align: center; opacity: .6;">
    Produktkomfort: komfort-metafelterne er tomme for dette produkt.
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Custom Product Comfort",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "paragraph", "content": "Images, title aur points product ke metafields (custom.komfort_*) se aate hain." },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg_color", "label": "Section Background", "default": "#F5F1EA" },
    { "type": "color", "id": "border_color", "label": "Top Border Color", "default": "#A58C76" },
    { "type": "color", "id": "title_color", "label": "Title Color", "default": "#302821" },
    { "type": "color", "id": "text_color", "label": "Points Text Color", "default": "#302821" },
    { "type": "color", "id": "check_color", "label": "Checkmark Color", "default": "#A58C76" },

    { "type": "header", "content": "Layout" },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image Shape",
      "default": "4 / 5",
      "options": [
        { "value": "1 / 1", "label": "Square (1:1)" },
        { "value": "4 / 5", "label": "Portrait (4:5)" },
        { "value": "3 / 4", "label": "Tall Portrait (3:4)" },
        { "value": "4 / 3", "label": "Landscape (4:3)" }
      ]
    },
    { "type": "range", "id": "image_radius", "min": 0, "max": 24, "step": 2, "unit": "px", "label": "Image Corner Radius", "default": 0 },
    { "type": "checkbox", "id": "full_width", "label": "Full Width", "default": false },

    { "type": "header", "content": "Section Spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding Top", "default": 48 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding Bottom", "default": 48 }
  ],
  "presets": [
    { "name": "Custom Product Comfort" }
  ]
}
{% endschema %}