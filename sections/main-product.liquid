<script>
  const fordeleSwiper = new Swiper('.custom-fordele-swiper', {
    slidesPerView: 2.5,
    spaceBetween: 20,
    navigation: {
      nextEl: '.custom-fordele-swiper .swiper-button-next',
      prevEl: '.custom-fordele-swiper .swiper-button-prev',
    },
    pagination: {
      el: '.custom-fordele-swiper .swiper-pagination',
      clickable: true,
    },
    scrollbar: {
      el: '.custom-fordele-swiper .swiper-scrollbar',
      draggable: true,
    },
    // breakpoints: {
    //   768: {
    //     slidesPerView: 2.2,
    //   },
    //   1024: {
    //     slidesPerView: 2.2,
    //   }
    // }
  });

  document.addEventListener('DOMContentLoaded', () => {
    // Select the image element you want to apply the blur to.
    const customImage = document.querySelector('.custom-image');

    // Set the maximum blur value (in pixels).
    const maxBlur = 5;

    // Set the initial blur value to zero.
    let blurApplied = 0;

    // A flag to check if the image has become sticky.
    let isSticky = false;

    // The point in the document's height where the blur effect will be at its maximum.
    // This is a value you can tune. A larger value means a slower blur transition.
    const blurEffectDistance = 600;

    // Function to calculate and apply the blur effect.
    function updateBlurEffect() {
      const scrollPosition = window.scrollY;

      // Check the image's position relative to the viewport.
      const imageRect = customImage.getBoundingClientRect();

      // If the image's top is at or above the viewport's top, it's sticky.
      if (imageRect.top <= 0 && !isSticky) {
        isSticky = true;
        // You can add a class here to style the image when it's sticky, if needed.
        customImage.classList.add('active');
      } else if (imageRect.top > 0 && isSticky) {
        // If the image moves back down, it's no longer sticky.
        isSticky = false;
        customImage.classList.remove('active');
      }

      // Apply blur only if the image is NOT sticky yet.
      if (!isSticky) {
        // Calculate the blur value.
        // We use the `scrollPosition` and `blurEffectDistance` to get a ratio.
        const blurValue = (scrollPosition / blurEffectDistance) * maxBlur;

        // Clamp the blur value to be between 0 and the maxBlur.
        blurApplied = Math.min(Math.max(blurValue, 0), maxBlur);
      } else {
        // If the image is sticky, the blur has reached its maximum.
        // We can keep it at the maximum value.
        blurApplied = maxBlur;
      }

      // Apply the calculated blur value to the image's filter style.
      customImage.style.filter = `blur(${blurApplied}px)`;
    }

    // Attach the `updateBlurEffect` function to the window's scroll event.
    window.addEventListener('scroll', updateBlurEffect);

    // Call the function once on page load to set the initial state.
    updateBlurEffect();
  });
</script>
