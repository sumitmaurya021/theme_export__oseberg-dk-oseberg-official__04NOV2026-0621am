{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{% assign has_faq = false %}

<div
  id="{{ section.settings.custom_id }} shopify-section-{{ section.id }}"
  class="custom-both-img-accordion-container section-{{ section.id }}-padding"
  style="background: {{ section.settings.background_color }}"
>
  <div class="custom-both-img-accordion page-width">
    <div class="custom-img-text-content">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'content_block' %}
            <div class="content-block">
              {% if block.settings.image %}
                <img src="{{ block.settings.image | img_url: 'master' }}" alt="">
              {% endif %}
              {% if block.settings.heading or block.settings.description %}
              <div class="custom-description_wrapper">
                {% if block.settings.heading %}
                  <h2>{{ block.settings.heading }}</h2>
                {% endif %}
                {% if block.settings.description %}
                  <div class="description">{{ block.settings.description }}</div>
                {% endif %}
              </div>
            {% endif %}
            </div>
        {% endcase %}
      {% endfor %}
    </div>

    <div class="custom-accordion-content">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'accordion_block' %}
            {% assign faq_question = block.settings.accordion_heading %}

            {% if faq_question != blank %}
              {% assign has_faq = true %}
              <div class="accordion-item">
                {% if block.settings.accordion_heading %}
                  <div class="accordion-heading">
                    <h3>{{- block.settings.accordion_heading -}}</h3>
                    <span>{{- 'custom-down-arrow.svg' | inline_asset_content -}}</span>
                  </div>
                {% endif %}
                {% if block.settings.accordion_content %}
                  <div class="accordion-content">
                    {{- block.settings.accordion_content -}}
                  </div>
                {% endif %}
              </div>
            {% endif %}
        {% endcase %}
      {% endfor %}
    </div>
  </div>
</div>

{% unless has_faq %}
  <style>
    .custom-both-img-accordion-container {
      display: none;
    }
  </style>
{% endunless %}

{% schema %}
{
  "name": "Custom Img Txt Accordion",
  "settings": [
    {
      "type": "text",
      "id": "custom_id",
      "label": "Custom Id Text"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#bab1a5"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "content_block",
      "name": "Content Block",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Your Heading Here"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description",
          "default": "<p>Your description here.</p>"
        }
      ]
    },
    {
      "type": "accordion_block",
      "name": "Accordion Block",
      "settings": [
        {
          "type": "text",
          "id": "accordion_heading",
          "label": "Accordion Heading",
          "default": "Accordion Title"
        },
        {
          "type": "richtext",
          "id": "accordion_content",
          "label": "Accordion Content",
          "default": "<p>Accordion content here.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Img Txt Accordion",
      "blocks": [{ "type": "content_block" }, { "type": "accordion_block" }]
    }
  ]
}
{% endschema %}

<style>
    .accordion-content {
    display: none;
  }
  .accordion-item.active .accordion-content {
    display: block;
  }

    .custom-both-img-accordion .custom-description_wrapper,
    .custom-both-img-accordion .custom-accordion-content{
      max-width: 662px;
      margin: auto;
      padding: 0 20px 48px;
    }
    .custom-both-img-accordion .content-block h2 {
      margin: 32px 0 16px;
      font-size: 32px;
      font-weight: 700;
      line-height: 1.2;
      color: #0e1f2a;
    }
    .custom-both-img-accordion .content-block .description p {
      margin-top: 0px;
      color: #414c54;
    }
    .custom-both-img-accordion .content-block img {
      width: auto;
      height: auto;
      max-width: 100%;
      aspect-ratio: 1 / 0.42;
    }
    .custom-both-img-accordion .custom-accordion-content {
      padding: 48px 0;
    }
    .custom-both-img-accordion .custom-accordion-content .accordion-item {
      border-top: 1px solid #0e1f2a;
    }
    .custom-both-img-accordion .custom-accordion-content .accordion-item:last-child {
      border-bottom: 1px solid #0e1f2a;
    }
    .custom-both-img-accordion .custom-accordion-content .accordion-item .accordion-heading {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 32px 0;
    }
    .custom-both-img-accordion .custom-accordion-content .accordion-item .accordion-heading {
      cursor: pointer;
    }
    .custom-both-img-accordion .custom-accordion-content .accordion-item .accordion-heading h3 {
      margin: 0px;
      font-weight: 700;
      color: #0e1f2a;
      font-size: 16px;
      line-height: 1.4;
    }
    .custom-both-img-accordion .custom-accordion-content .accordion-item .accordion-heading span {
      line-height: 0;
    }
    .custom-both-img-accordion .custom-accordion-content .accordion-item svg {
      transition: 0.3s all;
    }
    .custom-both-img-accordion .custom-accordion-content .accordion-item.active svg {
      transform: rotate(180deg);
    }
    .custom-both-img-accordion .custom-accordion-content .accordion-item .accordion-content p {
      padding-bottom: 32px;
      margin-top: 0px;
      margin-bottom: 16px;
      color: #414c54;
    }
    .accordion-content {
      display: none;
      transition: max-height 0.3s ease-in-out;
      overflow: hidden;
      max-height: 0;
    }
    .accordion-item.active .accordion-content {
      display: block;
      max-height: 500px;
    }
      .accordion-content ul {
        margin-top: 0;
    }
    @media screen and (max-width: 1023px) {
      .custom-both-img-accordion-container {
          padding-top: 48px !important;
          padding-bottom: 48px !important;
      }
    }
    @media screen and (max-width: 749px) {
      .custom-both-img-accordion .custom-accordion-content .accordion-item .accordion-content p {
          font-size: 16px;
          line-height: 1.4;
      }
    }
</style>
{% comment %}
  <script>
    document.addEventListener("DOMContentLoaded", function() {
      let accordionItems = document.querySelectorAll(".accordion-item");

      accordionItems.forEach(item => {
        item.querySelector(".accordion-heading").addEventListener("click", function() {
          let isActive = item.classList.contains("active");

          accordionItems.forEach(i => i.classList.remove("active"));

          if (!isActive) {
            item.classList.add("active");
          }
        });
      });
    });
  </script>
{% endcomment %}
<script>
  document.addEventListener('DOMContentLoaded', function () {
    const sectionId = '{{ section.id }}';
    const section = document.querySelector(`#shopify-section-${sectionId}`);
    if (!section) return;

    const accordionItems = section.querySelectorAll('.accordion-item');

    accordionItems.forEach((item) => {
      const heading = item.querySelector('.accordion-heading');
      heading.addEventListener('click', function () {
        const isActive = item.classList.contains('active');

        // Close all items within this section only
        accordionItems.forEach((i) => i.classList.remove('active'));

        if (!isActive) {
          item.classList.add('active');
        }
      });
    });
  });
</script>
