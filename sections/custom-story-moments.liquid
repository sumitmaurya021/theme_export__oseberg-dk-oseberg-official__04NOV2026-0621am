{%- style -%}
  #smoments-{{ section.id }} {
    --sn-eyebrow: {{ section.settings.eyebrow_color }};
    --sn-title: {{ section.settings.title_color }};
    --sn-desc: {{ section.settings.desc_color }};
    --sn-btn-bg: {{ section.settings.button_bg }};
    --sn-btn-color: {{ section.settings.button_color }};
    --sn-btn-hover-bg: {{ section.settings.button_hover_bg }};
    --sn-btn-hover-color: {{ section.settings.button_hover_color }};
    --sn-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --sn-min-h: {{ section.settings.min_height }}px;
    --sn-min-h-mobile: {{ section.settings.min_height_mobile }}px;
    position: relative;
    background: {{ section.settings.bg_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    overflow: hidden;
  }

  #smoments-{{ section.id }} .sn__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  #smoments-{{ section.id }} .sn__bg img,
  #smoments-{{ section.id }} .sn__bg svg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: {{ section.settings.image_focus }};
    display: block;
  }

  /* Text ke peeche left se gehra overlay taaki text readable rahe */
  #smoments-{{ section.id }} .sn__bg::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      to right,
      rgba(48, 40, 33, var(--sn-overlay)) 0%,
      rgba(48, 40, 33, calc(var(--sn-overlay) * 0.7)) 35%,
      rgba(48, 40, 33, 0) 70%
    );
  }

  #smoments-{{ section.id }} .sn__inner {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: {{ section.settings.vertical_align }};
    min-height: var(--sn-min-h);
  }

  #smoments-{{ section.id }} .sn__content {
    width: 100%;
    max-width: 480px;
    min-width: 0;
  }

  #smoments-{{ section.id }} .sn__eyebrow {
    margin: 0 0 16px;
    color: var(--sn-eyebrow);
    font-family: var(--font-sans, 'Jost', 'Helvetica Neue', Arial, sans-serif);
    font-size: 12px;
    font-weight: 400;
    line-height: 1.4;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  #smoments-{{ section.id }} .sn__title {
    margin: 0 0 24px;
    color: var(--sn-title);
    font-family: var(--font-serif, 'Playfair Display', Georgia, 'Times New Roman', serif);
    font-size: clamp(28px, 3.2vw, 48px);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: 0.01em;
    text-wrap: balance;
    overflow-wrap: break-word;
  }

  #smoments-{{ section.id }} .sn__desc {
    margin: 0 0 32px;
    max-width: 440px;
    color: var(--sn-desc);
    font-family: var(--font-sans, 'Jost', 'Helvetica Neue', Arial, sans-serif);
    font-size: clamp(14px, 1.05vw, 16px);
    font-weight: 400;
    line-height: 1.6;
    letter-spacing: normal;
  }

  #smoments-{{ section.id }} .sn__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    max-width: 100%;
    padding: clamp(14px, 1.2vw, 18px) clamp(24px, 2.4vw, 36px);
    background: var(--sn-btn-bg);
    color: var(--sn-btn-color);
    font-family: var(--font-sans, 'Jost', 'Helvetica Neue', Arial, sans-serif);
    font-size: 12px;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: 0.15em;
    text-align: center;
    text-transform: uppercase;
    text-decoration: none;
    border: 1px solid var(--sn-btn-bg);
    border-radius: 0;
    transition: background 0.4s ease, color 0.4s ease, border-color 0.4s ease;
  }

  #smoments-{{ section.id }} .sn__button::before,
  #smoments-{{ section.id }} .sn__button::after {
    content: none !important;
    display: none !important;
  }

  #smoments-{{ section.id }} .sn__button:hover {
    background: var(--sn-btn-hover-bg);
    color: var(--sn-btn-hover-color);
    border-color: var(--sn-btn-hover-bg);
  }

  /* ---------- Tablet (750px - 989px) ---------- */
  @media screen and (min-width: 750px) and (max-width: 989px) {
    #smoments-{{ section.id }} .sn__title { font-size: clamp(32px, 5vw, 44px); }
    #smoments-{{ section.id }} .sn__content { max-width: 460px; }
  }

  /* ---------- Mobile (749px and below) ---------- */
  @media screen and (max-width: 749px) {
    #smoments-{{ section.id }} .sn__inner {
      min-height: var(--sn-min-h-mobile);
      align-items: flex-end;
    }

    #smoments-{{ section.id }} .sn__content { max-width: 100%; }
    #smoments-{{ section.id }} .sn__title { margin-bottom: 18px; }
    #smoments-{{ section.id }} .sn__desc { margin-bottom: 24px; max-width: 100%; }
    #smoments-{{ section.id }} .sn__button { width: 100%; }

    /* Mobile pe text ke liye neeche se overlay */
    #smoments-{{ section.id }} .sn__bg::after {
      background: linear-gradient(
        to top,
        rgba(48, 40, 33, calc(var(--sn-overlay) + 0.3)) 0%,
        rgba(48, 40, 33, calc(var(--sn-overlay) * 0.7)) 55%,
        rgba(48, 40, 33, 0) 100%
      );
    }
  }

  /* ============================================
     ANIMATIONS (premium, subtle)
     JS chalega to hi hide hota hai, warna content hamesha visible rahega
     ============================================ */
  #smoments-{{ section.id }}.sn-anim .sn__content > * {
    opacity: 0;
    transform: translateX(-28px);
    transition:
      opacity 1s cubic-bezier(0.22, 0.61, 0.36, 1),
      transform 1s cubic-bezier(0.22, 0.61, 0.36, 1),
      background 0.4s ease, color 0.4s ease, border-color 0.4s ease;
    transition-delay: calc(var(--sn-ci, 0) * 0.12s), calc(var(--sn-ci, 0) * 0.12s), 0s, 0s, 0s;
    will-change: opacity, transform;
  }

  #smoments-{{ section.id }}.sn-anim .sn__bg img,
  #smoments-{{ section.id }}.sn-anim .sn__bg svg {
    transform: scale(1.06);
    transition: transform 2.4s cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  #smoments-{{ section.id }}.sn-anim.is-visible .sn__content > * {
    opacity: 1;
    transform: translateX(0);
  }

  #smoments-{{ section.id }}.sn-anim.is-visible .sn__bg img,
  #smoments-{{ section.id }}.sn-anim.is-visible .sn__bg svg {
    transform: scale(1);
  }

  #smoments-{{ section.id }}.sn-anim.is-done .sn__content > * {
    transition-delay: 0s;
    will-change: auto;
  }

  /* Mobile: side slide ki jagah halka fade-up */
  @media screen and (max-width: 749px) {
    #smoments-{{ section.id }}.sn-anim .sn__content > * { transform: translateY(20px); }
    #smoments-{{ section.id }}.sn-anim.is-visible .sn__content > * { transform: translateY(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    #smoments-{{ section.id }}.sn-anim .sn__content > * {
      opacity: 1;
      transform: none;
      transition: none;
    }
    #smoments-{{ section.id }}.sn-anim .sn__bg img,
    #smoments-{{ section.id }}.sn-anim .sn__bg svg {
      transform: none;
      transition: none;
    }
  }
{%- endstyle -%}

<div id="smoments-{{ section.id }}" class="custom-story-moments">
  <div class="sn__bg">
    {%- if section.settings.image != blank -%}
      <img
        src="{{ section.settings.image | image_url: width: 1800 }}"
        srcset="{{ section.settings.image | image_url: width: 750 }} 750w,
                {{ section.settings.image | image_url: width: 1100 }} 1100w,
                {{ section.settings.image | image_url: width: 1500 }} 1500w,
                {{ section.settings.image | image_url: width: 2000 }} 2000w,
                {{ section.settings.image | image_url: width: 2400 }} 2400w"
        sizes="100vw"
        alt="{{ section.settings.image.alt | default: section.settings.title | escape }}"
        width="{{ section.settings.image.width }}"
        height="{{ section.settings.image.height }}"
        loading="lazy"
      >
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag }}
    {%- endif -%}
  </div>

  <div class="sn__inner {% unless section.settings.full_width %}page-width{% endunless %}">
    <div class="sn__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="sn__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      {%- if section.settings.title != blank -%}
        <h2 class="sn__title">{{ section.settings.title | escape | newline_to_br }}</h2>
      {%- endif -%}

      {%- if section.settings.description != blank -%}
        <p class="sn__desc">{{ section.settings.description | escape | newline_to_br }}</p>
      {%- endif -%}

      {%- if section.settings.button_text != blank and section.settings.button_link != blank -%}
        <a href="{{ section.settings.button_link }}" class="sn__button">{{ section.settings.button_text | escape }}</a>
      {%- endif -%}
    </div>
  </div>
</div>

<script>
  (function () {
    var section = document.getElementById('smoments-{{ section.id }}');
    if (!section) return;

    var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduced || !('IntersectionObserver' in window)) return;

    section.querySelectorAll('.sn__content > *').forEach(function (el, i) {
      el.style.setProperty('--sn-ci', i);
    });

    section.classList.add('sn-anim');

    var observer = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          section.classList.add('is-visible');
          observer.unobserve(section);
          window.setTimeout(function () {
            section.classList.add('is-done');
          }, 2200);
        }
      });
    }, { threshold: 0.15 });

    observer.observe(section);
  })();
</script>

{% schema %}
{
  "name": "Custom Story Moments",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "header", "content": "Background Image" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    {
      "type": "select",
      "id": "image_focus",
      "label": "Image Focus",
      "default": "center center",
      "info": "Image ka kaun sa hissa dikhna chahiye (crop hone par).",
      "options": [
        { "value": "center center", "label": "Center" },
        { "value": "center top", "label": "Top" },
        { "value": "center bottom", "label": "Bottom" },
        { "value": "left center", "label": "Left" },
        { "value": "right center", "label": "Right" }
      ]
    },
    { "type": "range", "id": "overlay_opacity", "min": 0, "max": 90, "step": 5, "unit": "%", "label": "Text Overlay Darkness", "default": 55 },

    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Small Heading", "default": "Samværet er hjemmet" },
    { "type": "textarea", "id": "title", "label": "Title (new line = line break)", "default": "Plads til de vigtige øjeblikke." },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description (new line = line break)",
      "default": "Uanset om det er en hyggelig søndag, en aften med venner eller en særlig højtid – Oseberg er rammen om de øjeblikke, der betyder mest. Et sted, hvor samtalerne varer lidt længere, og hvor man har lyst til at blive siddende."
    },
    { "type": "text", "id": "button_text", "label": "Button Text", "default": "Se vores sofaer →" },
    { "type": "url", "id": "button_link", "label": "Button Link" },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg_color", "label": "Section Background (image na ho tab)", "default": "#302821" },
    { "type": "color", "id": "eyebrow_color", "label": "Small Heading Color", "default": "#DED2C3" },
    { "type": "color", "id": "title_color", "label": "Title Color", "default": "#FFFFFF" },
    { "type": "color", "id": "desc_color", "label": "Description Color", "default": "#FFFFFF" },
    { "type": "color", "id": "button_bg", "label": "Button Background", "default": "#A58C76" },
    { "type": "color", "id": "button_color", "label": "Button Text Color", "default": "#FFFFFF" },
    { "type": "color", "id": "button_hover_bg", "label": "Button Hover Background", "default": "#F5F1EA" },
    { "type": "color", "id": "button_hover_color", "label": "Button Hover Text Color", "default": "#302821" },

    { "type": "header", "content": "Layout" },
    {
      "type": "select",
      "id": "vertical_align",
      "label": "Content Vertical Position (Desktop)",
      "default": "center",
      "options": [
        { "value": "flex-start", "label": "Top" },
        { "value": "center", "label": "Middle" },
        { "value": "flex-end", "label": "Bottom" }
      ]
    },
    { "type": "range", "id": "min_height", "min": 320, "max": 900, "step": 20, "unit": "px", "label": "Section Height (Desktop / Tablet)", "default": 480 },
    { "type": "range", "id": "min_height_mobile", "min": 380, "max": 900, "step": 20, "unit": "px", "label": "Section Height (Mobile)", "default": 620 },
    { "type": "checkbox", "id": "full_width", "label": "Full Width", "default": false },

    { "type": "header", "content": "Section Spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding Top", "default": 48 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding Bottom", "default": 48 }
  ],
  "presets": [
    { "name": "Custom Story Moments" }
  ]
}
{% endschema %}