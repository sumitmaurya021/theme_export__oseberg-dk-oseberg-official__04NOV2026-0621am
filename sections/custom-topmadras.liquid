{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="mattress-topper-section section-{{ section.id }}-padding" id="{{ section.settings.section_id }}">
  <div class="page-width">
    <div class="topper-heading">
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.subheading }}</p>
    </div>

    <div class="topper-grid">
      {% for block in section.blocks %}
        <div class="topper-item topper-item-{{ forloop.index }}">
          <div class="topper-item-content">
            <div class="topeer-item-heading">
              <h3>{{ block.settings.heading_title }}</h3>
              <p>{{ block.settings.su_heading_title }}</p>
              <img src="{{ block.settings.first_image | img_url: 'master'  }}">
            </div>
            <div class="topper-item-description">
              <h5>{{ block.settings.middle_text }}</h5>
              <p>{{ block.settings.middle_description }}</p>
            </div>
          </div>
          <div class="topper-item-video">
            {{ block.settings.video | video_tag: autoplay: true, muted: true, loop: true }}
          </div>
        </div>
        <style> 
           .topper-item-{{ forloop.index }}:hover {
            background-color: {{ block.settings.background_hover }};
            } 
        </style>
      {% endfor %}
    </div>

    <div class="topper-grid topper-mobile-grid">
      <div class="topper-mobile-video">
      {% for block in section.blocks %}
        <div
          class="topper-mob-item-video"
          data-index="{{ forloop.index0 }}"
          {% unless forloop.first %}
            style="display:none;"
          {% else %}
            class="active"
          {% endunless %}
        >
          {{ block.settings.video | video_tag: autoplay: true, muted: true, loop: true }}
        </div>
      {% endfor %}
      </div>

      <div class="topper-mob-item-contents">
      {% for block in section.blocks %}
        <div class="topper-mob-item {% if forloop.first %}active{% endif %}" data-index="{{ forloop.index0 }}">
          <div class="topper-mob-item-content">
            <div class="topeer-mob-item-heading">
              <div class="topeer-mob-item-top-content">
                <img src="{{ block.settings.first_image | img_url: 'master'  }}">
                <h3>{{ block.settings.heading_title }}</h3>
              </div>
              <p>{{ block.settings.su_heading_title }}</p>
            </div>
            <div
              class="topper-mob-item-description"
              {% unless forloop.first %}
                style="display:none;"
              {% endunless %}
            >
              <h5>{{ block.settings.middle_text }}</h5>
              <p>{{ block.settings.middle_description }}</p>
            </div>
          </div>
        </div>
      {% endfor %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Mattress Topper",
  "settings": [
    {
      "type": "text",
      "id": "section_id",
      "label": "Section Id"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Mattress topper"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Choose between three different types."
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "video",
      "name": "Video Block",
      "settings": [
        {
          "type": "color",
          "id": "background_hover",
          "label": "Background Hover"
        },
        {
          "type": "text",
          "id": "heading_title",
          "label": "First Heading Title"
        },
        {
          "type":"text",
          "id":"su_heading_title",
          "label":"Sub Tittle"
        },
        {
          "type": "image_picker",
          "id": "first_image",
          "label": "First Bottom Image"
        },
        {
          "type": "text",
          "id": "middle_text",
          "label": "Middle Heading Text"
        },
        {
          "type": "text",
          "id": "middle_description",
          "label": "Middle Description Text"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Video URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Mattress Topper"
    }
  ]
}
{% endschema %}

<style>
  .mattress-topper-section {
      background-color: #f9f3ee;
  }
  .mattress-topper-section .topper-heading {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 40px;
      margin-bottom: 60px;
  }
  .mattress-topper-section .topper-heading h2 {
      width: 50%;
      margin: 0;
      font-size: clamp(28px, 3.2vw, 48px);
      line-height: 1.2;
      letter-spacing: normal;
  }
  .mattress-topper-section .topper-heading p {
      padding-top: 24px;
      margin: 0;
      width: 50%;
      font-size: clamp(16px, 1.4vw, 20px);
      line-height: 1.1em;
      color: var(--color-black);
  }
  .mattress-topper-section .topper-grid {
      display: flex;
      flex-wrap: wrap;
      gap: 20px;
  }
  .mattress-topper-section .topper-item {
      width: 100%;
      display: flex;
      justify-content: space-between;
      gap: 32px;
      padding: 20px;
      border-radius: 20px;
      box-shadow: 0 0 #0000,0 0 #0000,inset 0px 0px 0px 1px #0e1f2a33;
      transition: 0.4s all;
  }
  .mattress-topper-section .topper-item:first-child:hover {
      box-shadow: 0 0 #0000,0 0 #0000,inset 0px 0px 0px 2px #A37E2C;
  }
  .mattress-topper-section .topper-item:nth-child(2):hover,
  .mattress-topper-section .topper-mobile-grid .topper-mob-item:nth-child(2).active {
      background-color: #eef4ed;
      box-shadow: 0 0 #00000000, 0 0 #0000, inset 0px 0px 0px 1px #0e1f2a00;
  }
  .mattress-topper-section .topper-item:last-child:hover,
  .mattress-topper-section .topper-mobile-grid .topper-mob-item:last-child.active {
      background-color: #816a5c;
      box-shadow: 0 0 #00000000, 0 0 #0000, inset 0px 0px 0px 1px #0e1f2a00;
  }
  .mattress-topper-section .topper-item:last-child:hover h3,
  .mattress-topper-section .topper-item:last-child:hover h5,
  .mattress-topper-section .topper-item:last-child:hover .topper-item-description p,
  .mattress-topper-section .topper-mobile-grid .topper-mob-item:last-child.active h3,
  .mattress-topper-section .topper-mobile-grid .topper-mob-item:last-child.active h5,
  .mattress-topper-section .topper-mobile-grid .topper-mob-item:last-child.active .topper-mob-item-description p {
      color: var(--color-white) !important;
  }
  .mattress-topper-section .topper-item:last-child:hover img,
  .mattress-topper-section .topper-mobile-grid .topper-mob-item:last-child.active img {
      filter: invert(1);
  }
  .mattress-topper-section .topper-item .topper-item-content {
      width: calc(100% - 332px);
      display: flex;
      gap: 32px;
  }
  .mattress-topper-section .topper-item .topper-item-content .topeer-item-heading h3 {
      margin: 0;
      font-size: clamp(22px, 2.2vw, 32px);
      line-height: 1.25;
  }
  .mattress-topper-section .topper-item .topper-item-video {
      width: 300px;
      line-height: 0;
  }
  .mattress-topper-section .topper-mobile-grid .topper-mob-item-video {
      line-height: 0;
  }
  .mattress-topper-section .topper-item .topper-item-video video,
  .mattress-topper-section .topper-mobile-grid .topper-mob-item-video video {
      width: 100%;
      margin: 0px;
      border-radius: 8px;
  }
  .mattress-topper-section .topper-item .topper-item-content .topeer-item-heading p,
  .mattress-topper-section .topper-mobile-grid .topper-mob-item .topeer-mob-item-heading p {
      margin: 12px 0 0;
      /* color: var(--color-light-primary); */
      color: #fff;    
      font-size: 12px;
      line-height: 16px;
      box-shadow: 0 0 #0000,0 0 #0000,inset 0px 0px 0px 1px #0e1f2a33;
      display: inline-block;
      padding: 2px 8px;
      border-radius: 4px;
      {% comment %} background-color: #123458; {% endcomment %}
       background-color: #A37E2C;
  }
  .mattress-topper-section .topper-item .topper-item-content .topeer-item-heading {
      position: relative;
      width: 42%;
  }
  .mattress-topper-section .topper-item .topper-item-content .topeer-item-heading img {
      position: absolute;
      bottom: 0;
      left: 0;
      margin: 0 12px 0 0;
      width: 22px;
  }
  .mattress-topper-section .topper-item .topper-item-content .topper-item-description {
      width: 58%;
  }
  .mattress-topper-section .topper-item .topper-item-content .topper-item-description h5 {
      margin: 0 0 16px;
      font-size: 20px;
      line-height: 28px;
      color: var(--color-black);
  }
  .mattress-topper-section .topper-item .topper-item-content .topper-item-description  p {
      margin: 0;
      max-width: 320px;
      font-size: clamp(14px, 1.05vw, 16px);
      line-height: 24px;
      color: var(--color-primary);
  }

  /*Mobile view*/
  .mattress-topper-section .topper-mobile-grid .topper-mobile-video {
      margin-bottom: 16px;
  }
  .mattress-topper-section .topper-mobile-grid  .topper-mob-item-contents {
      display: flex;
      flex-direction: column;
      gap: 8px;
  }
  .mattress-topper-section .topper-mobile-grid .topper-mob-item {
      padding: 16px;
      border-radius: 12px;
      box-shadow: 0 0 #0000,0 0 #0000,inset 0px 0px 0px 1px #0e1f2a33;
  }
  .mattress-topper-section .topper-mobile-grid .topper-mob-item:first-child {
      box-shadow: 0 0 #0000,0 0 #0000,inset 0px 0px 0px 2px #A37E2C !important;
  }
  .mattress-topper-section .topper-mobile-grid .topper-mob-item .topeer-mob-item-heading {
      display: flex;
      justify-content: space-between;
      gap: 10px;
      align-items: center;
  }
  .mattress-topper-section .topper-mobile-grid .topper-mob-item .topeer-mob-item-heading .topeer-mob-item-top-content {
      display: flex;
      gap: 12px;
      align-items: center;
  }
  .mattress-topper-section .topper-mobile-grid .topper-mob-item .topeer-mob-item-heading .topeer-mob-item-top-content img {
      width: 22px;
  }
  .mattress-topper-section .topper-mobile-grid .topper-mob-item .topeer-mob-item-heading .topeer-mob-item-top-content h3 {
      font-size: 18px;
      margin: 0;
      line-height: 19.8px;
  }
  .mattress-topper-section .topper-mobile-grid .topper-mob-item .topeer-mob-item-heading p {
      margin: 0;
      opacity: 0;
  }
  .mattress-topper-section .topper-mobile-grid .topper-mob-item.active .topeer-mob-item-heading p {
      opacity: 1;
  }
  .mattress-topper-section .topper-mobile-grid .topper-mob-item .topper-mob-item-description h5 {
      margin: 0px;
      color: var(--color-black);
      font-size: 16px;
      line-height: 22.4px;
      padding-top: 8px;
  }
  .mattress-topper-section .topper-mobile-grid .topper-mob-item .topper-mob-item-description p {
      margin: 0px;
      font-size: 14px;
      line-height: 20px;
      padding-top: 8px;
      color: var(--color-primary);
  }
  
@media screen and (max-width: 1023px) {
  .mattress-topper-section .topper-heading h2 {
      font-size: 32px;
      width: 100%;
      line-height: 44.8px;
  }
  .mattress-topper-section .topper-heading p {
      padding-top: 0;
      width: 100%;
      font-size: 16px;
      line-height: 22.4px;
  }
   .mattress-topper-section .topper-heading {
      align-items: flex-start;
      justify-content: space-between;
      flex-direction: column;
      gap: 80px;
      margin-bottom: 32px;
  }
}
@media screen and (max-width: 767px) {
  .mattress-topper-section .topper-heading h2 {
    line-height: 1em;
  }
  .mattress-topper-section .topper-heading {
      gap: 20px;
      margin-bottom: 20px;
  }
}
</style>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
  $(document).ready(function(){
    $('.topper-mob-item').on('click', function(){
      var index = $(this).data('index');

      // Remove active from all items and hide videos/descriptions
      $('.topper-mob-item').removeClass('active');
      $('.topper-mob-item-video').removeClass('active').hide();
      $('.topper-mob-item-description').hide();

      // Add active class to clicked item
      $(this).addClass('active');

      // Show related video and description
      $('.topper-mob-item-video[data-index="' + index + '"]').addClass('active').show();
      $('.topper-mob-item[data-index="' + index + '"] .topper-mob-item-description').show();
    });
  });
</script>

