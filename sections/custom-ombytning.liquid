{% schema %}
{
  "name": "Custom Ombytning",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Ombytning"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Sådan foregår en ombytning"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Springmadras"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Step Number",
          "default": "1"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Step Title"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description",
          "default": "<p>Step description goes here.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Ombytning",
      "category": "Custom"
    }
  ]
}
{% endschema %}

<div class="container">
  <span class="block text-center mb-4 text-accent-sunset">{{ section.settings.subheading }}</span>
  <h2 class="h2 text-center mb-8">{{ section.settings.heading }}</h2>
  <div class="flex flex-wrap gap-4 items-center justify-center mb-12 lg:mb-24">
    <a href="{{ section.settings.button_url }}" class="rounded relative border border-ui-dark-night ease-out duration-400 hover:bg-accent-sunset hover:text-white hover:border-accent-sunset bg-accent-sunset text-white border-accent-sunset px-5 py-2">
      {{ section.settings.button_text }}
    </a>
  </div>
  <div class="swiper-container">
    <div class="swiper-wrapper">
      {% for block in section.blocks %}
        <div class="swiper-slide text-center">
          <span class="w-9 h-9 flex justify-center items-center font-semibold text-xl text-accent-sunset rounded-full border border-accent-sunset bg-white mb-8 relative">{{ block.settings.number }}</span>
          <h3 class="font-semibold text-xl mb-2">{{ block.settings.title }}</h3>
          <div>{{ block.settings.description }}</div>
        </div>
      {% endfor %}
    </div>
    <div class="swiper-pagination"></div>
    <div class="swiper-button-next"></div>
    <div class="swiper-button-prev"></div>
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    new Swiper(".swiper-container", {
      slidesPerView: 1,
      spaceBetween: 10,
      pagination: { el: ".swiper-pagination", clickable: true },
      navigation: { nextEl: ".swiper-button-next", prevEl: ".swiper-button-prev" },
      breakpoints: {
        640: { slidesPerView: 2, spaceBetween: 20 },
        1024: { slidesPerView: 3, spaceBetween: 30 }
      }
    });
  });
</script>

<style>
  .swiper-container { width: 100%; padding: 20px; }
  .swiper-slide { background: #fff; padding: 20px; border: 1px solid #ddd; border-radius: 10px; }
  .swiper-button-next, .swiper-button-prev { color: #FF6E15; }
</style>
