<script>
  document.addEventListener('DOMContentLoaded', function () {
    const headings = document.querySelectorAll('.footer-block__heading');

    headings.forEach((heading) => {
      heading.addEventListener('click', function () {
        if (window.innerWidth <= 1279) {
          // Yahan condition change ki hai
          // Sabhi open content ko band kar do
          document.querySelectorAll('.footer-block__details-content').forEach((content) => {
            if (content !== this.nextElementSibling) {
              content.style.display = 'none';
              content.previousElementSibling.classList.remove('active');
            }
          });

          // Current content ko toggle karo
          const content = this.nextElementSibling;
          if (content && content.classList.contains('footer-block__details-content')) {
            const isVisible = content.style.display === 'block';
            content.style.display = isVisible ? 'none' : 'block';
            this.classList.toggle('active', !isVisible);
          }
        }
      });
    });
  });
</script>
