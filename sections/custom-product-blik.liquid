  }
  .custom-product-blik .content-wrapper {
      padding-top: 48px;
      gap: 24px;
      flex-direction: column;
  }
  .custom-product-blik .content-wrapper .left-side {
      width: 100%;
  }
  .custom-product-blik .content-wrapper .right-side {
      width: 100%;
      padding-left: 0;
  }
}  
</style>