<section class="custom-product-blik" id="{{ section.settings.subtext }}">
  <div class="container">
     <div class="custom-product-blik-content">
           {% if section.settings.subtext %}<span>{{ section.settings.subtext }}</span>{% endif %}
           {% if section.settings.heading %}<h2>{{ section.settings.heading }}</h2>{% endif %}
        </div>
    <div class="content-wrapper page-width">     
      {% if section.settings.left_image %}
      <div class="left-side">
        <img src="{{ section.settings.left_image | img_url: 'master' }}" class="left-image">
        <div class="custom-custom-markers">
          {% for block in section.blocks %}
            <span class="custom-marker {% if forloop.first %}active{% endif %}" data-target="{{ forloop.index }}">{{ forloop.index }}</span>
          {% endfor %}
        </div>
      </div>
      {% endif %}
      <div class="right-side">
        {% for block in section.blocks %}
          <div class="content-block" data-id="{{ forloop.index }}" {% if forloop.first %}style="display: block;"{% else %}style="display: none;"{% endif %}>
           {% if block.settings.subtext %}<p class="subtext">{{ block.settings.subtext }}</p>{% endif %}
            <h2>{{ block.settings.heading }}</h2>
            <div class="description">{{ block.settings.description }}</div>
            {% if block.settings.feature_video != blank %}
               {{ block.settings.feature_video | video_tag: class: 'feature-video', autoplay: true, loop: true, muted: true }}
            {% else %}
              <img src="{{ block.settings.feature_image | img_url: 'master' }}" class="feature-image">
            {% endif %}
          </div>
        {% endfor %}

      </div>
    </div>
  </div>
</section>




<script>
  document.addEventListener("DOMContentLoaded", function() {
    document.querySelectorAll(".custom-marker").forEach(marker => {
      console.log("hello");
      marker.addEventListener("click", function() {
        let id = this.getAttribute("data-target");
        console.log("id",id);
        
        document.querySelectorAll(".content-block").forEach(block => {
          block.style.display = block.getAttribute("data-id") === id ? "block" : "none";
        });
        
        document.querySelectorAll(".custom-marker").forEach(m => m.classList.remove("active"));
        this.classList.add("active");
      });
    });
  });
</script>


{% schema %}
{
  "name": "Custom Product Blik",
  "class": "custom-product-blik",
  "settings": [
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext",
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "image_picker",
      "id": "left_image",
      "label": "Left Side Image"
    }
  ],
  "blocks": [
    {
      "type": "content",
      "name": "Content Block",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "text",
          "id": "subtext",
          "label": "Subtext"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description"
        },
        {
          "type": "image_picker",
          "id": "feature_image",
          "label": "Feature Image"
        },
        {
          "type": "video",
          "id": "feature_video",
          "label": "Feature Video (optional)",
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Product Blik",
      "category": "Custom"
    }
  ]
}
{% endschema %}



