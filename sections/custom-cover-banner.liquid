{%- liquid
  assign img = section.settings.image
  assign has_text = false
  if section.settings.title != blank or section.settings.eyebrow != blank or section.settings.description != blank
    assign has_text = true
  endif
-%}

{%- style -%}
  #cb-{{ section.id }} {
    --cb-bg: {{ section.settings.bg_color }};
    --cb-eyebrow: {{ section.settings.eyebrow_color }};
    --cb-title: {{ section.settings.title_color }};
    --cb-desc: {{ section.settings.desc_color }};
    --cb-feat-text: {{ section.settings.feature_text_color }};
    --cb-feat-bg: {{ section.settings.feature_bg }};
    --cb-feat-bg-opacity: {{ section.settings.feature_bg_opacity }}%;
    --cb-overlay: {{ section.settings.overlay_color }};
    --cb-icon-size: {{ section.settings.icon_size }}px;
    --cb-ratio: {{ section.settings.image_ratio }};
    background: var(--cb-bg);
    border-top: 1px solid {{ section.settings.border_color }};
    border-bottom: 1px solid {{ section.settings.border_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    overflow: hidden;
  }

  #cb-{{ section.id }} .cb__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 24px;
    align-items: stretch;
  }

  #cb-{{ section.id }} .cb__richtext p {
    margin: 0;
    font-size: inherit;
    font-weight: inherit;
    line-height: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    color: inherit;
    font-family: inherit;
  }

  #cb-{{ section.id }} .cb__content {
    position: relative;
    z-index: 2;
    min-width: 0;
    align-self: center;
  }

  #cb-{{ section.id }} .cb__eyebrow {
    margin: 0 0 16px;
    color: var(--cb-eyebrow);
    font-family: var(--font-sans, 'Jost', 'Helvetica Neue', Arial, sans-serif);
    font-size: 12px;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  #cb-{{ section.id }} .cb__title {
    margin: 0 0 20px;
    color: var(--cb-title);
    font-family: var(--font-serif, 'Playfair Display', Georgia, 'Times New Roman', serif);
    font-size: clamp(28px, 3.2vw, 48px);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: 0.01em;
    text-wrap: balance;
    overflow-wrap: break-word;
  }

  #cb-{{ section.id }} .cb__desc {
    margin: 0;
    max-width: 460px;
    color: var(--cb-desc);
    font-family: var(--font-sans, 'Jost', 'Helvetica Neue', Arial, sans-serif);
    font-size: clamp(14px, 1.05vw, 16px);
    font-weight: 400;
    line-height: 1.6;
    letter-spacing: normal;
  }

  #cb-{{ section.id }} .cb__media {
    position: relative;
    min-width: 0;
    width: 100%;
    aspect-ratio: var(--cb-ratio);
    overflow: hidden;
    background: #DED2C3;
  }

  #cb-{{ section.id }} .cb__media img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #cb-{{ section.id }} .cb__media::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(to top, var(--cb-bg) 0%, transparent 25%);
  }

  #cb-{{ section.id }} .cb__overlay {
    position: absolute;
    right: 6%;
    bottom: 8%;
    z-index: 2;
    margin: 0;
    color: var(--cb-overlay);
    font-family: var(--font-script, 'Great Vibes', 'Snell Roundhand', 'Brush Script MT', cursive);
    font-size: clamp(22px, 2.4vw, 36px);
    font-weight: 400;
    line-height: 1.15;
    text-align: center;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.45);
    transform: rotate(-6deg);
    pointer-events: none;
  }

  #cb-{{ section.id }} .cb__features {
    position: relative;
    z-index: 3;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px 16px;
    padding: 4px 0;
    min-width: 0;
  }

  #cb-{{ section.id }} .cb__feature {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
  }

  #cb-{{ section.id }} .cb__icon {
    flex: 0 0 var(--cb-icon-size);
    width: var(--cb-icon-size);
    height: var(--cb-icon-size);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--cb-eyebrow);
  }

  #cb-{{ section.id }} .cb__icon img,
  #cb-{{ section.id }} .cb__icon svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  #cb-{{ section.id }} .cb__feature-text {
    margin: 0;
    color: var(--cb-feat-text);
    font-family: var(--font-sans, 'Jost', 'Helvetica Neue', Arial, sans-serif);
    font-size: 12px;
    font-weight: 400;
    line-height: 1.4;
    overflow-wrap: break-word;
  }

  @media screen and (min-width: 750px) and (max-width: 989px) {
    #cb-{{ section.id }} .cb__grid { gap: 32px; }
    #cb-{{ section.id }} .cb__desc { max-width: 560px; }
    #cb-{{ section.id }} .cb__title { font-size: clamp(32px, 5vw, 44px); }
    #cb-{{ section.id }} .cb__features { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    #cb-{{ section.id }} .cb__feature-text { font-size: 13px; }
  }

  @media screen and (min-width: 990px) {
    #cb-{{ section.id }} .cb__grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      grid-template-rows: 1fr auto;
      gap: 0;
    }

    #cb-{{ section.id }} .cb__content {
      grid-column: 1;
      grid-row: 1;
      padding: 12px clamp(16px, 2vw, 32px) 24px 0;
    }

    #cb-{{ section.id }} .cb__media {
      grid-column: 2;
      grid-row: 1 / span 2;
      aspect-ratio: auto;
      min-height: 380px;
    }

    #cb-{{ section.id }} .cb__media::after {
      background: linear-gradient(to right, var(--cb-bg) 0%, transparent 38%);
    }

    #cb-{{ section.id }} .cb__features {
      grid-column: 1;
      grid-row: 2;
      justify-self: start;
      width: calc(100% + 30%);
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 0;
      padding: 0;
      background: color-mix(in srgb, var(--cb-feat-bg) var(--cb-feat-bg-opacity), transparent);
      -webkit-backdrop-filter: blur(6px);
      backdrop-filter: blur(6px);
      align-self: end;
    }

    #cb-{{ section.id }} .cb__feature { padding: 18px 20px 18px 0; }
    #cb-{{ section.id }} .cb__feature + .cb__feature { padding-left: 16px; }
    #cb-{{ section.id }} .cb__feature-text { font-size: clamp(12px, 0.9vw, 14px); }
  }

  @media screen and (max-width: 749px) {
    #cb-{{ section.id }} .cb__grid { gap: 24px; }
    #cb-{{ section.id }} .cb__title { margin-bottom: 16px; }
    #cb-{{ section.id }} .cb__desc { max-width: 100%; }
    #cb-{{ section.id }} .cb__overlay { right: 5%; bottom: 7%; font-size: 22px; }
    #cb-{{ section.id }} .cb__feature { gap: 10px; }
    #cb-{{ section.id }} .cb__feature-text { font-size: 12px; }
  }

     ============================================ */
  #cb-{{ section.id }} {
    --cb-content-x: -28px;
    --cb-media-x: 28px;
  }

  #cb-{{ section.id }}.cb-anim .cb__content > * {
    opacity: 0;
    transform: translateX(var(--cb-content-x));
    transition:
      opacity 1s cubic-bezier(0.22, 0.61, 0.36, 1),
      transform 1s cubic-bezier(0.22, 0.61, 0.36, 1);
    transition-delay: calc(var(--cb-ci, 0) * 0.12s);
    will-change: opacity, transform;
  }

  #cb-{{ section.id }}.cb-anim .cb__media {
    opacity: 0;
    transform: translateX(var(--cb-media-x));
    transition:
      opacity 1.1s cubic-bezier(0.22, 0.61, 0.36, 1),
      transform 1.1s cubic-bezier(0.22, 0.61, 0.36, 1);
    transition-delay: 0.25s;
    will-change: opacity, transform;
  }

  #cb-{{ section.id }}.cb-anim .cb__feature {
    opacity: 0;
    transform: translateY(20px);
    transition:
      opacity 1s cubic-bezier(0.22, 0.61, 0.36, 1),
      transform 1s cubic-bezier(0.22, 0.61, 0.36, 1);
    transition-delay: calc(0.5s + var(--cb-fi, 0) * 0.15s);
    will-change: opacity, transform;
  }

  #cb-{{ section.id }}.cb-anim.is-visible .cb__content > *,
  #cb-{{ section.id }}.cb-anim.is-visible .cb__media {
    opacity: 1;
    transform: translateX(0);
  }

  #cb-{{ section.id }}.cb-anim.is-visible .cb__feature {
    opacity: 1;
    transform: translateY(0);
  }

  #cb-{{ section.id }}.cb-anim.is-done .cb__content > *,
  #cb-{{ section.id }}.cb-anim.is-done .cb__media,
  #cb-{{ section.id }}.cb-anim.is-done .cb__feature {
    transition-delay: 0s;
    will-change: auto;
  }

  @media screen and (max-width: 749px) {
    #cb-{{ section.id }} {
      --cb-content-x: 0px;
      --cb-media-x: 0px;
    }
    #cb-{{ section.id }}.cb-anim .cb__content > *,
    #cb-{{ section.id }}.cb-anim .cb__media {
      transform: translateY(20px);
    }
    #cb-{{ section.id }}.cb-anim.is-visible .cb__content > *,
    #cb-{{ section.id }}.cb-anim.is-visible .cb__media {
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #cb-{{ section.id }}.cb-anim .cb__content > *,
    #cb-{{ section.id }}.cb-anim .cb__media,
    #cb-{{ section.id }}.cb-anim .cb__feature {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
{%- endstyle -%}

<div id="cb-{{ section.id }}" class="custom-cover-banner">
  <div class="{% unless section.settings.full_width %}page-width{% endunless %}">
    <div class="cb__grid">

      <div class="cb__content">
        {%- if section.settings.eyebrow != blank -%}
          <div class="cb__eyebrow cb__richtext">{{ section.settings.eyebrow }}</div>
        {%- endif -%}

        {%- if section.settings.title != blank -%}
          <div class="cb__title cb__richtext" role="heading" aria-level="2">{{ section.settings.title }}</div>
        {%- endif -%}

        {%- if section.settings.description != blank -%}
          <div class="cb__desc cb__richtext">{{ section.settings.description }}</div>
        {%- endif -%}
      </div>

      <div class="cb__media">
        {%- if img != blank -%}
          <img
            src="{{ img | image_url: width: 1400 }}"
            srcset="{{ img | image_url: width: 600 }} 600w,
                    {{ img | image_url: width: 900 }} 900w,
                    {{ img | image_url: width: 1200 }} 1200w,
                    {{ img | image_url: width: 1600 }} 1600w"
            sizes="(min-width: 990px) 58vw, 100vw"
            alt="{{ img.alt | default: section.settings.title | strip_html | escape }}"
            width="{{ img.width }}"
            height="{{ img.height }}"
            loading="lazy"
          >
        {%- endif -%}

        {%- if section.settings.overlay_text != blank -%}
          <div class="cb__overlay cb__richtext">{{ section.settings.overlay_text }}</div>
        {%- endif -%}
      </div>

      {%- if section.blocks.size > 0 -%}
        <div class="cb__features">
          {%- for block in section.blocks -%}
            <div class="cb__feature" style="--cb-fi: {{ forloop.index0 }}" {{ block.shopify_attributes }}>
              <div class="cb__icon">
                {%- if block.settings.icon != blank -%}
                  <img
                    src="{{ block.settings.icon | image_url: width: 160 }}"
                    alt=""
                    width="{{ section.settings.icon_size }}"
                    height="{{ section.settings.icon_size }}"
                    loading="lazy"
                  >
                {%- else -%}
                  <svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="20" cy="20" r="16"/>
                    <path d="M13 20.5l5 5 9-10"/>
                  </svg>
                {%- endif -%}
              </div>
              {%- if block.settings.text != blank -%}
                <div class="cb__feature-text cb__richtext">{{ block.settings.text }}</div>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}

    </div>
  </div>
</div>

<script>
  (function () {
    var section = document.getElementById('cb-{{ section.id }}');
    if (!section) return;

    var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduced || !('IntersectionObserver' in window)) return;

    section.querySelectorAll('.cb__content > *').forEach(function (el, i) {
      el.style.setProperty('--cb-ci', i);
    });

    section.classList.add('cb-anim');

    var observer = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          section.classList.add('is-visible');
          observer.unobserve(section);
          window.setTimeout(function () {
            section.classList.add('is-done');
          }, 2800);
        }
      });
    }, { threshold: 0.15 });

    observer.observe(section);
  })();
</script>

{% schema %}
{
  "name": "Custom Cover Banner",
  "tag": "section",
  "class": "section",
  "max_blocks": 6,
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "richtext", "id": "eyebrow", "label": "Small Heading", "default": "<p>Eksklusivt betræk</p>" },
    {
      "type": "richtext",
      "id": "title",
      "label": "Title",
      "default": "<p>Nyt betræk.<br>Nyt liv til din sofa.</p>"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Elsker du din Oseberg-sofa, men trænger du til forandring? Med et nyt betræk kan du forny udtrykket, skifte farve og skabe en ny stemning i hjemmet – uden at udskifte hele sofaen.</p>"
    },

    { "type": "header", "content": "Image" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    {
      "type": "richtext",
      "id": "overlay_text",
      "label": "Text on Image (script)",
      "info": "Image ke neeche-right mein. Khaali = hide.",
      "default": "<p>Samme sofa<br>Ny stil</p>"
    },
    { "type": "color", "id": "overlay_color", "label": "Text on Image Color", "default": "#FFFFFF" },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image Shape (Mobile / Tablet)",
      "default": "4 / 3",
      "options": [
        { "value": "16 / 9", "label": "Wide (16:9)" },
        { "value": "3 / 2", "label": "Landscape (3:2)" },
        { "value": "4 / 3", "label": "Landscape (4:3)" },
        { "value": "1 / 1", "label": "Square (1:1)" }
      ]
    },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg_color", "label": "Section Background", "default": "#F5F1EA" },
    { "type": "color", "id": "border_color", "label": "Top / Bottom Border Color", "default": "#DED2C3" },
    { "type": "color", "id": "eyebrow_color", "label": "Small Heading / Icon Color", "default": "#302821" },
    { "type": "color", "id": "title_color", "label": "Title Color", "default": "#302821" },
    { "type": "color", "id": "desc_color", "label": "Description Color", "default": "#302821" },
    { "type": "color", "id": "feature_text_color", "label": "Feature Text Color", "default": "#302821" },
    { "type": "color", "id": "feature_bg", "label": "Feature Bar Background", "default": "#F5F1EA" },
    { "type": "range", "id": "feature_bg_opacity", "min": 0, "max": 100, "step": 5, "unit": "%", "label": "Feature Bar Opacity (Desktop)", "default": 85 },

    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "icon_size", "min": 24, "max": 64, "step": 2, "unit": "px", "label": "Icon Size", "default": 36 },
    { "type": "checkbox", "id": "full_width", "label": "Full Width", "default": false },

    { "type": "header", "content": "Section Spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding Top", "default": 40 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding Bottom", "default": 40 }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        { "type": "image_picker", "id": "icon", "label": "Icon (SVG / PNG upload)", "info": "Khaali = default tick icon." },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Samme komfort<br>– nyt udtryk</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Cover Banner",
      "blocks": [
        { "type": "feature", "settings": { "text": "<p>Samme komfort<br>– nyt udtryk</p>" } },
        { "type": "feature", "settings": { "text": "<p>Forny i stedet<br>for at udskifte</p>" } },
        { "type": "feature", "settings": { "text": "<p>Eksklusivt<br>ribbet tekstil</p>" } },
        { "type": "feature", "settings": { "text": "<p>Designet til<br>alle 4 modeller</p>" } }
      ]
    }
  ]
}
{% endschema %}