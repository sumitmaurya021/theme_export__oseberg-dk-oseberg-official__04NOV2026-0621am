<script>
  document.addEventListener("DOMContentLoaded", function() {
    const tabs = document.querySelectorAll(".custom-tab");
    const contents = document.querySelectorAll(".custom-tabbing-content");
    const section = document.getElementById("tabbing-section");

    tabs.forEach(tab => {
      tab.addEventListener("click", function() {
        tabs.forEach(t => t.classList.remove("active"));
        contents.forEach(c => c.classList.remove("active"));
        
        this.classList.add("active");
        document.getElementById("tab-" + this.getAttribute("data-tab")).classList.add("active");

        // Change section background color dynamically
        let newBgColor = this.getAttribute("data-bg");
        if (newBgColor) {
          section.style.backgroundColor = newBgColor;
        }
      });
    });

    // Set default active tab and background color
    if (tabs.length > 0) {
      tabs[0].click();
    }
  });
</script>

<style>
  .custom-tabbing-image video {
    width: 100%;
    border-radius: 40px;
    aspect-ratio: 1.332;
    height: auto;
    object-fit: cover;
}
</style>