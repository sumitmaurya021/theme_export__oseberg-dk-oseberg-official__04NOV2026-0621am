{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="custom-tabbing-section-container section-{{ section.id }}-padding" id="tabbing-section" style="background-color: {{ section.settings.default_background_color }};">
  <div class="page-width" id="{{ section.settings.section_id }}">
    <div class="custom-tabbing-top-content">
         <p class="custom-tabbing-section-subheading">{{ section.settings.section_subheading }}</p>
         <h2 class="custom-tabbing-section-heading">{{ section.settings.section_heading }}</h2>
    </div>

    <div class="custom-tabbing-button">
      {% for block in section.blocks %}
        <div class="custom-tab" 
             data-tab="{{ block.id }}" 
             data-bg="{{ block.settings.tab_background_color }}"
             style="color:{{ block.settings.tab_title_bg_color }}; background-color: {{ block.settings.tab_title_bg_color }}; border-color: {{ block.settings.tab_title_bg_color }}">
          <span title="{{ block.settings.tab_title }}">{{ block.settings.tab_title }}</span>
        </div>
      {% endfor %}
    </div>

    <div class="custom-tabbing-content-wrapper">
      {% for block in section.blocks %}
        <div class="custom-tabbing-content" id="tab-{{ block.id }}">
          <div class="custom-tab-img-text-content">
            <div class="custom-tabbing-image">
              {% if block.settings.tab_image %}
                <img src="{{ block.settings.tab_image | img_url: 'large' }}" alt="{{ block.settings.heading }}">
              {% elsif block.settings.video %}
                {{ block.settings.video | video_tag: autoplay: true, muted: true }} 
                
              {% endif %}
            </div>
            <div class="custom-tabbing-text-content">
              <div class="cttc">
                {% if block.settings.subheading %}<span style="color: {{ block.settings.tab_title_bg_color }}">{{ block.settings.subheading }}</span>{% endif %}
                {% if block.settings.heading %}<h2>{{ block.settings.heading }}</h2>{% endif %}
                {% if block.settings.description %}<div>{{ block.settings.description }}</div>{% endif %}
              </div>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Custom Tabbing Image Text",
  "settings": [
    {
      "type": "text",
      "id": "section_id",
      "label": "Section Id"
    },
    {
      "type": "text",
      "id": "section_subheading",
      "label": "Sub Heading"
    },
    {
      "type": "text",
      "id": "section_heading",
      "label": "Main Heading"
    },
    {
      "type": "color",
      "id": "default_background_color",
      "label": "Default Background Color",
      "default": "#f7f7f7"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab Item",
      "settings": [
        {
          "type": "text",
          "id": "tab_title",
          "label": "Tab Title"
        },
        {
          "type": "color",
          "id": "tab_title_bg_color",
          "label": "Tab Background Color",
          "default": "#ffffff"
        },
        {
          "type": "image_picker",
          "id": "tab_image",
          "label": "Tab Image"
        },
        {
      "type": "video",
      "id": "video",
      "label": "Upload Video"
    },
        {
          "type": "text",
          "id": "subheading",
          "label": "Subheading"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "inline_richtext",
          "id": "description",
          "label": "Description"
        },
        {
          "type": "color",
          "id": "tab_background_color",
          "label": "Tab Background Color",
          "default": "#ffffff"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Tabbing Image Text"
    }
  ]
}
{% endschema %}

