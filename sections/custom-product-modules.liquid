{%- liquid
  assign mf = product.metafields.custom
  assign pm_title = mf.moduler_titel.value
  assign pm_desc = mf.moduler_beskrivelse.value
  assign pm_link_text = mf.moduler_knaptekst.value
  assign pm_images = mf.moduler_billeder.value
  assign pm_titles = mf.moduler_titler.value | strip | newline_to_br | split: '<br />'
  assign pm_subs = mf.moduler_undertekster.value | strip | newline_to_br | split: '<br />'
  assign pm_links = mf.moduler_links.value | default: empty
  assign pm_count = pm_images.size | at_most: 3
-%}

{%- if pm_title != blank or pm_count > 0 -%}

{%- style -%}
  #pmod-{{ section.id }} {
    --pm-title: {{ section.settings.title_color }};
    --pm-desc: {{ section.settings.desc_color }};
    --pm-card-title: {{ section.settings.card_title_color }};
    --pm-card-sub: {{ section.settings.card_sub_color }};
    --pm-link: {{ section.settings.link_color }};
    --pm-link-hover: {{ section.settings.link_hover_color }};
    --pm-radius: {{ section.settings.image_radius }}px;
    --pm-ratio: {{ section.settings.image_ratio }};
    background: {{ section.settings.bg_color }};
    border-top: 1px solid {{ section.settings.border_color }};
    border-bottom: 1px solid {{ section.settings.border_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    overflow: hidden;
  }

  /* ---------- Heading ---------- */
  #pmod-{{ section.id }} .pm__head { margin: 0 0 32px; }

  #pmod-{{ section.id }} .pm__title {
    margin: 0 0 16px;
    color: var(--pm-title);
    font-family: var(--font-serif, 'Playfair Display', Georgia, 'Times New Roman', serif);
    font-size: clamp(28px, 3.2vw, 48px);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: 0.01em;
    text-wrap: balance;
    overflow-wrap: break-word;
  }

  #pmod-{{ section.id }} .pm__desc {
    margin: 0;
    max-width: 440px;
    color: var(--pm-desc);
    font-family: var(--font-sans, 'Jost', 'Helvetica Neue', Arial, sans-serif);
    font-size: clamp(14px, 1.05vw, 16px);
    font-weight: 400;
    line-height: 1.6;
    letter-spacing: normal;
  }

  /* ---------- Cards ---------- */
  #pmod-{{ section.id }} .pm__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 28px;
  }

  #pmod-{{ section.id }} .pm__card {
    display: block;
    min-width: 0;
    color: inherit;
    text-decoration: none;
  }

  #pmod-{{ section.id }} .pm__media {
    position: relative;
    width: 100%;
    aspect-ratio: var(--pm-ratio);
    overflow: hidden;
    border-radius: var(--pm-radius);
    background: #DED2C3;
  }

  #pmod-{{ section.id }} .pm__media img,
  #pmod-{{ section.id }} .pm__media svg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s ease;
  }

  #pmod-{{ section.id }} a.pm__card:hover .pm__media img { transform: scale(1.04); }

  #pmod-{{ section.id }} .pm__card-title {
    margin: 14px 0 4px;
    color: var(--pm-card-title);
    font-family: var(--font-serif, 'Playfair Display', Georgia, 'Times New Roman', serif);
    font-size: clamp(16px, 1.3vw, 18px);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: 0.01em;
    overflow-wrap: break-word;
  }

  #pmod-{{ section.id }} .pm__card-sub {
    margin: 0 0 10px;
    color: var(--pm-card-sub);
    font-family: var(--font-sans, 'Jost', 'Helvetica Neue', Arial, sans-serif);
    font-size: 12px;
    font-weight: 400;
    line-height: 1.5;
    letter-spacing: normal;
  }

  #pmod-{{ section.id }} .pm__more {
    display: inline-flex;
    align-items: center;
    color: var(--pm-link);
    font-family: var(--font-sans, 'Jost', 'Helvetica Neue', Arial, sans-serif);
    font-size: 12px;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: 0.02em;
    transition: color 0.4s ease;
  }

  #pmod-{{ section.id }} a.pm__card:hover .pm__more { color: var(--pm-link-hover); }

  /* ---------- Tablet (750px - 989px) ---------- */
  @media screen and (min-width: 750px) and (max-width: 989px) {
    #pmod-{{ section.id }} .pm__title { font-size: clamp(32px, 5vw, 44px); }
    #pmod-{{ section.id }} .pm__desc { max-width: 560px; }
    #pmod-{{ section.id }} .pm__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 20px;
    }
  }

  /* ---------- Desktop (990px and up) ---------- */
  @media screen and (min-width: 990px) {
    #pmod-{{ section.id }} .pm__grid {
      grid-template-columns: repeat({{ pm_count | at_least: 1 }}, minmax(0, 1fr));
      gap: clamp(16px, 2vw, 32px);
    }
  }

  /* ---------- Mobile (749px and below) ---------- */
  @media screen and (max-width: 749px) {
    #pmod-{{ section.id }} .pm__head { margin-bottom: 24px; }
    #pmod-{{ section.id }} .pm__title { margin-bottom: 12px; }
    #pmod-{{ section.id }} .pm__desc { max-width: 100%; }
    #pmod-{{ section.id }} .pm__grid { gap: 28px; }
  }

  /* ============================================
     ANIMATIONS (premium, subtle)
     JS chalega to hi hide hota hai, warna content hamesha visible rahega
     ============================================ */
  #pmod-{{ section.id }}.pm-anim .pm__head > *,
  #pmod-{{ section.id }}.pm-anim .pm__card {
    opacity: 0;
    transform: translateY(20px);
    transition:
      opacity 1s cubic-bezier(0.22, 0.61, 0.36, 1),
      transform 1s cubic-bezier(0.22, 0.61, 0.36, 1),
      color 0.4s ease;
    transition-delay: calc(var(--pm-i, 0) * 0.15s);
    will-change: opacity, transform;
  }

  #pmod-{{ section.id }}.pm-anim.is-visible .pm__head > *,
  #pmod-{{ section.id }}.pm-anim.is-visible .pm__card {
    opacity: 1;
    transform: translateY(0);
  }

  #pmod-{{ section.id }}.pm-anim.is-done .pm__head > *,
  #pmod-{{ section.id }}.pm-anim.is-done .pm__card {
    transition-delay: 0s;
    will-change: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    #pmod-{{ section.id }}.pm-anim .pm__head > *,
    #pmod-{{ section.id }}.pm-anim .pm__card {
      opacity: 1;
      transform: none;
      transition: none;
    }
    #pmod-{{ section.id }} .pm__media img { transition: none; }
  }
{%- endstyle -%}

<div id="pmod-{{ section.id }}" class="custom-product-modules">
  <div class="{% unless section.settings.full_width %}page-width{% endunless %}">

    {%- if pm_title != blank or pm_desc != blank -%}
      <div class="pm__head">
        {%- if pm_title != blank -%}
          <h2 class="pm__title">{{ pm_title | escape | newline_to_br }}</h2>
        {%- endif -%}
        {%- if pm_desc != blank -%}
          <p class="pm__desc">{{ pm_desc | escape | newline_to_br }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if pm_count > 0 -%}
      <div class="pm__grid">
        {%- for img in pm_images limit: 3 -%}
          {%- assign idx = forloop.index0 -%}
          {%- assign card_title = pm_titles[idx] | strip -%}
          {%- assign card_sub = pm_subs[idx] | strip -%}
          {%- assign card_product = pm_links | slice: idx, 1 | first -%}
          {%- if card_product != blank -%}
            {%- assign tag = 'a' -%}
          {%- else -%}
            {%- assign tag = 'div' -%}
          {%- endif -%}
          <{{ tag }}{% if tag == 'a' %} href="{{ card_product.url }}"{% endif %} class="pm__card">
            <div class="pm__media">
              <img
                src="{{ img | image_url: width: 800 }}"
                srcset="{{ img | image_url: width: 400 }} 400w,
                        {{ img | image_url: width: 600 }} 600w,
                        {{ img | image_url: width: 800 }} 800w,
                        {{ img | image_url: width: 1000 }} 1000w"
                sizes="(min-width: 990px) 30vw, (min-width: 750px) 30vw, 100vw"
                alt="{{ img.alt | default: card_title | escape }}"
                width="{{ img.width }}"
                height="{{ img.height }}"
                loading="lazy"
              >
            </div>
            {%- if card_title != blank -%}
              <h3 class="pm__card-title">{{ card_title | escape }}</h3>
            {%- endif -%}
            {%- if card_sub != blank -%}
              <p class="pm__card-sub">{{ card_sub | escape }}</p>
            {%- endif -%}
            {%- if card_product != blank and pm_link_text != blank -%}
              <span class="pm__more">{{ pm_link_text | escape }}</span>
            {%- endif -%}
          </{{ tag }}>
        {%- endfor -%}
      </div>
    {%- endif -%}

  </div>
</div>

<script>
  (function () {
    var section = document.getElementById('pmod-{{ section.id }}');
    if (!section) return;

    var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduced || !('IntersectionObserver' in window)) return;

    section.querySelectorAll('.pm__head > *, .pm__card').forEach(function (el, i) {
      el.style.setProperty('--pm-i', i);
    });

    section.classList.add('pm-anim');

    var observer = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          section.classList.add('is-visible');
          observer.unobserve(section);
          window.setTimeout(function () {
            section.classList.add('is-done');
          }, 2200);
        }
      });
    }, { threshold: 0.1 });

    observer.observe(section);
  })();
</script>

{%- elsif request.design_mode -%}
  <div class="page-width" style="padding: 24px 0; text-align: center; opacity: .6;">
    Produktmoduler: moduler-metafelterne er tomme for dette produkt.
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Custom Product Modules",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "paragraph", "content": "Text, images aur links product ke metafields (custom.moduler_*) se aate hain." },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg_color", "label": "Section Background", "default": "#F5F1EA" },
    { "type": "color", "id": "border_color", "label": "Top / Bottom Border Color", "default": "#DED2C3" },
    { "type": "color", "id": "title_color", "label": "Title Color", "default": "#302821" },
    { "type": "color", "id": "desc_color", "label": "Description Color", "default": "#302821" },
    { "type": "color", "id": "card_title_color", "label": "Card Title Color", "default": "#302821" },
    { "type": "color", "id": "card_sub_color", "label": "Card Subtitle Color", "default": "#A58C76" },
    { "type": "color", "id": "link_color", "label": "Card Link Color", "default": "#302821" },
    { "type": "color", "id": "link_hover_color", "label": "Card Link Hover Color", "default": "#A58C76" },

    { "type": "header", "content": "Layout" },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Card Image Shape",
      "default": "4 / 3",
      "options": [
        { "value": "16 / 9", "label": "Wide (16:9)" },
        { "value": "3 / 2", "label": "Landscape (3:2)" },
        { "value": "4 / 3", "label": "Landscape (4:3)" },
        { "value": "1 / 1", "label": "Square (1:1)" }
      ]
    },
    { "type": "range", "id": "image_radius", "min": 0, "max": 32, "step": 2, "unit": "px", "label": "Image Corner Radius", "default": 16 },
    { "type": "checkbox", "id": "full_width", "label": "Full Width", "default": false },

    { "type": "header", "content": "Section Spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding Top", "default": 48 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding Bottom", "default": 48 }
  ],
  "presets": [
    { "name": "Custom Product Modules" }
  ]
}
{% endschema %}