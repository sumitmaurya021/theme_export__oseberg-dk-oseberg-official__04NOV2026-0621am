{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .custom-quote-banner--{{ section.id }}::before {
    opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
  }
{%- endstyle -%}

<div class="custom-quote-banner custom-quote-banner--{{ section.id }}{% unless section.settings.full_width %} page-width{% endunless %}">
  {%- if section.settings.image != blank -%}
    <div class="custom-quote-banner__media">
      {{
        section.settings.image
        | image_url: width: 2400
        | image_tag: loading: 'lazy', widths: '750, 1100, 1500, 2000, 2400', sizes: '100vw', alt: section.settings.image.alt
      }}
    </div>
  {%- endif -%}

  <div class="custom-quote-banner__content section-{{ section.id }}-padding">
    {%- if section.settings.quote != blank -%}
      <blockquote class="custom-quote-banner__quote">
        {{ section.settings.quote }}
      </blockquote>
    {%- endif -%}
    {%- if section.settings.title != blank -%}
      <p class="custom-quote-banner__title">{{ section.settings.title | escape }}</p>
    {%- endif -%}
  </div>
</div>

<style>
  .custom-quote-banner {
    --oseberg-ivory: #F5F1EA;
    --oseberg-sand: #DED2C3;
    --oseberg-espresso: #302821;
    --oseberg-taupe: #A58C76;
    --oseberg-white: #FFFFFF;

    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 32rem;
    background-color: var(--oseberg-espresso);
  }

  @media screen and (min-width: 750px) {
    .custom-quote-banner {
      min-height: 46rem;
    }
  }

  .custom-quote-banner__media,
  .custom-quote-banner__media img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .custom-quote-banner::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: var(--oseberg-espresso);
    z-index: 1;
  }

  .custom-quote-banner__content {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 80rem;
    margin: 0 auto;
    padding-left: 2rem;
    padding-right: 2rem;
    text-align: center;
  }

  .custom-quote-banner__quote {
    margin: 0;
    font-family: 'Playfair Display', serif;
    font-weight: 400;
    font-style: italic;
    font-size: 2.4rem;
    line-height: 1.5;
    color: var(--oseberg-ivory);
  }

  .custom-quote-banner__quote p {
    margin: 0;
  }

  @media screen and (min-width: 750px) {
    .custom-quote-banner__quote {
      font-size: 3.6rem;
    }
  }

  .custom-quote-banner__title {
    margin: 2.4rem 0 0;
    font-family: 'Jost', sans-serif;
    font-weight: 400;
    font-size: 1.2rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--oseberg-sand);
  }
</style>

{% schema %}
{
  "name": "Custom Quote Banner",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "label": "Dark overlay",
      "default": 45
    },
    {
      "type": "richtext",
      "id": "quote",
      "label": "Quote",
      "default": "<p>“Design er ikke det, man ser. Det er den ro, man mærker, når man træder ind.”</p>"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Vores grundtanke"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "default": true,
      "label": "Full width"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Custom Quote Banner"
    }
  ]
}
{% endschema %}