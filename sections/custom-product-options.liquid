{%- liquid
  assign mf = product.metafields.custom
  assign po_heading = mf.muligheder_overskrift.value
  assign po_sub = mf.muligheder_underoverskrift.value
  assign po_images = mf.muligheder_billeder.value
  assign po_titles = mf.muligheder_titler.value | strip | newline_to_br | split: '<br />'
  assign po_descs = mf.muligheder_beskrivelser.value | strip | newline_to_br | split: '<br />'
  assign po_count = po_images.size
-%}

{%- if po_count > 0 -%}

{%- style -%}
  #poptions-{{ section.id }} {
    --po-heading: {{ section.settings.title_color }};
    --po-sub: {{ section.settings.sub_color }};
    --po-title: {{ section.settings.card_title_color }};
    --po-desc: {{ section.settings.card_desc_color }};
    --po-card-bg: {{ section.settings.card_bg }};
    --po-card-border: {{ section.settings.card_border }};
    --po-radius: {{ section.settings.image_radius }}px;
    --po-ratio: {{ section.settings.image_ratio }};
    background: {{ section.settings.bg_color }};
    border-top: 1px solid {{ section.settings.border_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    overflow: hidden;
  }

  /* ---------- Heading ---------- */
  #poptions-{{ section.id }} .po__head {
    margin: 0 0 32px;
  }

  #poptions-{{ section.id }} .po__heading {
    margin: 0 0 12px;
    color: var(--po-heading);
    font-family: var(--font-serif, 'Playfair Display', Georgia, 'Times New Roman', serif);
    font-size: clamp(28px, 3.2vw, 48px);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: 0.01em;
    text-wrap: balance;
    overflow-wrap: break-word;
  }

  #poptions-{{ section.id }} .po__sub {
    margin: 0;
    max-width: 640px;
    color: var(--po-sub);
    font-family: var(--font-sans, 'Jost', 'Helvetica Neue', Arial, sans-serif);
    font-size: clamp(14px, 1.05vw, 16px);
    font-weight: 400;
    line-height: 1.6;
    letter-spacing: normal;
  }

  /* ---------- Cards ---------- */
  #poptions-{{ section.id }} .po__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  #poptions-{{ section.id }} .po__card {
    min-width: 0;
    background: var(--po-card-bg);
    border: 1px solid var(--po-card-border);
    border-radius: var(--po-radius);
    overflow: hidden;
  }

  #poptions-{{ section.id }} .po__media {
    position: relative;
    width: 100%;
    aspect-ratio: var(--po-ratio);
    overflow: hidden;
    background: #DED2C3;
  }

  #poptions-{{ section.id }} .po__media img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s ease;
  }

  #poptions-{{ section.id }} .po__card:hover .po__media img {
    transform: scale(1.04);
  }

  #poptions-{{ section.id }} .po__body {
    padding: 14px 14px 16px;
  }

  #poptions-{{ section.id }} .po__title {
    margin: 0 0 4px;
    color: var(--po-title);
    font-family: var(--font-sans, 'Jost', 'Helvetica Neue', Arial, sans-serif);
    font-size: 14px;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: 0.02em;
    overflow-wrap: break-word;
  }

  #poptions-{{ section.id }} .po__desc {
    margin: 0;
    color: var(--po-desc);
    font-family: var(--font-sans, 'Jost', 'Helvetica Neue', Arial, sans-serif);
    font-size: 12px;
    font-weight: 400;
    line-height: 1.5;
    letter-spacing: normal;
  }

  /* ---------- Tablet (750px - 989px) ---------- */
  @media screen and (min-width: 750px) and (max-width: 989px) {
    #poptions-{{ section.id }} .po__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 16px;
    }
    #poptions-{{ section.id }} .po__heading { font-size: clamp(32px, 5vw, 44px); }
  }

  /* ---------- Desktop (990px and up) ---------- */
  @media screen and (min-width: 990px) {
    #poptions-{{ section.id }} .po__grid {
      grid-template-columns: repeat({{ po_count | at_most: 5 }}, minmax(0, 1fr));
      gap: clamp(12px, 1.2vw, 20px);
    }
    #poptions-{{ section.id }} .po__title { font-size: 15px; }
  }

  /* ---------- Mobile (749px and below) ---------- */
  @media screen and (max-width: 749px) {
    #poptions-{{ section.id }} .po__head { margin-bottom: 24px; }
    #poptions-{{ section.id }} .po__heading { margin-bottom: 10px; }
    #poptions-{{ section.id }} .po__title { font-size: 13px; }
  }

  /* ============================================
     ANIMATIONS (premium, subtle)
     JS chalega to hi hide hota hai, warna content hamesha visible rahega
     ============================================ */
  #poptions-{{ section.id }}.po-anim .po__head > *,
  #poptions-{{ section.id }}.po-anim .po__card {
    opacity: 0;
    transform: translateY(20px);
    transition:
      opacity 1s cubic-bezier(0.22, 0.61, 0.36, 1),
      transform 1s cubic-bezier(0.22, 0.61, 0.36, 1);
    transition-delay: calc(var(--po-i, 0) * 0.12s);
    will-change: opacity, transform;
  }

  #poptions-{{ section.id }}.po-anim.is-visible .po__head > *,
  #poptions-{{ section.id }}.po-anim.is-visible .po__card {
    opacity: 1;
    transform: translateY(0);
  }

  #poptions-{{ section.id }}.po-anim.is-done .po__head > *,
  #poptions-{{ section.id }}.po-anim.is-done .po__card {
    transition-delay: 0s;
    will-change: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    #poptions-{{ section.id }}.po-anim .po__head > *,
    #poptions-{{ section.id }}.po-anim .po__card {
      opacity: 1;
      transform: none;
      transition: none;
    }
    #poptions-{{ section.id }} .po__media img { transition: none; }
  }
{%- endstyle -%}

<div id="poptions-{{ section.id }}" class="custom-product-options">
  <div class="{% unless section.settings.full_width %}page-width{% endunless %}">

    {%- if po_heading != blank or po_sub != blank -%}
      <div class="po__head">
        {%- if po_heading != blank -%}
          <h2 class="po__heading">{{ po_heading | escape }}</h2>
        {%- endif -%}
        {%- if po_sub != blank -%}
          <p class="po__sub">{{ po_sub | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="po__grid">
      {%- for img in po_images limit: 5 -%}
        {%- assign idx = forloop.index0 -%}
        {%- assign card_title = po_titles[idx] | strip -%}
        {%- assign card_desc = po_descs[idx] | strip -%}
        <div class="po__card">
          <div class="po__media">
            <img
              src="{{ img | image_url: width: 600 }}"
              srcset="{{ img | image_url: width: 300 }} 300w,
                      {{ img | image_url: width: 450 }} 450w,
                      {{ img | image_url: width: 600 }} 600w,
                      {{ img | image_url: width: 800 }} 800w"
              sizes="(min-width: 990px) 20vw, (min-width: 750px) 33vw, 50vw"
              alt="{{ img.alt | default: card_title | escape }}"
              width="{{ img.width }}"
              height="{{ img.height }}"
              loading="lazy"
            >
          </div>
          {%- if card_title != blank or card_desc != blank -%}
            <div class="po__body">
              {%- if card_title != blank -%}
                <h3 class="po__title">{{ card_title | escape }}</h3>
              {%- endif -%}
              {%- if card_desc != blank -%}
                <p class="po__desc">{{ card_desc | escape }}</p>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

  </div>
</div>

<script>
  (function () {
    var section = document.getElementById('poptions-{{ section.id }}');
    if (!section) return;

    var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduced || !('IntersectionObserver' in window)) return;

    section.querySelectorAll('.po__head > *, .po__card').forEach(function (el, i) {
      el.style.setProperty('--po-i', i);
    });

    section.classList.add('po-anim');

    var observer = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          section.classList.add('is-visible');
          observer.unobserve(section);
          window.setTimeout(function () {
            section.classList.add('is-done');
          }, 2200);
        }
      });
    }, { threshold: 0.15 });

    observer.observe(section);
  })();
</script>

{%- elsif request.design_mode -%}
  <div class="page-width" style="padding: 24px 0; text-align: center; opacity: .6;">
    Produktmuligheder: muligheder-metafelterne er tomme for dette produkt.
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Custom Product Options",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "paragraph", "content": "Heading, images, titles aur descriptions product ke metafields (custom.muligheder_*) se aate hain." },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg_color", "label": "Section Background", "default": "#F5F1EA" },
    { "type": "color", "id": "border_color", "label": "Top Border Color", "default": "#A58C76" },
    { "type": "color", "id": "title_color", "label": "Heading Color", "default": "#302821" },
    { "type": "color", "id": "sub_color", "label": "Subheading Color", "default": "#302821" },
    { "type": "color", "id": "card_bg", "label": "Card Background", "default": "#FFFFFF" },
    { "type": "color", "id": "card_border", "label": "Card Border Color", "default": "#DED2C3" },
    { "type": "color", "id": "card_title_color", "label": "Card Title Color", "default": "#302821" },
    { "type": "color", "id": "card_desc_color", "label": "Card Description Color", "default": "#A58C76" },

    { "type": "header", "content": "Layout" },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image Shape",
      "default": "4 / 3",
      "options": [
        { "value": "16 / 9", "label": "Wide (16:9)" },
        { "value": "4 / 3", "label": "Landscape (4:3)" },
        { "value": "1 / 1", "label": "Square (1:1)" },
        { "value": "4 / 5", "label": "Portrait (4:5)" }
      ]
    },
    { "type": "range", "id": "image_radius", "min": 0, "max": 24, "step": 2, "unit": "px", "label": "Card Corner Radius", "default": 0 },
    { "type": "checkbox", "id": "full_width", "label": "Full Width", "default": false },

    { "type": "header", "content": "Section Spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding Top", "default": 48 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding Bottom", "default": 48 }
  ],
  "presets": [
    { "name": "Custom Product Options" }
  ]
}
{% endschema %}