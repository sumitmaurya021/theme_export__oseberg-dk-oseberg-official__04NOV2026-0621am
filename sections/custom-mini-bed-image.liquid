{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<section class="custom-mini-beds section-{{ section.id }}-padding" style="background-color: {{ section.settings.bg_color }};">
  <div class="page-width">
     <div class="custom-mini-beds-container">
     {% if section.settings.sub_heading %}<h3 class="custom-subheading">{{ section.settings.sub_heading }}</h3>{% endif %}
    {% if section.settings.heading %}<h2 class="custom-heading">{{ section.settings.heading }}</h2>{% endif %}
    <div class="custom-mini-beds-content">
      {% for block in section.blocks %}
        <a class="mini-bed-container" href="{{ block.settings.button_link }}">
  {% if block.settings.image != blank %}
    <img src="{{ block.settings.image | img_url: '500x' }}" class="mini-bed-image" loading="lazy" alt="{{ block.settings.title }}">
  {% endif %}
  <span class="mini-bed-overlay"></span>

  <div class="mini-bed-content">
    <div class="custom-mini-titles">
      <span class="mini-bed-subtitle">{{ block.settings.sub_Title }}</span>
      <h3 class="mini-bed-title">{{ block.settings.main_title }}</h3>
    </div>
    <div class="custom-mini-button">
      <span class="mini-button">
        <span title="{{ block.settings.button_label }}">{{ block.settings.button_label }}</span>
      </span>
    </div>
  </div>
</a>

      {% endfor %}
    </div>
  </div>
  </div> 
</section>

{% comment %}
  

<style>
  .custom-mini-beds {
    text-align: center;
    padding: 50px 0;
    background: #fff;
  }
  .custom-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }
  .custom-heading {
    font-size: 28px;
    font-weight: bold;
    color: #333;
    margin-bottom: 30px;
  }
  .custom-mini-beds-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }
  .custom-mini-bed {
    background: #f8f8f8;
    padding: 20px;
    border-radius: 15px;
    text-align: center;
    transition: all 0.3s ease-in-out;
  }
  .custom-mini-bed:hover {
    transform: translateY(-5px);
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
  }
  .custom-mini-bed-image img {
    width: 100%;
    border-radius: 10px;
  }
  .custom-mini-bed-title {
    font-size: 20px;
    color: #222;
    margin: 15px 0;
  }
  .custom-mini-bed-button {
    display: inline-block;
    padding: 12px 18px;
    background: #000;
    color: #fff;
    text-decoration: none;
    border-radius: 5px;
    font-weight: bold;
    transition: all 0.3s ease-in-out;
  }
  .custom-mini-bed-button:hover {
    background: #444;
  }
</style>
{% endcomment %}

{% schema %}
{
  "name": "Custom Mini Beds",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f9f3ee"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Vores Mini-senge"
    },
    {
      "type": "text",
      "id": "sub_heading",
      "label": "Sub Heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "bed",
      "name": "Mini Bed",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "sub_Title",
          "label": "Sub Title",
          "default": "Bed Name"
        },
         {
          "type": "text",
          "id": "main_title",
          "label": "Main Title",
          "default": "Bed Name"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button Label",
          "default": "Explore"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Mini Beds",
    }
  ]
}
{% endschema %}
