{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}


<div class="custom-return-exchange-section section-{{ section.id }}-padding" style="background-color: {{ section.settings.background_color }};">
  <h3 class="subheading">{{ section.settings.subheading }}</h3>
  <h2 class="heading">{{ section.settings.heading }}</h2>
  <div class="description">
    {{ section.settings.description }}
  </div>
  <div class="buttons">
    <a href="{{ section.settings.exchange_link }}" class="btn" title="Ombyt">
      <span>{{ section.settings.exchange_text }}</span></a>
    <a href="{{ section.settings.return_link }}" class="btn" title="Returner">
      <span>{{ section.settings.return_text }}</span></a>
  </div>
</div>


{% schema %}
{
  "name": "Return & Exchange Section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Hvis du skifter mening"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Ombytning / Returnering"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Har du givet din nye seng eller dit soveprodukt en lang, god prøvesøvning, og kan du mærke, at der skal småjusteringer til, inden den sidder lige i øjet, eller har du blot fortrudt dit køb, har du naturligvis mulighed for at ombytte eller returnere dit produkt inden for de første 100 nætter. Det er både gratis, nemt og vi stiller ikke spørgsmålstegn til dit valg. Læs mere om dine muligheder herunder.</p>"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#f9f6f2"
    },
    {
      "type": "url",
      "id": "exchange_link",
      "label": "Exchange Button Link"
    },
    {
      "type": "text",
      "id": "exchange_text",
      "label": "Exchange Button Text",
      "default": "Ombyt"
    },
    {
      "type": "url",
      "id": "return_link",
      "label": "Return Button Link"
    },
    {
      "type": "text",
      "id": "return_text",
      "label": "Return Button Text",
      "default": "Returner"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Return & Exchange Section",
      "category": "Custom"
    }
  ]
}
{% endschema %}

<style>
  .custom-return-exchange-section {
      text-align: center;
      padding: 100px 40px;
      border-radius: 10px;
  }
  .custom-return-exchange-section .subheading {
      color: var(--color-gray);
      font-size: 14px;
      font-weight: 400;
      margin: 0px;
      padding-bottom: 16px;
      line-height: 22.4px;
  }
.custom-return-exchange-section .heading {
    font-size: 32px;
    font-weight: 700;
    line-height: 38.4px;
    margin: 0px;
    padding-bottom: 16px;
}
.custom-return-exchange-section .description {
    max-width: 670px;
    margin: 0 auto;
}
.custom-return-exchange-section .description p {
    margin: 0;
    padding-bottom: 16px;
}
.custom-return-exchange-section .buttons {
    margin-top: 16px;
    display: flex;
    justify-content: center;
    gap: 16px;
}
.custom-return-exchange-section .buttons .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 20px;
    border: 1px solid var(--color-primary);
    color: var(--color-primary);
    text-decoration: none;
    border-radius: 60px;
    font-weight: 500;
    line-height: 1;
    position: relative;
    overflow: hidden;
    transition: all .1s;
}
.custom-return-exchange-section .buttons .btn span {
    transition: all .3s;
    position: relative;
    top: 0;
}
.custom-return-exchange-section .buttons .btn::before {
    content: attr(title) !important;
    position: absolute;
    transform: translateY(40px);
    left: 0;
    right: 0;
    transition: all .3s;
}
.custom-return-exchange-section .buttons .btn:hover:before {
    transform: translateY(0);
}  
.custom-return-exchange-section .buttons .btn:hover {
    background-color: var(--color-primary) !important;
    color: var(--color-white) !important;
}
.custom-return-exchange-section .buttons .btn:hover span {
    top: -40px;
}  
@media screen and (max-width: 1279px) and (min-width: 1024px) {
  .custom-return-exchange-section {
      padding: 64px 40px 100px;
  }
}
@media screen and (max-width: 1023px) {
  .custom-return-exchange-section {
      padding: 48px 20px 100px;
  }
}  
</style>
