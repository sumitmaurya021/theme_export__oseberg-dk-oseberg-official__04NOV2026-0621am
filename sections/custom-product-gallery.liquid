{%- liquid
  assign mf = product.metafields.custom
  assign pg_title = mf.galleri_titel.value
  assign pg_images = mf.galleri_billeder.value
  assign pg_count = pg_images.size | at_most: 4
-%}

{%- if pg_title != blank or pg_count > 0 -%}

{%- style -%}
  #pgal-{{ section.id }} {
    --pg-title: {{ section.settings.title_color }};
    --pg-radius: {{ section.settings.image_radius }}px;
    --pg-ratio: {{ section.settings.image_ratio }};
    background: {{ section.settings.bg_color }};
    border-top: 1px solid {{ section.settings.border_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    overflow: hidden;
  }

  #pgal-{{ section.id }} .pg__title {
    margin: 0 0 24px;
    color: var(--pg-title);
    font-family: var(--font-serif, 'Playfair Display', Georgia, 'Times New Roman', serif);
    font-size: clamp(22px, 2.4vw, 36px);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: 0.01em;
    text-wrap: balance;
    overflow-wrap: break-word;
  }

  #pgal-{{ section.id }} .pg__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  #pgal-{{ section.id }} .pg__item {
    position: relative;
    min-width: 0;
    width: 100%;
    aspect-ratio: var(--pg-ratio);
    overflow: hidden;
    border-radius: var(--pg-radius);
    background: #DED2C3;
  }

  #pgal-{{ section.id }} .pg__item img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s ease;
  }

  #pgal-{{ section.id }} .pg__item:hover img { transform: scale(1.05); }

  @media screen and (min-width: 750px) and (max-width: 989px) {
    #pgal-{{ section.id }} .pg__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 12px;
    }
  }

  @media screen and (min-width: 990px) {
    #pgal-{{ section.id }} .pg__grid {
      grid-template-columns: repeat({{ pg_count | at_least: 1 }}, minmax(0, 1fr));
      gap: clamp(12px, 1.2vw, 20px);
    }
  }

  @media screen and (max-width: 749px) {
    #pgal-{{ section.id }} .pg__title { margin-bottom: 18px; }
  }

  /* ============================================
     ANIMATIONS (premium, subtle)
     JS chalega to hi hide hota hai, warna content hamesha visible rahega
     ============================================ */
  #pgal-{{ section.id }}.pg-anim .pg__title,
  #pgal-{{ section.id }}.pg-anim .pg__item {
    opacity: 0;
    transform: translateY(20px);
    transition:
      opacity 1s cubic-bezier(0.22, 0.61, 0.36, 1),
      transform 1s cubic-bezier(0.22, 0.61, 0.36, 1);
    transition-delay: calc(var(--pg-i, 0) * 0.12s);
    will-change: opacity, transform;
  }

  #pgal-{{ section.id }}.pg-anim.is-visible .pg__title,
  #pgal-{{ section.id }}.pg-anim.is-visible .pg__item {
    opacity: 1;
    transform: translateY(0);
  }

  #pgal-{{ section.id }}.pg-anim.is-done .pg__title,
  #pgal-{{ section.id }}.pg-anim.is-done .pg__item {
    transition-delay: 0s;
    will-change: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    #pgal-{{ section.id }}.pg-anim .pg__title,
    #pgal-{{ section.id }}.pg-anim .pg__item {
      opacity: 1;
      transform: none;
      transition: none;
    }
    #pgal-{{ section.id }} .pg__item img { transition: none; }
  }
{%- endstyle -%}

<div id="pgal-{{ section.id }}" class="custom-product-gallery">
  <div class="{% unless section.settings.full_width %}page-width{% endunless %}">

    {%- if pg_title != blank -%}
      <h2 class="pg__title">{{ pg_title | escape | newline_to_br }}</h2>
    {%- endif -%}

    {%- if pg_count > 0 -%}
      <div class="pg__grid">
        {%- for img in pg_images limit: 4 -%}
          <div class="pg__item">
            <img
              src="{{ img | image_url: width: 800 }}"
              srcset="{{ img | image_url: width: 400 }} 400w,
                      {{ img | image_url: width: 600 }} 600w,
                      {{ img | image_url: width: 800 }} 800w,
                      {{ img | image_url: width: 1000 }} 1000w"
              sizes="(min-width: 990px) 24vw, (min-width: 750px) 24vw, 50vw"
              alt="{{ img.alt | default: pg_title | escape }}"
              width="{{ img.width }}"
              height="{{ img.height }}"
              loading="lazy"
            >
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

  </div>
</div>

<script>
  (function () {
    var section = document.getElementById('pgal-{{ section.id }}');
    if (!section) return;

    var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduced || !('IntersectionObserver' in window)) return;

    section.querySelectorAll('.pg__title, .pg__item').forEach(function (el, i) {
      el.style.setProperty('--pg-i', i);
    });

    section.classList.add('pg-anim');

    var observer = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          section.classList.add('is-visible');
          observer.unobserve(section);
          window.setTimeout(function () {
            section.classList.add('is-done');
          }, 2200);
        }
      });
    }, { threshold: 0.1 });

    observer.observe(section);
  })();
</script>

{%- elsif request.design_mode -%}
  <div class="page-width" style="padding: 24px 0; text-align: center; opacity: .6;">
    Produktgalleri: galleri-metafelterne er tomme for dette produkt.
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Custom Product Gallery",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "paragraph", "content": "Title aur images product ke metafields (custom.galleri_*) se aate hain." },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg_color", "label": "Section Background", "default": "#F5F1EA" },
    { "type": "color", "id": "border_color", "label": "Top Border Color", "default": "#DED2C3" },
    { "type": "color", "id": "title_color", "label": "Title Color", "default": "#302821" },

    { "type": "header", "content": "Layout" },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image Shape",
      "default": "4 / 3",
      "options": [
        { "value": "16 / 9", "label": "Wide (16:9)" },
        { "value": "3 / 2", "label": "Landscape (3:2)" },
        { "value": "4 / 3", "label": "Landscape (4:3)" },
        { "value": "1 / 1", "label": "Square (1:1)" }
      ]
    },
    { "type": "range", "id": "image_radius", "min": 0, "max": 32, "step": 2, "unit": "px", "label": "Image Corner Radius", "default": 12 },
    { "type": "checkbox", "id": "full_width", "label": "Full Width", "default": false },

    { "type": "header", "content": "Section Spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding Top", "default": 40 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding Bottom", "default": 40 }
  ],
  "presets": [
    { "name": "Custom Product Gallery" }
  ]
}
{% endschema %}