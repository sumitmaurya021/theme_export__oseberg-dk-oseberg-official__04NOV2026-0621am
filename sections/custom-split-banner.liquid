{%- liquid
  assign img = section.settings.image
-%}

{%- style -%}
  #sb-{{ section.id }} {
    --sb-bg: {{ section.settings.bg_color }};
    --sb-card: {{ section.settings.card_color }};
    --sb-title: {{ section.settings.title_color }};
    --sb-desc: {{ section.settings.desc_color }};
    --sb-overlay: {{ section.settings.overlay_color }};
    --sb-shade: {{ section.settings.shade_opacity }}%;
    --sb-radius: {{ section.settings.radius }}px;
    --sb-ratio: {{ section.settings.image_ratio }};
    background: var(--sb-bg);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    overflow: hidden;
  }

  /* Richtext resets (theme ke p rule ko override) */
  #sb-{{ section.id }} .sb__richtext p {
    margin: 0;
    font-size: inherit;
    font-weight: inherit;
    line-height: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    color: inherit;
    font-family: inherit;
  }

  #sb-{{ section.id }} .sb__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0;
    align-items: stretch;
    border-radius: var(--sb-radius);
    overflow: hidden;
  }

  /* ---------- Image ---------- */
  #sb-{{ section.id }} .sb__media {
    position: relative;
    min-width: 0;
    width: 100%;
    aspect-ratio: var(--sb-ratio);
    overflow: hidden;
    background: #4A5242;
  }

  #sb-{{ section.id }} .sb__media img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #sb-{{ section.id }} .sb__media::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(to top, rgba(0, 0, 0, calc(var(--sb-shade) / 100)) 0%, transparent 55%);
  }

  #sb-{{ section.id }} .sb__overlay {
    position: absolute;
    left: clamp(18px, 2.4vw, 32px);
    right: clamp(18px, 2.4vw, 32px);
    bottom: clamp(18px, 2.4vw, 30px);
    z-index: 2;
    color: var(--sb-overlay);
    font-family: var(--font-serif, 'Playfair Display', Georgia, 'Times New Roman', serif);
    font-size: clamp(22px, 2.2vw, 32px);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: 0.01em;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.35);
    overflow-wrap: break-word;
  }

  /* ---------- Content card ---------- */
  #sb-{{ section.id }} .sb__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
    padding: clamp(24px, 3vw, 48px);
    background: var(--sb-card);
  }

  #sb-{{ section.id }} .sb__title {
    margin: 0 0 12px;
    color: var(--sb-title);
    font-family: var(--font-serif, 'Playfair Display', Georgia, 'Times New Roman', serif);
    font-size: clamp(18px, 1.7vw, 24px);
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: 0.01em;
    text-wrap: balance;
    overflow-wrap: break-word;
  }

  #sb-{{ section.id }} .sb__desc {
    margin: 0;
    max-width: 460px;
    color: var(--sb-desc);
    font-family: var(--font-sans, 'Jost', 'Helvetica Neue', Arial, sans-serif);
    font-size: clamp(13px, 0.95vw, 14px);
    font-weight: 400;
    line-height: 1.6;
    letter-spacing: normal;
  }

  /* ---------- Tablet (750px - 989px) ---------- */
  @media screen and (min-width: 750px) and (max-width: 989px) {
    #sb-{{ section.id }} .sb__desc { max-width: 560px; }
  }

  /* ---------- Desktop (990px and up) ---------- */
  @media screen and (min-width: 990px) {
    #sb-{{ section.id }} .sb__grid {
      grid-template-columns: minmax(0, 11fr) minmax(0, 9fr);
    }

    #sb-{{ section.id }} .sb__media {
      aspect-ratio: auto;
      min-height: 200px;
    }
  }

  /* ---------- Mobile (749px and below) ---------- */
  @media screen and (max-width: 749px) {
    #sb-{{ section.id }} .sb__content { padding: 22px 18px; }
    #sb-{{ section.id }} .sb__title { font-size: 18px; margin-bottom: 10px; }
    #sb-{{ section.id }} .sb__desc { font-size: 13px; max-width: 100%; }
    #sb-{{ section.id }} .sb__overlay { font-size: 22px; }
  }

  /* ============================================
     ANIMATIONS (premium, subtle)
     JS chalega to hi hide hota hai, warna content hamesha visible rahega
     ============================================ */
  #sb-{{ section.id }} {
    --sb-media-x: -28px;
    --sb-content-x: 28px;
  }

  #sb-{{ section.id }}.sb-anim .sb__media {
    opacity: 0;
    transform: translateX(var(--sb-media-x));
    transition:
      opacity 1.1s cubic-bezier(0.22, 0.61, 0.36, 1),
      transform 1.1s cubic-bezier(0.22, 0.61, 0.36, 1);
    will-change: opacity, transform;
  }

  #sb-{{ section.id }}.sb-anim .sb__content > * {
    opacity: 0;
    transform: translateX(var(--sb-content-x));
    transition:
      opacity 1s cubic-bezier(0.22, 0.61, 0.36, 1),
      transform 1s cubic-bezier(0.22, 0.61, 0.36, 1);
    transition-delay: calc(0.25s + var(--sb-ci, 0) * 0.12s);
    will-change: opacity, transform;
  }

  #sb-{{ section.id }}.sb-anim.is-visible .sb__media,
  #sb-{{ section.id }}.sb-anim.is-visible .sb__content > * {
    opacity: 1;
    transform: translateX(0);
  }

  #sb-{{ section.id }}.sb-anim.is-done .sb__media,
  #sb-{{ section.id }}.sb-anim.is-done .sb__content > * {
    transition-delay: 0s;
    will-change: auto;
  }

  /* Mobile: side slide ki jagah halka fade-up */
  @media screen and (max-width: 749px) {
    #sb-{{ section.id }} {
      --sb-media-x: 0px;
      --sb-content-x: 0px;
    }
    #sb-{{ section.id }}.sb-anim .sb__media,
    #sb-{{ section.id }}.sb-anim .sb__content > * {
      transform: translateY(20px);
    }
    #sb-{{ section.id }}.sb-anim.is-visible .sb__media,
    #sb-{{ section.id }}.sb-anim.is-visible .sb__content > * {
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #sb-{{ section.id }}.sb-anim .sb__media,
    #sb-{{ section.id }}.sb-anim .sb__content > * {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
{%- endstyle -%}

<div id="sb-{{ section.id }}" class="custom-split-banner">
  <div class="{% unless section.settings.full_width %}page-width{% endunless %}">
    <div class="sb__grid">

      <div class="sb__media">
        {%- if img != blank -%}
          <img
            src="{{ img | image_url: width: 1200 }}"
            srcset="{{ img | image_url: width: 600 }} 600w,
                    {{ img | image_url: width: 900 }} 900w,
                    {{ img | image_url: width: 1200 }} 1200w,
                    {{ img | image_url: width: 1600 }} 1600w"
            sizes="(min-width: 990px) 55vw, 100vw"
            alt="{{ img.alt | default: section.settings.title | strip_html | escape }}"
            width="{{ img.width }}"
            height="{{ img.height }}"
            loading="lazy"
          >
        {%- endif -%}

        {%- if section.settings.overlay_text != blank -%}
          <div class="sb__overlay sb__richtext">{{ section.settings.overlay_text }}</div>
        {%- endif -%}
      </div>

      <div class="sb__content">
        {%- if section.settings.title != blank -%}
          <div class="sb__title sb__richtext" role="heading" aria-level="2">{{ section.settings.title }}</div>
        {%- endif -%}

        {%- if section.settings.description != blank -%}
          <div class="sb__desc sb__richtext">{{ section.settings.description }}</div>
        {%- endif -%}
      </div>

    </div>
  </div>
</div>

<script>
  (function () {
    var section = document.getElementById('sb-{{ section.id }}');
    if (!section) return;

    var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduced || !('IntersectionObserver' in window)) return;

    section.querySelectorAll('.sb__content > *').forEach(function (el, i) {
      el.style.setProperty('--sb-ci', i);
    });

    section.classList.add('sb-anim');

    var observer = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          section.classList.add('is-visible');
          observer.unobserve(section);
          window.setTimeout(function () {
            section.classList.add('is-done');
          }, 2200);
        }
      });
    }, { threshold: 0.15 });

    observer.observe(section);
  })();
</script>

{% schema %}
{
  "name": "Custom Split Banner",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "header", "content": "Image" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    {
      "type": "richtext",
      "id": "overlay_text",
      "label": "Text on Image",
      "info": "Khaali = hide.",
      "default": "<p>Samme sofa.<br>Nye muligheder.</p>"
    },
    { "type": "color", "id": "overlay_color", "label": "Text on Image Color", "default": "#FFFFFF" },
    { "type": "range", "id": "shade_opacity", "min": 0, "max": 80, "step": 5, "unit": "%", "label": "Image Bottom Shade", "default": 45 },

    { "type": "header", "content": "Content" },
    {
      "type": "richtext",
      "id": "title",
      "label": "Title",
      "default": "<p>Skab en ny stemning i dit hjem</p>"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Med Osebergs betræk kan du nemt skifte udtryk og tilpasse din sofa til din livsstil. Ni smukke farver, samme høje kvalitet og den velkendte komfort – nu med endnu flere muligheder.</p>"
    },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg_color", "label": "Section Background", "default": "#FAF6F0" },
    { "type": "color", "id": "card_color", "label": "Content Card Background", "default": "#F0E4DA" },
    { "type": "color", "id": "title_color", "label": "Title Color", "default": "#302821" },
    { "type": "color", "id": "desc_color", "label": "Description Color", "default": "#4A3F37" },

    { "type": "header", "content": "Layout" },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image Shape (Mobile / Tablet)",
      "default": "16 / 9",
      "options": [
        { "value": "21 / 9", "label": "Ultra wide (21:9)" },
        { "value": "16 / 9", "label": "Wide (16:9)" },
        { "value": "3 / 2", "label": "Landscape (3:2)" },
        { "value": "4 / 3", "label": "Landscape (4:3)" }
      ]
    },
    { "type": "range", "id": "radius", "min": 0, "max": 24, "step": 2, "unit": "px", "label": "Corner Radius", "default": 4 },
    { "type": "checkbox", "id": "full_width", "label": "Full Width", "default": false },

    { "type": "header", "content": "Section Spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding Top", "default": 32 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding Bottom", "default": 32 }
  ],
  "presets": [
    { "name": "Custom Split Banner" }
  ]
}
{% endschema %}