{"name":"t:sections.header.name","type":"header","sections":{"custom_marquee_section_zUwJ4k":{"type":"custom-marquee-section","blocks":{"scrolling_text_zAftPa":{"type":"ScrollingText","settings":{"text":"<p><strong>OSEBERG<\/strong><\/p>"}}},"block_order":["scrolling_text_zAftPa"],"settings":{"background_color":"#f5f1ea","color":"#302821"}},"custom_announcement_bar_BqYgdN":{"type":"custom-announcement-bar","blocks":{"block_UQWRdk":{"type":"block","settings":{"block_heading":"Bestem selv levering","block_text":"Hos Tisvilde Company bestemmer du selv, hvordan og hvornår dine møbler leveres – uanset om det er en seng, sofa eller andet. Vi samarbejder med fleksible fragtløsninger, så du får leveret på dine præmisser – nemt, sikkert og til tiden."}},"block_LhjdXK":{"type":"block","settings":{"block_heading":"Besøg showroom","block_text":"Kom forbi og oplev vores udvalg med egne øjne. I vores showroom kan du mærke materialerne, teste komforten og få personlig rådgivning – i rolige og inspirerende omgivelser. Book en tid eller kig forbi."}},"block_dyRRzY":{"type":"block","settings":{"block_heading":"Størst på sengegavle","block_text":"Vi er stolte af at have Danmarks største sortiment af sengegavle – fra klassiske til moderne designs i mange materialer og farver. Skab præcis det udtryk, der passer til dit soveværelse og din stil."}},"special_block_dGD9qt":{"type":"special_block","settings":{"fourth_block_heading":"Kontakt os","fourth_block_text_1":"<p>Kundeservice alle dage 08-23<\/p><p><strong>(+45) 71 99 99 97<\/strong><\/p>","fourth_block_text_2":"<p>24 timers e-mail support<\/p><p>kundeservice@tisvildecompany.dk<\/p>"}}},"block_order":["block_UQWRdk","block_LhjdXK","block_dyRRzY","special_block_dGD9qt"],"disabled":true,"settings":{"background_color":"#efe7dc","color":"#000000","left_text_1":"Bestem selv levering","left_text_2":"Besøg showroom","left_text_3":"Størst på sengegavle","middle_svg":"","middle_text":"","right_text_1":"Book en specialist","right_url_1":"shopif