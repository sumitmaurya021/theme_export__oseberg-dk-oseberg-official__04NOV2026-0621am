{%- liquid
  assign mf = product.metafields.custom
  assign pd_title = mf.detalje_titel.value
  assign pd_desc = mf.detalje_beskrivelse.value
  assign pd_image = mf.detalje_billede.value
  assign pd_card_images = mf.detalje_kort_billeder.value
  assign pd_card_titles = mf.detalje_kort_titler.value | strip | newline_to_br | split: '<br />'
  assign pd_card_descs = mf.detalje_kort_beskrivelser.value | strip | newline_to_br | split: '<br />'
  assign pd_card_count = pd_card_images.size | at_most: 3
-%}

{%- if pd_title != blank or pd_image != blank or pd_card_count > 0 -%}

{%- style -%}
  #pdetail-{{ section.id }} {
    --pd-title: {{ section.settings.title_color }};
    --pd-desc: {{ section.settings.desc_color }};
    --pd-card-title: {{ section.settings.card_title_color }};
    --pd-card-desc: {{ section.settings.card_desc_color }};
    --pd-radius: {{ section.settings.image_radius }}px;
    --pd-ratio: {{ section.settings.image_ratio }};
    --pd-card-ratio: {{ section.settings.card_ratio }};
    background: {{ section.settings.bg_color }};
    border-top: 1px solid {{ section.settings.border_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    overflow: hidden;
  }

  #pdetail-{{ section.id }} .pd__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 28px;
    align-items: center;
  }

  #pdetail-{{ section.id }} .pd__content { min-width: 0; }

  #pdetail-{{ section.id }} .pd__title {
    margin: 0 0 16px;
    color: var(--pd-title);
    font-family: var(--font-serif, 'Playfair Display', Georgia, 'Times New Roman', serif);
    font-size: clamp(28px, 3.2vw, 48px);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: 0.01em;
    text-wrap: balance;
    overflow-wrap: break-word;
  }

  #pdetail-{{ section.id }} .pd__desc {
    margin: 0;
    max-width: 440px;
    color: var(--pd-desc);
    font-family: var(--font-sans, 'Jost', 'Helvetica Neue', Arial, sans-serif);
    font-size: clamp(14px, 1.05vw, 16px);
    font-weight: 400;
    line-height: 1.6;
    letter-spacing: normal;
  }

  #pdetail-{{ section.id }} .pd__media {
    position: relative;
    min-width: 0;
    width: 100%;
    aspect-ratio: var(--pd-ratio);
    overflow: hidden;
    border-radius: var(--pd-radius);
    background: #DED2C3;
  }

  #pdetail-{{ section.id }} .pd__media img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s ease;
  }

  #pdetail-{{ section.id }} .pd__media:hover img { transform: scale(1.03); }

  /* ---------- Cards ---------- */
  #pdetail-{{ section.id }} .pd__cards {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 28px;
    margin-top: 40px;
  }

  #pdetail-{{ section.id }} .pd__card { min-width: 0; }

  #pdetail-{{ section.id }} .pd__card-media {
    position: relative;
    width: 100%;
    aspect-ratio: var(--pd-card-ratio);
    overflow: hidden;
    border-radius: var(--pd-radius);
    background: #DED2C3;
  }

  #pdetail-{{ section.id }} .pd__card-media img,
  #pdetail-{{ section.id }} .pd__card-media svg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s ease;
  }

  #pdetail-{{ section.id }} .pd__card:hover .pd__card-media img { transform: scale(1.04); }

  #pdetail-{{ section.id }} .pd__card-title {
    margin: 14px 0 4px;
    color: var(--pd-card-title);
    font-family: var(--font-serif, 'Playfair Display', Georgia, 'Times New Roman', serif);
    font-size: clamp(16px, 1.3vw, 18px);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: 0.01em;
    overflow-wrap: break-word;
  }

  #pdetail-{{ section.id }} .pd__card-desc {
    margin: 0;
    color: var(--pd-card-desc);
    font-family: var(--font-sans, 'Jost', 'Helvetica Neue', Arial, sans-serif);
    font-size: 12px;
    font-weight: 400;
    line-height: 1.5;
    letter-spacing: normal;
  }

  @media screen and (min-width: 750px) and (max-width: 989px) {
    #pdetail-{{ section.id }} .pd__grid { gap: 40px; }
    #pdetail-{{ section.id }} .pd__title { font-size: clamp(32px, 5vw, 44px); }
    #pdetail-{{ section.id }} .pd__desc { max-width: 560px; }
    #pdetail-{{ section.id }} .pd__cards {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 20px;
    }
  }

  @media screen and (min-width: 990px) {
    #pdetail-{{ section.id }} .pd__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: clamp(32px, 4vw, 64px);
    }
    {%- if section.settings.content_position == 'right' -%}
    #pdetail-{{ section.id }} .pd__content { order: 2; }
    #pdetail-{{ section.id }} .pd__media { order: 1; }
    {%- endif -%}
    #pdetail-{{ section.id }} .pd__cards {
      grid-template-columns: repeat({{ pd_card_count | at_least: 1 }}, minmax(0, 1fr));
      gap: clamp(16px, 2vw, 32px);
      margin-top: 48px;
    }
  }

  @media screen and (max-width: 749px) {
    #pdetail-{{ section.id }} .pd__grid { gap: 24px; }
    #pdetail-{{ section.id }} .pd__media { order: 1; }
    #pdetail-{{ section.id }} .pd__content { order: 2; }
    #pdetail-{{ section.id }} .pd__title { margin-bottom: 12px; }
    #pdetail-{{ section.id }} .pd__desc { max-width: 100%; }
    #pdetail-{{ section.id }} .pd__cards { gap: 24px; margin-top: 32px; }
  }

  /* ============================================
     ANIMATIONS (premium, subtle)
     JS chalega to hi hide hota hai, warna content hamesha visible rahega
     ============================================ */
  #pdetail-{{ section.id }} {
    {%- if section.settings.content_position == 'right' -%}
    --pd-content-x: 28px;
    --pd-media-x: -28px;
    {%- else -%}
    --pd-content-x: -28px;
    --pd-media-x: 28px;
    {%- endif %}
  }

  #pdetail-{{ section.id }}.pd-anim .pd__content > * {
    opacity: 0;
    transform: translateX(var(--pd-content-x));
    transition:
      opacity 1s cubic-bezier(0.22, 0.61, 0.36, 1),
      transform 1s cubic-bezier(0.22, 0.61, 0.36, 1);
    transition-delay: calc(var(--pd-ci, 0) * 0.12s);
    will-change: opacity, transform;
  }

  #pdetail-{{ section.id }}.pd-anim .pd__media {
    opacity: 0;
    transform: translateX(var(--pd-media-x));
    transition:
      opacity 1.1s cubic-bezier(0.22, 0.61, 0.36, 1),
      transform 1.1s cubic-bezier(0.22, 0.61, 0.36, 1);
    transition-delay: 0.25s;
    will-change: opacity, transform;
  }

  #pdetail-{{ section.id }}.pd-anim .pd__card {
    opacity: 0;
    transform: translateY(20px);
    transition:
      opacity 1s cubic-bezier(0.22, 0.61, 0.36, 1),
      transform 1s cubic-bezier(0.22, 0.61, 0.36, 1);
    transition-delay: calc(0.5s + var(--pd-i, 0) * 0.15s);
    will-change: opacity, transform;
  }

  #pdetail-{{ section.id }}.pd-anim.is-visible .pd__content > *,
  #pdetail-{{ section.id }}.pd-anim.is-visible .pd__media {
    opacity: 1;
    transform: translateX(0);
  }

  #pdetail-{{ section.id }}.pd-anim.is-visible .pd__card {
    opacity: 1;
    transform: translateY(0);
  }

  #pdetail-{{ section.id }}.pd-anim.is-done .pd__content > *,
  #pdetail-{{ section.id }}.pd-anim.is-done .pd__media,
  #pdetail-{{ section.id }}.pd-anim.is-done .pd__card { transition-delay: 0s; }

  @media screen and (max-width: 749px) {
    #pdetail-{{ section.id }} { --pd-content-x: 0px; --pd-media-x: 0px; }
    #pdetail-{{ section.id }}.pd-anim .pd__content > *,
    #pdetail-{{ section.id }}.pd-anim .pd__media { transform: translateY(20px); }
    #pdetail-{{ section.id }}.pd-anim.is-visible .pd__content > *,
    #pdetail-{{ section.id }}.pd-anim.is-visible .pd__media { transform: translateY(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    #pdetail-{{ section.id }}.pd-anim .pd__content > *,
    #pdetail-{{ section.id }}.pd-anim .pd__media,
    #pdetail-{{ section.id }}.pd-anim .pd__card {
      opacity: 1;
      transform: none;
      transition: none;
    }
    #pdetail-{{ section.id }} .pd__media img,
    #pdetail-{{ section.id }} .pd__card-media img { transition: none; }
  }
{%- endstyle -%}

<div id="pdetail-{{ section.id }}" class="custom-product-detail">
  <div class="{% unless section.settings.full_width %}page-width{% endunless %}">
    <div class="pd__grid">

      <div class="pd__content">
        {%- if pd_title != blank -%}
          <h2 class="pd__title">{{ pd_title | escape | newline_to_br }}</h2>
        {%- endif -%}
        {%- if pd_desc != blank -%}
          <p class="pd__desc">{{ pd_desc | escape | newline_to_br }}</p>
        {%- endif -%}
      </div>

      {%- if pd_image != blank -%}
        <div class="pd__media">
          <img
            src="{{ pd_image | image_url: width: 1200 }}"
            srcset="{{ pd_image | image_url: width: 600 }} 600w,
                    {{ pd_image | image_url: width: 900 }} 900w,
                    {{ pd_image | image_url: width: 1200 }} 1200w,
                    {{ pd_image | image_url: width: 1600 }} 1600w"
            sizes="(min-width: 990px) 50vw, 100vw"
            alt="{{ pd_image.alt | default: product.title | escape }}"
            width="{{ pd_image.width }}"
            height="{{ pd_image.height }}"
            loading="lazy"
          >
        </div>
      {%- endif -%}

    </div>

    {%- if pd_card_count > 0 -%}
      <div class="pd__cards">
        {%- for img in pd_card_images limit: 3 -%}
          {%- assign idx = forloop.index0 -%}
          {%- assign card_title = pd_card_titles[idx] | strip -%}
          {%- assign card_desc = pd_card_descs[idx] | strip -%}
          <div class="pd__card">
            <div class="pd__card-media">
              <img
                src="{{ img | image_url: width: 800 }}"
                srcset="{{ img | image_url: width: 400 }} 400w,
                        {{ img | image_url: width: 600 }} 600w,
                        {{ img | image_url: width: 800 }} 800w,
                        {{ img | image_url: width: 1000 }} 1000w"
                sizes="(min-width: 990px) 30vw, (min-width: 750px) 30vw, 100vw"
                alt="{{ img.alt | default: card_title | escape }}"
                width="{{ img.width }}"
                height="{{ img.height }}"
                loading="lazy"
              >
            </div>
            {%- if card_title != blank -%}
              <h3 class="pd__card-title">{{ card_title | escape }}</h3>
            {%- endif -%}
            {%- if card_desc != blank -%}
              <p class="pd__card-desc">{{ card_desc | escape }}</p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

<script>
  (function () {
    var section = document.getElementById('pdetail-{{ section.id }}');
    if (!section) return;

    var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduced || !('IntersectionObserver' in window)) return;

    section.querySelectorAll('.pd__content > *').forEach(function (el, i) {
      el.style.setProperty('--pd-ci', i);
    });
    section.querySelectorAll('.pd__card').forEach(function (el, i) {
      el.style.setProperty('--pd-i', i);
    });

    section.classList.add('pd-anim');

    var observer = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          section.classList.add('is-visible');
          observer.unobserve(section);
          window.setTimeout(function () {
            section.classList.add('is-done');
          }, 2400);
        }
      });
    }, { threshold: 0.1 });

    observer.observe(section);
  })();
</script>

{%- elsif request.design_mode -%}
  <div class="page-width" style="padding: 24px 0; text-align: center; opacity: .6;">
    Produktdetalje: detalje-metafelterne er tomme for dette produkt.
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Custom Product Detail",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "paragraph", "content": "Text, image aur cards product ke metafields (custom.detalje_*) se aate hain." },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg_color", "label": "Section Background", "default": "#F5F1EA" },
    { "type": "color", "id": "border_color", "label": "Top Border Color", "default": "#DED2C3" },
    { "type": "color", "id": "title_color", "label": "Title Color", "default": "#302821" },
    { "type": "color", "id": "desc_color", "label": "Description Color", "default": "#302821" },
    { "type": "color", "id": "card_title_color", "label": "Card Title Color", "default": "#302821" },
    { "type": "color", "id": "card_desc_color", "label": "Card Description Color", "default": "#A58C76" },

    { "type": "header", "content": "Layout" },
    {
      "type": "select",
      "id": "content_position",
      "label": "Content Position (Desktop)",
      "default": "left",
      "options": [
        { "value": "left", "label": "Content Left, Image Right" },
        { "value": "right", "label": "Content Right, Image Left" }
      ]
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Main Image Shape",
      "default": "4 / 3",
      "options": [
        { "value": "16 / 9", "label": "Wide (16:9)" },
        { "value": "3 / 2", "label": "Landscape (3:2)" },
        { "value": "4 / 3", "label": "Landscape (4:3)" },
        { "value": "1 / 1", "label": "Square (1:1)" }
      ]
    },
    {
      "type": "select",
      "id": "card_ratio",
      "label": "Card Image Shape",
      "default": "4 / 3",
      "options": [
        { "value": "16 / 9", "label": "Wide (16:9)" },
        { "value": "3 / 2", "label": "Landscape (3:2)" },
        { "value": "4 / 3", "label": "Landscape (4:3)" },
        { "value": "1 / 1", "label": "Square (1:1)" }
      ]
    },
    { "type": "range", "id": "image_radius", "min": 0, "max": 32, "step": 2, "unit": "px", "label": "Image Corner Radius", "default": 16 },
    { "type": "checkbox", "id": "full_width", "label": "Full Width", "default": false },

    { "type": "header", "content": "Section Spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding Top", "default": 48 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding Bottom", "default": 48 }
  ],
  "presets": [
    { "name": "Custom Product Detail" }
  ]
}
{% endschema %}