{%- liquid
  assign mf = product.metafields.custom
  assign sc_title = mf.fremvisning_titel.value
  assign sc_desc = mf.fremvisning_beskrivelse.value
  assign sc_images = mf.fremvisning_billeder.value
  assign img_count = sc_images.size
  assign grid_cols = img_count | at_most: 2 | at_least: 1
-%}

{%- if sc_title != blank or img_count > 0 -%}

{%- style -%}
  #pshow-{{ section.id }} {
    --ps-title: {{ section.settings.title_color }};
    --ps-desc: {{ section.settings.desc_color }};
    --ps-radius: {{ section.settings.image_radius }}px;
    --ps-ratio: {{ section.settings.image_ratio }};
    background: {{ section.settings.bg_color }};
    border-top: 1px solid {{ section.settings.border_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    overflow: hidden;
  }

  #pshow-{{ section.id }} .ps__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 32px;
    align-items: center;
  }

  /* ---------- Content ---------- */
  #pshow-{{ section.id }} .ps__content { min-width: 0; }

  #pshow-{{ section.id }} .ps__title {
    margin: 0 0 24px;
    color: var(--ps-title);
    font-family: var(--font-serif, 'Playfair Display', Georgia, 'Times New Roman', serif);
    font-size: clamp(28px, 3.2vw, 48px);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: 0.01em;
    text-wrap: balance;
    overflow-wrap: break-word;
  }

  #pshow-{{ section.id }} .ps__desc {
    margin: 0;
    max-width: 440px;
    color: var(--ps-desc);
    font-family: var(--font-sans, 'Jost', 'Helvetica Neue', Arial, sans-serif);
    font-size: clamp(14px, 1.05vw, 16px);
    font-weight: 400;
    line-height: 1.6;
    letter-spacing: normal;
  }

  /* ---------- Images ---------- */
  #pshow-{{ section.id }} .ps__cards {
    display: grid;
    grid-template-columns: repeat({{ grid_cols }}, minmax(0, 1fr));
    gap: clamp(12px, 1.6vw, 20px);
    min-width: 0;
  }

  #pshow-{{ section.id }} .ps__card {
    min-width: 0;
  }

  #pshow-{{ section.id }} .ps__media {
    position: relative;
    width: 100%;
    aspect-ratio: var(--ps-ratio);
    overflow: hidden;
    border-radius: var(--ps-radius);
    background: #DED2C3;
  }

  #pshow-{{ section.id }} .ps__media img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s ease;
  }

  #pshow-{{ section.id }} .ps__card:hover .ps__media img {
    transform: scale(1.04);
  }

  /* ---------- Tablet (750px - 989px) ---------- */
  @media screen and (min-width: 750px) and (max-width: 989px) {
    #pshow-{{ section.id }} .ps__grid { gap: 40px; }
    #pshow-{{ section.id }} .ps__desc { max-width: 560px; }
    #pshow-{{ section.id }} .ps__title { font-size: clamp(32px, 5vw, 44px); }
  }

  /* ---------- Desktop (990px and up) : 50% / 50% ---------- */
  @media screen and (min-width: 990px) {
    #pshow-{{ section.id }} .ps__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: clamp(32px, 4vw, 64px);
    }

    {%- if section.settings.content_position == 'right' -%}
    #pshow-{{ section.id }} .ps__content { order: 2; }
    #pshow-{{ section.id }} .ps__cards { order: 1; }
    {%- endif -%}
  }

  /* ---------- Mobile (749px and below) ---------- */
  @media screen and (max-width: 749px) {
    #pshow-{{ section.id }} .ps__grid { gap: 28px; }
    #pshow-{{ section.id }} .ps__title { margin-bottom: 18px; }
    #pshow-{{ section.id }} .ps__desc { max-width: 100%; }

    #pshow-{{ section.id }} .ps__cards {
      grid-template-columns: repeat({% if img_count == 1 %}1{% else %}{{ section.settings.columns_mobile }}{% endif %}, minmax(0, 1fr));
      gap: 12px;
    }
  }

  /* ============================================
     ANIMATIONS (premium, subtle)
     JS chalega to hi hide hota hai, warna content hamesha visible rahega
     ============================================ */
  #pshow-{{ section.id }} {
    {%- if section.settings.content_position == 'right' -%}
    --ps-content-x: 28px;
    --ps-cards-x: -28px;
    {%- else -%}
    --ps-content-x: -28px;
    --ps-cards-x: 28px;
    {%- endif %}
  }

  #pshow-{{ section.id }}.ps-anim .ps__content > * {
    opacity: 0;
    transform: translateX(var(--ps-content-x));
    transition:
      opacity 1s cubic-bezier(0.22, 0.61, 0.36, 1),
      transform 1s cubic-bezier(0.22, 0.61, 0.36, 1);
    transition-delay: calc(var(--ps-ci, 0) * 0.12s), calc(var(--ps-ci, 0) * 0.12s);
    will-change: opacity, transform;
  }

  #pshow-{{ section.id }}.ps-anim .ps__card {
    opacity: 0;
    transform: translateX(var(--ps-cards-x));
    transition:
      opacity 1.1s cubic-bezier(0.22, 0.61, 0.36, 1),
      transform 1.1s cubic-bezier(0.22, 0.61, 0.36, 1);
    transition-delay: calc(0.25s + var(--ps-i, 0) * 0.2s);
    will-change: opacity, transform;
  }

  #pshow-{{ section.id }}.ps-anim.is-visible .ps__content > *,
  #pshow-{{ section.id }}.ps-anim.is-visible .ps__card {
    opacity: 1;
    transform: translateX(0);
  }

  #pshow-{{ section.id }}.ps-anim.is-done .ps__content > *,
  #pshow-{{ section.id }}.ps-anim.is-done .ps__card {
    transition-delay: 0s;
  }

  /* Mobile: side slide ki jagah halka fade-up */
  @media screen and (max-width: 749px) {
    #pshow-{{ section.id }} {
      --ps-content-x: 0px;
      --ps-cards-x: 0px;
    }
    #pshow-{{ section.id }}.ps-anim .ps__content > *,
    #pshow-{{ section.id }}.ps-anim .ps__card {
      transform: translateY(20px);
    }
    #pshow-{{ section.id }}.ps-anim.is-visible .ps__content > *,
    #pshow-{{ section.id }}.ps-anim.is-visible .ps__card {
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #pshow-{{ section.id }}.ps-anim .ps__content > *,
    #pshow-{{ section.id }}.ps-anim .ps__card {
      opacity: 1;
      transform: none;
      transition: none;
    }
    #pshow-{{ section.id }} .ps__media img { transition: none; }
  }
{%- endstyle -%}

<div id="pshow-{{ section.id }}" class="custom-product-showcase">
  <div class="{% unless section.settings.full_width %}page-width{% endunless %}">
    <div class="ps__grid">

      <div class="ps__content">
        {%- if sc_title != blank -%}
          <h2 class="ps__title">{{ sc_title | escape | newline_to_br }}</h2>
        {%- endif -%}

        {%- if sc_desc != blank -%}
          <p class="ps__desc">{{ sc_desc | escape | newline_to_br }}</p>
        {%- endif -%}
      </div>

      {%- if img_count > 0 -%}
        <div class="ps__cards">
          {%- for img in sc_images limit: 4 -%}
            <div class="ps__card">
              <div class="ps__media">
                <img
                  src="{{ img | image_url: width: 1000 }}"
                  srcset="{{ img | image_url: width: 400 }} 400w,
                          {{ img | image_url: width: 600 }} 600w,
                          {{ img | image_url: width: 800 }} 800w,
                          {{ img | image_url: width: 1000 }} 1000w"
                  sizes="(min-width: 990px) 36vw, (min-width: 750px) 45vw, 50vw"
                  alt="{{ img.alt | default: product.title | escape }}"
                  width="{{ img.width }}"
                  height="{{ img.height }}"
                  loading="lazy"
                >
              </div>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}

    </div>
  </div>
</div>

<script>
  (function () {
    var section = document.getElementById('pshow-{{ section.id }}');
    if (!section) return;

    var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduced || !('IntersectionObserver' in window)) return;

    section.querySelectorAll('.ps__content > *').forEach(function (el, i) {
      el.style.setProperty('--ps-ci', i);
    });
    section.querySelectorAll('.ps__card').forEach(function (el, i) {
      el.style.setProperty('--ps-i', i);
    });

    section.classList.add('ps-anim');

    var observer = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          section.classList.add('is-visible');
          observer.unobserve(section);
          window.setTimeout(function () {
            section.classList.add('is-done');
          }, 2200);
        }
      });
    }, { threshold: 0.15 });

    observer.observe(section);
  })();
</script>

{%- elsif request.design_mode -%}
  <div class="page-width" style="padding: 24px 0; text-align: center; opacity: .6;">
    Custom Product Showcase: is product ke showcase metafields khaali hain.
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Custom Product Showcase",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "paragraph", "content": "Text aur images product ke metafields (custom.fremvisning_*) se aate hain." },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg_color", "label": "Section Background", "default": "#F5F1EA" },
    { "type": "color", "id": "border_color", "label": "Top Border Color", "default": "#A58C76" },
    { "type": "color", "id": "title_color", "label": "Title Color", "default": "#302821" },
    { "type": "color", "id": "desc_color", "label": "Description Color", "default": "#302821" },

    { "type": "header", "content": "Layout" },
    {
      "type": "select",
      "id": "content_position",
      "label": "Content Position (Desktop)",
      "default": "left",
      "options": [
        { "value": "left", "label": "Content Left, Images Right" },
        { "value": "right", "label": "Content Right, Images Left" }
      ]
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image Shape",
      "default": "4 / 3",
      "options": [
        { "value": "16 / 9", "label": "Wide (16:9)" },
        { "value": "4 / 3", "label": "Landscape (4:3)" },
        { "value": "5 / 4", "label": "Landscape (5:4)" },
        { "value": "1 / 1", "label": "Square (1:1)" },
        { "value": "4 / 5", "label": "Portrait (4:5)" }
      ]
    },
    { "type": "range", "id": "image_radius", "min": 0, "max": 24, "step": 2, "unit": "px", "label": "Image Corner Radius", "default": 0 },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Image Columns (Mobile)",
      "default": "2",
      "options": [
        { "value": "1", "label": "1 (stacked)" },
        { "value": "2", "label": "2 (side by side)" }
      ]
    },
    { "type": "checkbox", "id": "full_width", "label": "Full Width", "default": false },

    { "type": "header", "content": "Section Spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding Top", "default": 48 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding Bottom", "default": 48 }
  ],
  "presets": [
    { "name": "Custom Product Showcase" }
  ]
}
{% endschema %}