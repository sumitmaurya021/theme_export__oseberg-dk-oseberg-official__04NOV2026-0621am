{%- liquid
  assign stat_blocks = section.blocks | where: 'type', 'stat'
  assign tile_blocks = section.blocks | where: 'type', 'tile'
  assign stat_cols = stat_blocks.size | at_least: 1 | at_most: 4
-%}

{%- style -%}
  #sc-{{ section.id }} {
    --sc-pad: clamp(20px, 5vw, 80px);
    --sc-eyebrow: {{ section.settings.eyebrow_color }};
    --sc-title: {{ section.settings.title_color }};
    --sc-desc: {{ section.settings.desc_color }};
    --sc-num: {{ section.settings.number_color }};
    --sc-label: {{ section.settings.label_color }};
    --sc-btn-bg: {{ section.settings.button_bg }};
    --sc-btn-color: {{ section.settings.button_color }};
    --sc-btn-hover-bg: {{ section.settings.button_hover_bg }};
    --sc-btn-hover-color: {{ section.settings.button_hover_color }};
    --sc-icon: {{ section.settings.icon_size | times: 1.4 }}px;
    --sc-icon-m: {{ section.settings.icon_size_mobile | times: 1.4 }}px;
    --sc-ratio: {{ section.settings.tile_ratio }};
    --sc-gap: clamp(8px, 1vw, 14px);
    --sc-n: 2.2;
    position: relative;
    background: {{ section.settings.bg_color }};
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    overflow: hidden;
    isolation: isolate;
  }

  /* ---------- Background image + overlay ---------- */
  #sc-{{ section.id }} .sc__bg {
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  #sc-{{ section.id }} .sc__bg img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #sc-{{ section.id }} .sc__overlay {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: {{ section.settings.bg_color }};
    opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
  }

  #sc-{{ section.id }} .sc__inner {
    padding-left: 40px;
    padding-right: 40px;
  }

  #sc-{{ section.id }} .sc__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 36px;
    align-items: center;
  }

  /* ---------- Left content ---------- */
  #sc-{{ section.id }} .sc__content {
    min-width: 0;
  }

  #sc-{{ section.id }} .sc__eyebrow {
    margin: 0 0 14px;
    color: var(--sc-eyebrow);
    font-family: var(--font-sans, 'Jost', 'Helvetica Neue', Arial, sans-serif);
    font-size: 12px;
    font-weight: 400;
    line-height: 1.4;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  #sc-{{ section.id }} .sc__title {
    margin: 0 0 20px;
    color: var(--sc-title);
    font-family: var(--font-serif, 'Playfair Display', Georgia, 'Times New Roman', serif);
    font-size: clamp(40px, 9.5vw, 56px);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    overflow-wrap: break-word;
  }

  #sc-{{ section.id }} .sc__desc {
    margin: 0 0 28px;
    max-width: 380px;
    color: var(--sc-desc);
    font-family: var(--font-sans, 'Jost', 'Helvetica Neue', Arial, sans-serif);
    font-size: clamp(14px, 1.05vw, 16px);
    font-weight: 400;
    line-height: 1.6;
  }

  #sc-{{ section.id }} .sc__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    max-width: 100%;
    padding: clamp(13px, 1.1vw, 17px) clamp(22px, 2.2vw, 34px);
    background: var(--sc-btn-bg);
    color: var(--sc-btn-color);
    font-family: var(--font-sans, 'Jost', 'Helvetica Neue', Arial, sans-serif);
    font-size: 12px;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: 0.15em;
    text-align: center;
    text-transform: uppercase;
    text-decoration: none;
    border: 1px solid var(--sc-btn-bg);
    border-radius: 0;
    transition: background 0.4s ease, color 0.4s ease, border-color 0.4s ease;
  }

  #sc-{{ section.id }} .sc__button::before,
  #sc-{{ section.id }} .sc__button::after {
    content: none !important;
    display: none !important;
  }

  #sc-{{ section.id }} .sc__button:hover {
    background: var(--sc-btn-hover-bg);
    color: var(--sc-btn-hover-color);
    border-color: var(--sc-btn-hover-bg);
  }

  /* ---------- Right side ---------- */
  #sc-{{ section.id }} .sc__right {
    min-width: 0;
  }

  /* Stats */
  #sc-{{ section.id }} .sc__stats {
    display: grid;
    grid-template-columns: repeat({{ stat_cols }}, minmax(0, 1fr));
    gap: 12px;
    margin-bottom: 18px;
  }

  #sc-{{ section.id }} .sc__stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    text-align: center;
    min-width: 0;
  }

  #sc-{{ section.id }} .sc__stat-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    margin: 0 0 2px;
    line-height: 0;
  }

  #sc-{{ section.id }} .sc__stat-icon img {
    display: block;
    width: var(--sc-icon-m);
    height: var(--sc-icon-m);
    margin: 0 auto;
    object-fit: contain;
    object-position: center;
    {% if section.settings.white_icons %}filter: brightness(0) invert(1);{% endif %}
  }

  #sc-{{ section.id }} .sc__stat-number {
    margin: 0 0 2px;
    color: var(--sc-num);
    font-family: var(--font-serif, 'Playfair Display', Georgia, 'Times New Roman', serif);
    font-size: clamp(24px, 6.4vw, 34px);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: 0.01em;
  }

  #sc-{{ section.id }} .sc__stat-label {
    margin: 0;
    color: var(--sc-label);
    font-family: var(--font-sans, 'Jost', 'Helvetica Neue', Arial, sans-serif);
    font-size: 10px;
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  /* ---------- Image strip (Slick slider, drag to scroll, no scrollbar) ---------- */
  #sc-{{ section.id }} .sc__strip {
    display: block;
    margin-right: calc(var(--sc-pad) * -1);
    padding: 0;
    overflow: hidden;
    cursor: grab;
    user-select: none;
    -webkit-user-select: none;
  }

  #sc-{{ section.id }} .sc__strip:active {
    cursor: grabbing;
  }

  /* Before slick loads: keep tiles in a row without scrollbar */
  #sc-{{ section.id }} .sc__strip:not(.slick-initialized) {
    display: flex;
    gap: var(--sc-gap);
    overflow: hidden;
  }

  #sc-{{ section.id }} .sc__strip .slick-list {
    overflow: hidden;
  }

  #sc-{{ section.id }} .sc__strip .slick-track {
    display: block;
  }

  #sc-{{ section.id }} .sc__strip .slick-slide {
    outline: none;
  }

  #sc-{{ section.id }} .sc__tile {
    position: relative;
    display: block;
    flex: 0 0 var(--sc-w, calc((100% - var(--sc-gap) * (var(--sc-n) - 1)) / var(--sc-n)));
    width: var(--sc-w, auto);
    margin-right: var(--sc-gap);
    min-width: 0;
    aspect-ratio: var(--sc-ratio);
    overflow: hidden;
    background: #DED2C3;
    text-decoration: none;
    outline: none;
  }

  #sc-{{ section.id }} .sc__tile img,
  #sc-{{ section.id }} .sc__tile svg.placeholder-svg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    -webkit-user-drag: none;
    user-select: none;
    pointer-events: none;
  }

  #sc-{{ section.id }} .sc__tile img {
    transition: transform 0.6s ease;
  }

  #sc-{{ section.id }} a.sc__tile:hover img {
    transform: scale(1.05);
  }

  /* Tile arrow button: bottom-left of every image */
  #sc-{{ section.id }} .sc__tile-icon {
    position: absolute;
    left: 10px;
    bottom: 10px;
    width: 26px;
    height: 26px;
    color: #FFFFFF;
    opacity: 0.85;
    pointer-events: none;
    z-index: 2;
    filter: drop-shadow(0 0 3px rgba(0, 0, 0, 0.35));
  }

  /* ---------- Tablet (750px - 989px) ---------- */
  @media screen and (min-width: 750px) and (max-width: 989px) {
    #sc-{{ section.id }} {
      --sc-n: 3.4;
    }

    #sc-{{ section.id }} .sc__grid {
      gap: 44px;
    }

    #sc-{{ section.id }} .sc__title {
      font-size: clamp(52px, 7.4vw, 66px);
    }

    #sc-{{ section.id }} .sc__desc {
      max-width: 460px;
    }

    #sc-{{ section.id }} .sc__stats {
      margin-bottom: 24px;
    }

    #sc-{{ section.id }} .sc__stat-icon img {
      width: var(--sc-icon);
      height: var(--sc-icon);
    }

    #sc-{{ section.id }} .sc__stat-number {
      font-size: clamp(30px, 4.6vw, 38px);
    }

    #sc-{{ section.id }} .sc__stat-label {
      font-size: 11px;
    }
  }

  /* ---------- Desktop (990px and up) ---------- */
  @media screen and (min-width: 990px) {
    #sc-{{ section.id }} {
      --sc-n: 4.3;
    }

    #sc-{{ section.id }} .sc__grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: clamp(32px, 4vw, 72px);
    }

    #sc-{{ section.id }} .sc__title {
      font-size: clamp(48px, 5.2vw, 80px);
    }

    #sc-{{ section.id }} .sc__stats {
      margin-bottom: clamp(16px, 2vw, 26px);
    }

    #sc-{{ section.id }} .sc__stat-icon img {
      width: var(--sc-icon);
      height: var(--sc-icon);
    }

    #sc-{{ section.id }} .sc__stat-number {
      font-size: clamp(30px, 3vw, 46px);
    }

    #sc-{{ section.id }} .sc__stat-label {
      font-size: 11px;
    }
  }

  /* ---------- Mobile (749px and below) ---------- */
  @media screen and (max-width: 749px) {
    #sc-{{ section.id }} .sc__desc {
      max-width: 100%;
    }
  }

  /* Very small phones: button full width */
  @media screen and (max-width: 479px) {
    #sc-{{ section.id }} .sc__button {
      width: 100%;
    }
  }

  /* ============================================
     ANIMATIONS (premium, subtle)
     JS chalega to hi hide hota hai, warna content hamesha visible rahega
     ============================================ */

  /* Heading block (eyebrow, title, desc, button) + stats + image strip: fade-up, stagger */
  #sc-{{ section.id }}.sc-anim .sc__content > *,
  #sc-{{ section.id }}.sc-anim .sc__stat,
  #sc-{{ section.id }}.sc-anim .sc__strip {
    opacity: 0;
    transform: translateY(20px);
    transition:
      opacity 1s cubic-bezier(0.22, 0.61, 0.36, 1),
      transform 1s cubic-bezier(0.22, 0.61, 0.36, 1),
      background 0.4s ease, color 0.4s ease, border-color 0.4s ease;
    transition-delay: calc(var(--sc-i, 0) * 0.12s), calc(var(--sc-i, 0) * 0.12s), 0s, 0s, 0s;
    will-change: opacity, transform;
  }

  #sc-{{ section.id }}.sc-anim.is-visible .sc__content > *,
  #sc-{{ section.id }}.sc-anim.is-visible .sc__stat,
  #sc-{{ section.id }}.sc-anim.is-visible .sc__strip {
    opacity: 1;
    transform: translateY(0);
  }

  /* Animation ke baad delay hata do, taaki hover turant chale
     (will-change bhi hata di, taaki slider ke andar rendering heavy na rahe) */
  #sc-{{ section.id }}.sc-anim.is-done .sc__content > *,
  #sc-{{ section.id }}.sc-anim.is-done .sc__stat,
  #sc-{{ section.id }}.sc-anim.is-done .sc__strip {
    transition-delay: 0s;
    will-change: auto;
  }

  /* Reduced motion: sab animation off */
  @media (prefers-reduced-motion: reduce) {
    #sc-{{ section.id }}.sc-anim .sc__content > *,
    #sc-{{ section.id }}.sc-anim .sc__stat,
    #sc-{{ section.id }}.sc-anim .sc__strip {
      opacity: 1;
      transform: none;
      transition: none;
    }

    #sc-{{ section.id }} .sc__tile img {
      transition: none;
    }
  }
{%- endstyle -%}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/slick-carousel/1.8.1/slick.min.css">

<div id="sc-{{ section.id }}" class="custom-social-proof">

  {%- if section.settings.bg_image != blank -%}
    <div class="sc__bg">
      <img
        src="{{ section.settings.bg_image | image_url: width: 1600 }}"
        srcset="{{ section.settings.bg_image | image_url: width: 800 }} 800w,
                {{ section.settings.bg_image | image_url: width: 1200 }} 1200w,
                {{ section.settings.bg_image | image_url: width: 1600 }} 1600w,
                {{ section.settings.bg_image | image_url: width: 2400 }} 2400w"
        sizes="100vw"
        alt=""
        loading="lazy"
      >
    </div>
  {%- endif -%}
  <div class="sc__overlay"></div>

  <div class="sc__inner">
    <div class="sc__grid">

      <div class="sc__content">
        {%- if section.settings.eyebrow != blank -%}
          <p class="sc__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}

        {%- if section.settings.title != blank -%}
          <h2 class="sc__title">{{ section.settings.title | escape | newline_to_br }}</h2>
        {%- endif -%}

        {%- if section.settings.description != blank -%}
          <p class="sc__desc">{{ section.settings.description | escape | newline_to_br }}</p>
        {%- endif -%}

        {%- if section.settings.button_text != blank and section.settings.button_link != blank -%}
          <a href="{{ section.settings.button_link }}" class="sc__button">{{ section.settings.button_text }}</a>
        {%- endif -%}
      </div>

      <div class="sc__right">

        {%- if stat_blocks.size > 0 -%}
          <div class="sc__stats">
            {%- for block in stat_blocks -%}
              <div class="sc__stat" {{ block.shopify_attributes }}>
                {%- if block.settings.icon != blank -%}
                  <div class="sc__stat-icon">
                    <img
                      src="{{ block.settings.icon | image_url: width: 160 }}"
                      alt=""
                      width="{{ section.settings.icon_size }}"
                      height="{{ section.settings.icon_size }}"
                      loading="lazy"
                    >
                  </div>
                {%- endif -%}

                {%- if block.settings.number != blank -%}
                  <p class="sc__stat-number">{{ block.settings.number }}</p>
                {%- endif -%}

                {%- if block.settings.label != blank -%}
                  <p class="sc__stat-label">{{ block.settings.label }}</p>
                {%- endif -%}
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- if tile_blocks.size > 0 -%}
          <div class="sc__strip">
            {%- for block in tile_blocks -%}
              {%- liquid
                if block.settings.link != blank
                  assign tag = 'a'
                else
                  assign tag = 'div'
                endif
              -%}
              <{{ tag }}{% if tag == 'a' %} href="{{ block.settings.link }}" draggable="false"{% endif %} class="sc__tile" {{ block.shopify_attributes }}>
                {%- if block.settings.image != blank -%}
                  <img
                    src="{{ block.settings.image | image_url: width: 600 }}"
                    srcset="{{ block.settings.image | image_url: width: 300 }} 300w,
                            {{ block.settings.image | image_url: width: 450 }} 450w,
                            {{ block.settings.image | image_url: width: 600 }} 600w,
                            {{ block.settings.image | image_url: width: 800 }} 800w"
                    sizes="(min-width: 990px) 18vw, (min-width: 750px) 28vw, 42vw"
                    alt="{{ block.settings.image.alt | default: block.settings.alt_text | escape }}"
                    width="{{ block.settings.image.width }}"
                    height="{{ block.settings.image.height }}"
                    loading="lazy"
                    draggable="false"
                  >
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}

                {%- if tag == 'a' -%}
                  <svg class="sc__tile-icon" viewBox="0 0 26 26" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="13" cy="13" r="12"/>
                    <path d="M9 17L17 9M11 9H17V15"/>
                  </svg>
                {%- endif -%}
              </{{ tag }}>
            {%- endfor -%}
          </div>
        {%- endif -%}

      </div>
    </div>
  </div>
</div>

<script>
  (function () {
    var sectionId = 'sc-{{ section.id }}';

    function loadScript(src) {
      return new Promise(function (resolve, reject) {
        var s = document.createElement('script');
        s.src = src;
        s.async = false;
        s.onload = resolve;
        s.onerror = reject;
        document.head.appendChild(s);
      });
    }

    function ensureSlick() {
      if (window.__scSlickPromise) return window.__scSlickPromise;
      window.__scSlickPromise = new Promise(function (resolve, reject) {
        var chain = Promise.resolve();
        if (!window.jQuery) {
          chain = chain.then(function () {
            return loadScript('https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js');
          });
        }
        chain = chain.then(function () {
          if (!window.jQuery.fn.slick) {
            return loadScript('https://cdnjs.cloudflare.com/ajax/libs/slick-carousel/1.8.1/slick.min.js');
          }
        });
        chain.then(resolve).catch(reject);
      });
      return window.__scSlickPromise;
    }

    function init() {
      var root = document.getElementById(sectionId);
      if (!root) return;
      var strip = root.querySelector('.sc__strip');
      var right = root.querySelector('.sc__right');
      if (!strip || !right) return;

      var $ = window.jQuery;
      var $strip = $(strip);
      var tileCount = strip.querySelectorAll('.sc__tile').length;
      var maxIndex = 0;

      function getGap() {
        var cs = getComputedStyle(root);
        var tmp = document.createElement('div');
        tmp.style.cssText = 'position:absolute;visibility:hidden;width:' + cs.getPropertyValue('--sc-gap').trim();
        root.appendChild(tmp);
        var gap = tmp.getBoundingClientRect().width || 12;
        root.removeChild(tmp);
        return gap;
      }

      function setTileWidth() {
        var cs = getComputedStyle(root);
        var n = parseFloat(cs.getPropertyValue('--sc-n')) || 4;
        var gap = getGap();
        var fullTiles = Math.floor(n + 0.001);
        var isWhole = Math.abs(n - fullTiles) < 0.001;
        /* whole number: (n - 1) gaps between n tiles.
           fractional (desktop 4.3, mobile 2.2): n gaps, then the partial next tile */
        var gapsVisible = isWhole ? fullTiles - 1 : fullTiles;
        var stripW = strip.clientWidth || right.clientWidth;
        var w = (stripW - gap * gapsVisible) / n;
        root.style.setProperty('--sc-w', w + 'px');
        maxIndex = Math.max(0, tileCount - fullTiles);
      }

      setTileWidth();

      if (!$strip.hasClass('slick-initialized')) {
        $strip.on('beforeChange', function (e, slick, current, next) {
          /* never scroll past the point where the last full set of tiles is visible */
          if (next > maxIndex) {
            setTimeout(function () {
              $strip.slick('slickGoTo', maxIndex);
            }, 0);
          }
        });

        $strip.slick({
          variableWidth: true,
          infinite: false,
          arrows: false,
          dots: false,
          draggable: true,
          swipe: true,
          swipeToSlide: true,
          touchThreshold: 8,
          slidesToShow: 1,
          slidesToScroll: 1,
          speed: 400,
          cssEase: 'ease',
          waitForAnimate: false,
          accessibility: false
        });
      }

      var t;
      window.addEventListener('resize', function () {
        clearTimeout(t);
        t = setTimeout(function () {
          setTileWidth();
          $strip.slick('setPosition');
          if ($strip.slick('slickCurrentSlide') > maxIndex) {
            $strip.slick('slickGoTo', maxIndex, true);
          }
        }, 100);
      });
    }

    ensureSlick().then(init).catch(function (e) {
      console.warn('Slick failed to load', e);
    });
  })();
</script>

<!-- Scroll fade-in (stagger) + stats count-up -->
<script>
  (function () {
    var section = document.getElementById('sc-{{ section.id }}');
    if (!section) return;

    var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduced || !('IntersectionObserver' in window)) return;

    /* Stagger order: eyebrow, title, desc, button, phir stats, phir image strip */
    var order = [];
    section.querySelectorAll('.sc__content > *').forEach(function (el) { order.push(el); });
    section.querySelectorAll('.sc__stat').forEach(function (el) { order.push(el); });
    var strip = section.querySelector('.sc__strip');
    if (strip) order.push(strip);
    order.forEach(function (el, i) {
      el.style.setProperty('--sc-i', i);
    });

    /* Count-up: "5,000+" jaise text me se number nikal ke 1.5s me count karta hai.
       Final text hamesha original hi set hota hai, to format kabhi nahi bigadta */
    var counters = [];
    section.querySelectorAll('.sc__stat-number').forEach(function (el) {
      var original = el.textContent;
      var match = original.match(/(\d[\d,.\s]*)/);
      if (!match) return;
      var numStr = match[1].trim();
      var value = parseFloat(numStr.replace(/,/g, ''));
      if (isNaN(value) || value <= 0) return;
      counters.push({
        el: el,
        original: original,
        prefix: original.slice(0, original.indexOf(match[1])),
        suffix: original.slice(original.indexOf(match[1]) + match[1].length),
        value: value,
        hasComma: numStr.indexOf(',') !== -1
      });
    });

    function format(n, hasComma) {
      var rounded = Math.round(n);
      return hasComma ? rounded.toLocaleString('en-US') : String(rounded);
    }

    function runCounters() {
      var duration = 1500;
      var start = null;

      function step(ts) {
        if (start === null) start = ts;
        var p = Math.min((ts - start) / duration, 1);
        var eased = 1 - Math.pow(1 - p, 3); /* ease-out */
        counters.forEach(function (c) {
          c.el.textContent = c.prefix + format(c.value * eased, c.hasComma) + c.suffix;
        });
        if (p < 1) {
          window.requestAnimationFrame(step);
        } else {
          counters.forEach(function (c) { c.el.textContent = c.original; });
        }
      }

      window.requestAnimationFrame(step);
    }

    section.classList.add('sc-anim');

    var observer = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          section.classList.add('is-visible');
          observer.unobserve(section);

          /* stats dikhne ke baad count-up start */
          window.setTimeout(runCounters, 500);

          /* animation khatam hone ke baad delay hata do */
          window.setTimeout(function () {
            section.classList.add('is-done');
          }, 2400);
        }
      });
    }, { threshold: 0.15 });

    observer.observe(section);
  })();
</script>

