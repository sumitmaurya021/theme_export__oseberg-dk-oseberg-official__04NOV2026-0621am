{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="custom-image-duo custom-image-duo--{{ section.settings.background }}">
  <div class="custom-image-duo__inner page-width section-{{ section.id }}-padding">

    <div class="custom-image-duo__header">
      {%- if section.settings.caption != blank -%}
        <p class="custom-image-duo__caption">{{ section.settings.caption | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="custom-image-duo__heading">{{ section.settings.heading | escape | newline_to_br }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="custom-image-duo__text">{{ section.settings.text }}</div>
      {%- endif -%}
    </div>

    <div class="custom-image-duo__grid">
      {%- for block in section.blocks -%}
        <figure class="custom-image-duo__item" {{ block.shopify_attributes }}>
          <div class="custom-image-duo__media">
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 1200
                | image_tag: loading: 'lazy', widths: '360, 540, 750, 1000, 1200', sizes: '(min-width: 990px) 40vw, (min-width: 750px) 45vw, 100vw', alt: block.settings.image.alt
              }}
            {%- else -%}
              {{ 'detailed-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>
          {%- if block.settings.label != blank -%}
            <figcaption class="custom-image-duo__label">{{ block.settings.label | escape }}</figcaption>
          {%- endif -%}
        </figure>
      {%- endfor -%}
    </div>

  </div>
</div>

<style>
  .custom-image-duo {
    --oseberg-ivory: #F5F1EA;
    --oseberg-sand: #DED2C3;
    --oseberg-espresso: #302821;
    --oseberg-taupe: #A58C76;
    --oseberg-white: #FFFFFF;

    color: var(--oseberg-espresso);
    font-family: 'Jost', sans-serif;
  }

  .custom-image-duo--ivory {
    background: var(--oseberg-ivory);
  }

  .custom-image-duo--sand {
    background: var(--oseberg-sand);
  }

  .custom-image-duo__header {
    max-width: 56rem;
    margin: 0 auto;
    text-align: center;
  }

  .custom-image-duo__caption {
    margin: 0 0 1.6rem;
    font-family: 'Jost', sans-serif;
    font-weight: 400;
    font-size: 1.1rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--oseberg-taupe);
  }

  .custom-image-duo__heading {
    margin: 0 0 1.6rem;
    font-family: 'Playfair Display', serif;
    font-weight: 400;
    font-size: 2.6rem;
    line-height: 1.3;
    color: var(--oseberg-espresso);
  }

  .custom-image-duo__text,
  .custom-image-duo__text p {
    margin: 0;
    font-family: 'Jost', sans-serif;
    font-weight: 300;
    font-size: 1.4rem;
    line-height: 1.7;
    color: var(--oseberg-taupe);
  }

  .custom-image-duo__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3.2rem;
    margin-top: 4rem;
  }

  .custom-image-duo__item {
    margin: 0;
  }

  .custom-image-duo__media {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
    overflow: hidden;
  }

  .custom-image-duo__media img,
  .custom-image-duo__media svg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .custom-image-duo__label {
    margin-top: 1.2rem;
    font-family: 'Jost', sans-serif;
    font-weight: 400;
    font-size: 1.1rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--oseberg-taupe);
  }

  @media screen and (min-width: 750px) {
    .custom-image-duo__heading {
      font-size: 3.4rem;
    }

    .custom-image-duo__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 3.2rem;
      max-width: 90rem;
      margin: 5rem auto 0;
      align-items: start;
    }

    .custom-image-duo__item:nth-child(2) {
      margin-top: 6rem;
    }
  }

  @media screen and (min-width: 990px) {
    .custom-image-duo__heading {
      font-size: 4rem;
    }

    .custom-image-duo__grid {
      gap: 4.8rem;
    }

    .custom-image-duo__item:nth-child(2) {
      margin-top: 8rem;
    }
  }
</style>

{% schema %}
{
  "name": "Custom Image Duo",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "caption",
      "label": "Caption",
      "default": "Livet omkring møblerne"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Møbler er kulisse\nfor de små øjeblikke"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Hverdagen leves i de små øjeblikke. Et sted at lande, et sted at samles og et sted at finde ro.</p>"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "ivory", "label": "Ivory" },
        { "value": "sand", "label": "Sand" }
      ],
      "default": "ivory"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "limit": 2,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Stuen"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Image Duo",
      "blocks": [
        { "type": "image", "settings": { "label": "Stuen" } },
        { "type": "image", "settings": { "label": "Soveværelset" } }
      ]
    }
  ]
}
{% endschema %}