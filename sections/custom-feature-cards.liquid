{%- liquid
  assign card_count = section.blocks.size | at_least: 1 | at_most: 4
-%}

{%- style -%}
  #fc-{{ section.id }} {
    --fc-bg: {{ section.settings.bg_color }};
    --fc-card: {{ section.settings.card_color }};
    --fc-title: {{ section.settings.title_color }};
    --fc-desc: {{ section.settings.desc_color }};
    --fc-icon: {{ section.settings.icon_color }};
    --fc-icon-size: {{ section.settings.icon_size }}px;
    --fc-radius: {{ section.settings.card_radius }}px;
    background: var(--fc-bg);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    overflow: hidden;
  }

  /* Richtext resets (theme ke p rule ko override) */
  #fc-{{ section.id }} .fc__richtext p {
    margin: 0;
    font-size: inherit;
    font-weight: inherit;
    line-height: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    color: inherit;
    font-family: inherit;
  }

  #fc-{{ section.id }} .fc__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_mobile }}, minmax(0, 1fr));
    gap: 12px;
    align-items: stretch;
  }

  #fc-{{ section.id }} .fc__card {
    min-width: 0;
    padding: clamp(18px, 1.8vw, 26px);
    background: var(--fc-card);
    border-radius: var(--fc-radius);
  }

  #fc-{{ section.id }} .fc__head {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 12px;
  }

  #fc-{{ section.id }} .fc__icon {
    flex: 0 0 var(--fc-icon-size);
    width: var(--fc-icon-size);
    height: var(--fc-icon-size);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--fc-icon);
  }

  #fc-{{ section.id }} .fc__icon img,
  #fc-{{ section.id }} .fc__icon svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  #fc-{{ section.id }} .fc__title {
    min-width: 0;
    color: var(--fc-title);
    font-family: var(--font-serif, 'Playfair Display', Georgia, 'Times New Roman', serif);
    font-size: clamp(15px, 1.2vw, 18px);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: 0.01em;
    overflow-wrap: break-word;
  }

  #fc-{{ section.id }} .fc__desc {
    color: var(--fc-desc);
    font-family: var(--font-sans, 'Jost', 'Helvetica Neue', Arial, sans-serif);
    font-size: clamp(12px, 0.95vw, 14px);
    font-weight: 400;
    line-height: 1.6;
    letter-spacing: normal;
    overflow-wrap: break-word;
  }

  /* ---------- Tablet (750px - 989px) ---------- */
  @media screen and (min-width: 750px) and (max-width: 989px) {
    #fc-{{ section.id }} .fc__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
    }
  }

  /* ---------- Desktop (990px and up) ---------- */
  @media screen and (min-width: 990px) {
    #fc-{{ section.id }} .fc__grid {
      grid-template-columns: repeat({{ card_count }}, minmax(0, 1fr));
      gap: clamp(14px, 1.6vw, 22px);
    }
  }

  /* ---------- Mobile (749px and below) ---------- */
  @media screen and (max-width: 749px) {
    #fc-{{ section.id }} .fc__card { padding: 16px; }
    #fc-{{ section.id }} .fc__head { gap: 10px; margin-bottom: 8px; }
    #fc-{{ section.id }} .fc__title { font-size: 15px; }
    #fc-{{ section.id }} .fc__desc { font-size: 12px; }
  }

  /* ============================================
     ANIMATIONS (premium, subtle)
     JS chalega to hi hide hota hai, warna content hamesha visible rahega
     ============================================ */
  #fc-{{ section.id }}.fc-anim .fc__card {
    opacity: 0;
    transform: translateY(20px);
    transition:
      opacity 1s cubic-bezier(0.22, 0.61, 0.36, 1),
      transform 1s cubic-bezier(0.22, 0.61, 0.36, 1);
    transition-delay: calc(var(--fc-i, 0) * 0.15s);
    will-change: opacity, transform;
  }

  #fc-{{ section.id }}.fc-anim.is-visible .fc__card {
    opacity: 1;
    transform: translateY(0);
  }

  #fc-{{ section.id }}.fc-anim.is-done .fc__card {
    transition-delay: 0s;
    will-change: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    #fc-{{ section.id }}.fc-anim .fc__card {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
{%- endstyle -%}

<div id="fc-{{ section.id }}" class="custom-feature-cards">
  <div class="{% unless section.settings.full_width %}page-width{% endunless %}">
    <div class="fc__grid">
      {%- for block in section.blocks -%}
        <div class="fc__card" style="--fc-i: {{ forloop.index0 }}" {{ block.shopify_attributes }}>
          <div class="fc__head">
            <div class="fc__icon">
              {%- if block.settings.icon != blank -%}
                <img
                  src="{{ block.settings.icon | image_url: width: 160 }}"
                  alt=""
                  width="{{ section.settings.icon_size }}"
                  height="{{ section.settings.icon_size }}"
                  loading="lazy"
                >
              {%- else -%}
                {%- assign pos = forloop.index0 | modulo: 4 -%}
                {%- if pos == 0 -%}
                  <svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 6h18l7 9-16 20L4 15z"/><path d="M4 15h32M15 6l-4 9 9 20 9-20-4-9M11 15l9 20"/></svg>
                {%- elsif pos == 1 -%}
                  <svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M33 6C17 6 8 14 8 25c0 3 1 5 2 7 7 1 13 0 17-4 5-4 6-12 6-22z"/><path d="M6 36c4-9 9-15 17-20"/></svg>
                {%- elsif pos == 2 -%}
                  <svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 17v-4a4 4 0 0 1 4-4h14a4 4 0 0 1 4 4v4"/><path d="M5 20a3 3 0 0 1 6 0v3h18v-3a3 3 0 0 1 6 0v9a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2z"/><path d="M10 33v3M30 33v3"/></svg>
                {%- else -%}
                  <svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 5C14 14 9 20 9 26a11 11 0 0 0 22 0c0-6-5-12-11-21z"/><path d="M14 27a6 6 0 0 0 6 6"/></svg>
                {%- endif -%}
              {%- endif -%}
            </div>

            {%- if block.settings.title != blank -%}
              <div class="fc__title fc__richtext" role="heading" aria-level="3">{{ block.settings.title }}</div>
            {%- endif -%}
          </div>

          {%- if block.settings.description != blank -%}
            <div class="fc__desc fc__richtext">{{ block.settings.description }}</div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

<script>
  (function () {
    var section = document.getElementById('fc-{{ section.id }}');
    if (!section) return;

    var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduced || !('IntersectionObserver' in window)) return;

    section.classList.add('fc-anim');

    var observer = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          section.classList.add('is-visible');
          observer.unobserve(section);
          window.setTimeout(function () {
            section.classList.add('is-done');
          }, 2200);
        }
      });
    }, { threshold: 0.15 });

    observer.observe(section);
  })();
</script>

{% schema %}
{
  "name": "Custom Feature Cards",
  "tag": "section",
  "class": "section",
  "max_blocks": 8,
  "settings": [
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg_color", "label": "Section Background", "default": "#FFFFFF" },
    { "type": "color", "id": "card_color", "label": "Card Background", "default": "#F5F1EA" },
    { "type": "color", "id": "title_color", "label": "Title Color", "default": "#302821" },
    { "type": "color", "id": "desc_color", "label": "Description Color", "default": "#302821" },
    { "type": "color", "id": "icon_color", "label": "Default Icon Color", "default": "#302821" },

    { "type": "header", "content": "Layout" },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns (Mobile)",
      "default": "1",
      "options": [
        { "value": "1", "label": "1 (stacked)" },
        { "value": "2", "label": "2 (side by side)" }
      ]
    },
    { "type": "range", "id": "icon_size", "min": 20, "max": 56, "step": 2, "unit": "px", "label": "Icon Size", "default": 32 },
    { "type": "range", "id": "card_radius", "min": 0, "max": 24, "step": 2, "unit": "px", "label": "Card Corner Radius", "default": 0 },
    { "type": "checkbox", "id": "full_width", "label": "Full Width", "default": false },

    { "type": "header", "content": "Section Spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding Top", "default": 32 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding Bottom", "default": 32 }
  ],
  "blocks": [
    {
