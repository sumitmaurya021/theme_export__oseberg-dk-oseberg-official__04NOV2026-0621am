<section
  class="custom-rich-text-img"
  style="background-image: url({{ section.settings.bg_image | image_url }}); background-size: cover; background-position: center;">
  <div class="container">
    <div class="content">      
      {% if section.settings.subtext != blank %}
        <p class="subtext">{{ section.settings.subtext }}</p>
      {% endif %}

       {% if section.settings.heading != blank %}
        <h2 class="heading">{{ section.settings.heading }}</h2>
       {% endif %}
      
      {% if section.settings.button_text != blank and section.settings.button_url != blank %}
        <a href="{{ section.settings.button_url }}" class="custom-btn" title="{{ section.settings.button_text }}"><span>{{ section.settings.button_text }}</span></a>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Custom Rich Text Img",
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL"
    }
  ],
  "presets": [
    {
      "name": "Custom Rich Text Img"
    }
  ]
}
{% endschema %}