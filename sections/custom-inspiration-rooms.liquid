{%- liquid
  assign ir_cards = section.blocks | where: 'type', 'card'
  assign ir_count = ir_cards.size | at_least: 1 | at_most: 3
-%}

{%- style -%}
  #irooms-{{ section.id }} {
    --ir-num: {{ section.settings.number_color }};
    --ir-title: {{ section.settings.title_color }};
    --ir-desc: {{ section.settings.desc_color }};
    --ir-link: {{ section.settings.link_color }};
    --ir-link-hover: {{ section.settings.link_hover_color }};
    --ir-card-title: {{ section.settings.card_title_color }};
    --ir-card-desc: {{ section.settings.card_desc_color }};
    --ir-radius: {{ section.settings.image_radius }}px;
    --ir-ratio: {{ section.settings.image_ratio }};
    background: {{ section.settings.bg_color }};
    border-top: 1px solid {{ section.settings.border_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    overflow: hidden;
  }

  /* ---------- Heading area ---------- */
  #irooms-{{ section.id }} .ir__head {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin: 0 0 32px;
  }

  #irooms-{{ section.id }} .ir__head-text { min-width: 0; }

  #irooms-{{ section.id }} .ir__number {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0 0 16px;
    color: var(--ir-num);
    font-family: var(--font-sans, 'Jost', 'Helvetica Neue', Arial, sans-serif);
    font-size: 12px;
    font-weight: 400;
    line-height: 1.4;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  #irooms-{{ section.id }} .ir__number::after {
    content: '';
    display: block;
    width: 32px;
    height: 1px;
    background: currentColor;
    opacity: 0.6;
  }

  #irooms-{{ section.id }} .ir__title {
    margin: 0 0 16px;
    color: var(--ir-title);
    font-family: var(--font-serif, 'Playfair Display', Georgia, 'Times New Roman', serif);
    font-size: clamp(28px, 3.2vw, 48px);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: 0.01em;
    text-wrap: balance;
    overflow-wrap: break-word;
  }

  #irooms-{{ section.id }} .ir__desc {
    margin: 0;
    max-width: 560px;
    color: var(--ir-desc);
    font-family: var(--font-sans, 'Jost', 'Helvetica Neue', Arial, sans-serif);
    font-size: clamp(14px, 1.05vw, 16px);
    font-weight: 400;
    line-height: 1.6;
    letter-spacing: normal;
  }

  #irooms-{{ section.id }} .ir__more {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    padding: 0 0 4px;
    color: var(--ir-link);
    font-family: var(--font-sans, 'Jost', 'Helvetica Neue', Arial, sans-serif);
    font-size: 12px;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    border-bottom: 1px solid currentColor;
    transition: color 0.4s ease;
  }

  #irooms-{{ section.id }} .ir__more:hover { color: var(--ir-link-hover); }

  /* ---------- Cards ---------- */
  #irooms-{{ section.id }} .ir__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 28px;
  }

  #irooms-{{ section.id }} .ir__card {
    display: block;
    min-width: 0;
    color: inherit;
    text-decoration: none;
  }

  #irooms-{{ section.id }} .ir__media {
    position: relative;
    width: 100%;
    aspect-ratio: var(--ir-ratio);
    overflow: hidden;
    border-radius: var(--ir-radius);
    background: #DED2C3;
  }

  #irooms-{{ section.id }} .ir__media img,
  #irooms-{{ section.id }} .ir__media svg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s ease;
  }

  #irooms-{{ section.id }} a.ir__card:hover .ir__media img {
    transform: scale(1.04);
  }

  #irooms-{{ section.id }} .ir__card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin: 14px 0 4px;
  }

  #irooms-{{ section.id }} .ir__card-title {
    margin: 0;
    color: var(--ir-card-title);
    font-family: var(--font-sans, 'Jost', 'Helvetica Neue', Arial, sans-serif);
    font-size: 14px;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: 0.02em;
    overflow-wrap: break-word;
  }

  #irooms-{{ section.id }} .ir__arrow {
    flex: 0 0 auto;
    width: 16px;
    height: 16px;
    color: var(--ir-card-title);
    transition: transform 0.4s ease;
  }

  #irooms-{{ section.id }} a.ir__card:hover .ir__arrow {
    transform: translateX(4px);
  }

  #irooms-{{ section.id }} .ir__card-desc {
    margin: 0;
    color: var(--ir-card-desc);
    font-family: var(--font-sans, 'Jost', 'Helvetica Neue', Arial, sans-serif);
    font-size: 12px;
    font-weight: 400;
    line-height: 1.5;
    letter-spacing: normal;
  }

  /* ---------- Tablet (750px - 989px) ---------- */
  @media screen and (min-width: 750px) and (max-width: 989px) {
    #irooms-{{ section.id }} .ir__title { font-size: clamp(32px, 5vw, 44px); }
    #irooms-{{ section.id }} .ir__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 24px 20px;
    }
  }

  /* ---------- Desktop (990px and up) ---------- */
  @media screen and (min-width: 990px) {
    #irooms-{{ section.id }} .ir__head {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
      gap: 32px;
    }

    #irooms-{{ section.id }} .ir__more { align-self: flex-end; margin-bottom: 6px; }

    #irooms-{{ section.id }} .ir__grid {
      grid-template-columns: repeat({{ ir_count }}, minmax(0, 1fr));
      gap: clamp(12px, 1.2vw, 20px);
    }

    #irooms-{{ section.id }} .ir__card-title { font-size: 15px; }
  }

  /* ---------- Mobile (749px and below) ---------- */
  @media screen and (max-width: 749px) {
    #irooms-{{ section.id }} .ir__head { margin-bottom: 24px; gap: 16px; }
    #irooms-{{ section.id }} .ir__title { margin-bottom: 12px; }
    #irooms-{{ section.id }} .ir__grid { gap: 24px; }
  }

  /* ============================================
     ANIMATIONS (premium, subtle)
     JS chalega to hi hide hota hai, warna content hamesha visible rahega
     ============================================ */
  #irooms-{{ section.id }}.ir-anim .ir__number,
  #irooms-{{ section.id }}.ir-anim .ir__title,
  #irooms-{{ section.id }}.ir-anim .ir__desc,
  #irooms-{{ section.id }}.ir-anim .ir__more,
  #irooms-{{ section.id }}.ir-anim .ir__card {
    opacity: 0;
    transform: translateY(20px);
    transition:
      opacity 1s cubic-bezier(0.22, 0.61, 0.36, 1),
      transform 1s cubic-bezier(0.22, 0.61, 0.36, 1),
      color 0.4s ease;
    transition-delay: calc(var(--ir-i, 0) * 0.12s);
    will-change: opacity, transform;
  }

  #irooms-{{ section.id }}.ir-anim.is-visible .ir__number,
  #irooms-{{ section.id }}.ir-anim.is-visible .ir__title,
  #irooms-{{ section.id }}.ir-anim.is-visible .ir__desc,
  #irooms-{{ section.id }}.ir-anim.is-visible .ir__more,
  #irooms-{{ section.id }}.ir-anim.is-visible .ir__card {
    opacity: 1;
    transform: translateY(0);
  }

  #irooms-{{ section.id }}.ir-anim.is-done .ir__number,
  #irooms-{{ section.id }}.ir-anim.is-done .ir__title,
  #irooms-{{ section.id }}.ir-anim.is-done .ir__desc,
  #irooms-{{ section.id }}.ir-anim.is-done .ir__more,
  #irooms-{{ section.id }}.ir-anim.is-done .ir__card {
    transition-delay: 0s;
    will-change: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    #irooms-{{ section.id }}.ir-anim .ir__number,
    #irooms-{{ section.id }}.ir-anim .ir__title,
    #irooms-{{ section.id }}.ir-anim .ir__desc,
    #irooms-{{ section.id }}.ir-anim .ir__more,
    #irooms-{{ section.id }}.ir-anim .ir__card {
      opacity: 1;
      transform: none;
      transition: none;
    }
    #irooms-{{ section.id }} .ir__media img { transition: none; }
    #irooms-{{ section.id }} .ir__arrow { transition: none; }
  }
{%- endstyle -%}

<div id="irooms-{{ section.id }}" class="custom-inspiration-rooms">
  <div class="{% unless section.settings.full_width %}page-width{% endunless %}">

    <div class="ir__head">
      <div class="ir__head-text">
        {%- if section.settings.number != blank -%}
          <p class="ir__number">{{ section.settings.number | escape }}</p>
        {%- endif -%}

        {%- if section.settings.title != blank -%}
          <h2 class="ir__title">{{ section.settings.title | escape | newline_to_br }}</h2>
        {%- endif -%}

        {%- if section.settings.description != blank -%}
          <p class="ir__desc">{{ section.settings.description | escape | newline_to_br }}</p>
        {%- endif -%}
      </div>

      {%- if section.settings.link_text != blank and section.settings.link_url != blank -%}
        <a href="{{ section.settings.link_url }}" class="ir__more">{{ section.settings.link_text | escape }}</a>
      {%- endif -%}
    </div>

    {%- if ir_cards.size > 0 -%}
      <div class="ir__grid">
        {%- for block in ir_cards limit: 3 -%}
          {%- liquid
            if block.settings.link != blank
              assign tag = 'a'
            else
              assign tag = 'div'
            endif
          -%}
          <{{ tag }}{% if tag == 'a' %} href="{{ block.settings.link }}"{% endif %} class="ir__card" {{ block.shopify_attributes }}>
            <div class="ir__media">
              {%- if block.settings.image != blank -%}
                <img
                  src="{{ block.settings.image | image_url: width: 900 }}"
                  srcset="{{ block.settings.image | image_url: width: 400 }} 400w,
                          {{ block.settings.image | image_url: width: 600 }} 600w,
                          {{ block.settings.image | image_url: width: 900 }} 900w,
                          {{ block.settings.image | image_url: width: 1200 }} 1200w"
                  sizes="(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw"
                  alt="{{ block.settings.image.alt | default: block.settings.title | escape }}"
                  width="{{ block.settings.image.width }}"
                  height="{{ block.settings.image.height }}"
                  loading="lazy"
                >
              {%- else -%}
                {{ 'lifestyle-1' | placeholder_svg_tag }}
              {%- endif -%}
            </div>

            {%- if block.settings.title != blank or block.settings.description != blank -%}
              <div class="ir__card-top">
                <h3 class="ir__card-title">{{ block.settings.title | escape }}</h3>
                {%- if block.settings.link != blank -%}
                  <svg class="ir__arrow" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <path d="M2 8H13.5M9 3.5L13.5 8L9 12.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                {%- endif -%}
              </div>
              {%- if block.settings.description != blank -%}
                <p class="ir__card-desc">{{ block.settings.description | escape }}</p>
              {%- endif -%}
            {%- endif -%}
          </{{ tag }}>
        {%- endfor -%}
      </div>
    {%- endif -%}

  </div>
</div>

<script>
  (function () {
    var section = document.getElementById('irooms-{{ section.id }}');
    if (!section) return;

    var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduced || !('IntersectionObserver' in window)) return;

    section.querySelectorAll('.ir__number, .ir__title, .ir__desc, .ir__more, .ir__card').forEach(function (el, i) {
      el.style.setProperty('--ir-i', i);
    });

    section.classList.add('ir-anim');

    var observer = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          section.classList.add('is-visible');
          observer.unobserve(section);
          window.setTimeout(function () {
            section.classList.add('is-done');
          }, 2200);
        }
      });
    }, { threshold: 0.15 });

    observer.observe(section);
  })();
</script>

{% schema %}
{
  "name": "Custom Inspiration Rooms",
  "tag": "section",
  "class": "section",
  "max_blocks": 3,
  "settings": [
    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "number", "label": "Small Number / Label", "default": "01" },
    { "type": "textarea", "id": "title", "label": "Title (new line = line break)", "default": "Stuer i forskellige stilarter" },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description (new line = line break)",
      "default": "Lad dig inspirere af, hvordan Oseberg-sofaerne passer ind i forskellige hjem og indretningsstile – fra lyse, nordiske rum til varme, hyggelige stuer."
    },
    { "type": "text", "id": "link_text", "label": "Right Link Text", "default": "Se flere stuer →" },
    { "type": "url", "id": "link_url", "label": "Right Link URL" },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg_color", "label": "Section Background", "default": "#F5F1EA" },
    { "type": "color", "id": "border_color", "label": "Top Border Color", "default": "#A58C76" },
    { "type": "color", "id": "number_color", "label": "Number Color", "default": "#A58C76" },
    { "type": "color", "id": "title_color", "label": "Title Color", "default": "#302821" },
    { "type": "color", "id": "desc_color", "label": "Description Color", "default": "#302821" },
    { "type": "color", "id": "link_color", "label": "Right Link Color", "default": "#302821" },
    { "type": "color", "id": "link_hover_color", "label": "Right Link Hover Color", "default": "#A58C76" },
    { "type": "color", "id": "card_title_color", "label": "Card Title Color", "default": "#302821" },
    { "type": "color", "id": "card_desc_color", "label": "Card Description Color", "default": "#A58C76" },

    { "type": "header", "content": "Layout" },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image Shape",
      "default": "4 / 3",
      "options": [
        { "value": "16 / 9", "label": "Wide (16:9)" },
        { "value": "3 / 2", "label": "Landscape (3:2)" },
        { "value": "4 / 3", "label": "Landscape (4:3)" },
        { "value": "1 / 1", "label": "Square (1:1)" },
        { "value": "4 / 5", "label": "Portrait (4:5)" }
      ]
    },
    { "type": "range", "id": "image_radius", "min": 0, "max": 24, "step": 2, "unit": "px", "label": "Image Corner Radius", "default": 0 },
    { "type": "checkbox", "id": "full_width", "label": "Full Width", "default": false },

    { "type": "header", "content": "Section Spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding Top", "default": 48 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding Bottom", "default": 48 }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Room Card",
      "limit": 3,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Nordisk minimalisme" },
        { "type": "text", "id": "description", "label": "Description", "default": "Lyse toner, naturlige materialer og et roligt udtryk." },
        { "type": "url", "id": "link", "label": "Link (optional)", "info": "Link doge to card clickable hoga aur arrow dikhega." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Inspiration Rooms",
      "blocks": [
        { "type": "card", "settings": { "title": "Nordisk minimalisme", "description": "Lyse toner, naturlige materialer og et roligt udtryk." } },
        { "type": "card", "settings": { "title": "Varme jordfarver", "description": "Skab en hyggelig og indbydende atmosfære." } },
        { "type": "card", "settings": { "title": "Moderne og farverig", "description": "Giv din stue personlighed med varme farver." } }
      ]
    }
  ]
}
{% endschema %}