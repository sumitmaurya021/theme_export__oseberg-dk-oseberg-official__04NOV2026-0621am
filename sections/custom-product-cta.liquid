{%- liquid
  assign mf = product.metafields.custom
  assign pc_title = mf.cta_titel.value
  assign pc_desc = mf.cta_beskrivelse.value
  assign pc_eyebrows = mf.cta_kort_overskrifter.value | strip | newline_to_br | split: '<br />'
  assign pc_card_titles = mf.cta_kort_titler.value | strip | newline_to_br | split: '<br />'
  assign pc_card_descs = mf.cta_kort_beskrivelser.value | strip | newline_to_br | split: '<br />'
  assign pc_btns = mf.cta_kort_knaptekster.value | strip | newline_to_br | split: '<br />'
  assign pc_links = mf.cta_kort_links.value
  assign pc_footer = mf.cta_bundtekst.value
  assign pc_note = mf.cta_note.value
  assign pc_count = pc_card_titles.size | at_most: 2
  if mf.cta_kort_titler.value == blank
    assign pc_count = 0
  endif
-%}

{%- if pc_title != blank or pc_count > 0 -%}

{%- style -%}
  #pcta-{{ section.id }} {
    --pc-title: {{ section.settings.title_color }};
    --pc-desc: {{ section.settings.desc_color }};
    --pc-card-bg: {{ section.settings.card_bg }};
    --pc-eyebrow: {{ section.settings.eyebrow_color }};
    --pc-card-title: {{ section.settings.card_title_color }};
    --pc-card-desc: {{ section.settings.card_desc_color }};
    --pc-btn-bg: {{ section.settings.button_bg }};
    --pc-btn-color: {{ section.settings.button_color }};
    --pc-btn-hover-bg: {{ section.settings.button_hover_bg }};
    --pc-btn-hover-color: {{ section.settings.button_hover_color }};
    --pc-line: {{ section.settings.line_color }};
    --pc-radius: {{ section.settings.card_radius }}px;
    background: {{ section.settings.bg_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    overflow: hidden;
  }

  #pcta-{{ section.id }} .pc__head { margin: 0 0 32px; }

  #pcta-{{ section.id }} .pc__title {
    margin: 0 0 16px;
    color: var(--pc-title);
    font-family: var(--font-serif, 'Playfair Display', Georgia, 'Times New Roman', serif);
    font-size: clamp(28px, 3.2vw, 48px);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: 0.01em;
    text-wrap: balance;
    overflow-wrap: break-word;
  }

  #pcta-{{ section.id }} .pc__desc {
    margin: 0;
    max-width: 640px;
    color: var(--pc-desc);
    font-family: var(--font-sans, 'Jost', 'Helvetica Neue', Arial, sans-serif);
    font-size: clamp(14px, 1.05vw, 16px);
    font-weight: 400;
    line-height: 1.6;
    letter-spacing: normal;
  }

  #pcta-{{ section.id }} .pc__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
  }

  #pcta-{{ section.id }} .pc__card {
    min-width: 0;
    padding: 24px 22px 28px;
    background: var(--pc-card-bg);
    border-radius: var(--pc-radius);
  }

  #pcta-{{ section.id }} .pc__eyebrow {
    margin: 0 0 14px;
    color: var(--pc-eyebrow);
    font-family: var(--font-sans, 'Jost', 'Helvetica Neue', Arial, sans-serif);
    font-size: 12px;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  #pcta-{{ section.id }} .pc__card-title {
    margin: 0 0 8px;
    color: var(--pc-card-title);
    font-family: var(--font-serif, 'Playfair Display', Georgia, 'Times New Roman', serif);
    font-size: clamp(20px, 1.8vw, 26px);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: 0.01em;
    overflow-wrap: break-word;
  }

  #pcta-{{ section.id }} .pc__card-desc {
    margin: 0 0 18px;
    color: var(--pc-card-desc);
    font-family: var(--font-sans, 'Jost', 'Helvetica Neue', Arial, sans-serif);
    font-size: 12px;
    font-weight: 400;
    line-height: 1.5;
    letter-spacing: normal;
  }

  #pcta-{{ section.id }} .pc__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 22px;
    background: var(--pc-btn-bg);
    color: var(--pc-btn-color);
    font-family: var(--font-sans, 'Jost', 'Helvetica Neue', Arial, sans-serif);
    font-size: 12px;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    text-decoration: none;
    border: 1px solid var(--pc-btn-bg);
    border-radius: 0;
    transition: background 0.4s ease, color 0.4s ease, border-color 0.4s ease;
  }

  #pcta-{{ section.id }} .pc__button::before,
  #pcta-{{ section.id }} .pc__button::after {
    content: none !important;
    display: none !important;
  }

  #pcta-{{ section.id }} .pc__button:hover {
    background: var(--pc-btn-hover-bg);
    color: var(--pc-btn-hover-color);
    border-color: var(--pc-btn-hover-bg);
  }

  #pcta-{{ section.id }} .pc__foot {
    margin-top: 32px;
    padding-top: 20px;
    border-top: 1px solid var(--pc-line);
  }

  #pcta-{{ section.id }} .pc__foot-text {
    margin: 0 0 8px;
    color: var(--pc-card-title);
    font-family: var(--font-sans, 'Jost', 'Helvetica Neue', Arial, sans-serif);
    font-size: 12px;
    font-weight: 500;
    line-height: 1.5;
    letter-spacing: 0.02em;
  }

  #pcta-{{ section.id }} .pc__note {
    margin: 0;
    color: var(--pc-card-desc);
    font-family: var(--font-sans, 'Jost', 'Helvetica Neue', Arial, sans-serif);
    font-size: 11px;
    font-weight: 400;
    line-height: 1.5;
    letter-spacing: normal;
  }

  @media screen and (min-width: 750px) {
    #pcta-{{ section.id }} .pc__grid {
      grid-template-columns: repeat({{ pc_count | at_least: 1 }}, minmax(0, 1fr));
      gap: clamp(16px, 2vw, 28px);
    }
    #pcta-{{ section.id }} .pc__card { padding: 26px 26px 30px; }
  }

  @media screen and (min-width: 750px) and (max-width: 989px) {
    #pcta-{{ section.id }} .pc__title { font-size: clamp(32px, 5vw, 44px); }
  }

  @media screen and (max-width: 749px) {
    #pcta-{{ section.id }} .pc__head { margin-bottom: 24px; }
    #pcta-{{ section.id }} .pc__title { margin-bottom: 12px; }
    #pcta-{{ section.id }} .pc__desc { max-width: 100%; }
    #pcta-{{ section.id }} .pc__button { width: 100%; }
  }

  /* ============================================
     ANIMATIONS (premium, subtle)
     JS chalega to hi hide hota hai, warna content hamesha visible rahega
     ============================================ */
  #pcta-{{ section.id }}.pc-anim .pc__head > *,
  #pcta-{{ section.id }}.pc-anim .pc__card,
  #pcta-{{ section.id }}.pc-anim .pc__foot {
    opacity: 0;
    transform: translateY(20px);
    transition:
      opacity 1s cubic-bezier(0.22, 0.61, 0.36, 1),
      transform 1s cubic-bezier(0.22, 0.61, 0.36, 1);
    transition-delay: calc(var(--pc-i, 0) * 0.15s);
    will-change: opacity, transform;
  }

  #pcta-{{ section.id }}.pc-anim.is-visible .pc__head > *,
  #pcta-{{ section.id }}.pc-anim.is-visible .pc__card,
  #pcta-{{ section.id }}.pc-anim.is-visible .pc__foot {
    opacity: 1;
    transform: translateY(0);
  }

  #pcta-{{ section.id }}.pc-anim.is-done .pc__head > *,
  #pcta-{{ section.id }}.pc-anim.is-done .pc__card,
  #pcta-{{ section.id }}.pc-anim.is-done .pc__foot {
    transition-delay: 0s;
    will-change: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    #pcta-{{ section.id }}.pc-anim .pc__head > *,
    #pcta-{{ section.id }}.pc-anim .pc__card,
    #pcta-{{ section.id }}.pc-anim .pc__foot {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
{%- endstyle -%}

<div id="pcta-{{ section.id }}" class="custom-product-cta">
  <div class="{% unless section.settings.full_width %}page-width{% endunless %}">

    {%- if pc_title != blank or pc_desc != blank -%}
      <div class="pc__head">
        {%- if pc_title != blank -%}
          <h2 class="pc__title">{{ pc_title | escape | newline_to_br }}</h2>
        {%- endif -%}
        {%- if pc_desc != blank -%}
          <p class="pc__desc">{{ pc_desc | escape | newline_to_br }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if pc_count > 0 -%}
      <div class="pc__grid">
        {%- for title in pc_card_titles limit: 2 -%}
          {%- assign idx = forloop.index0 -%}
          {%- assign t = title | strip -%}
          {%- assign e = pc_eyebrows[idx] | strip -%}
          {%- assign d = pc_card_descs[idx] | strip -%}
          {%- assign b = pc_btns[idx] | strip -%}
          {%- assign card_product = pc_links | slice: idx, 1 | first -%}
          {%- if t != blank or d != blank -%}
            <div class="pc__card">
              {%- if e != blank -%}
                <p class="pc__eyebrow">{{ e | escape }}</p>
              {%- endif -%}
              {%- if t != blank -%}
                <h3 class="pc__card-title">{{ t | escape }}</h3>
              {%- endif -%}
              {%- if d != blank -%}
                <p class="pc__card-desc">{{ d | escape }}</p>
              {%- endif -%}
              {%- if b != blank and card_product != blank -%}
                <a href="{{ card_product.url }}" class="pc__button">{{ b | escape }}</a>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if pc_footer != blank or pc_note != blank -%}
      <div class="pc__foot">
        {%- if pc_footer != blank -%}
          <p class="pc__foot-text">{{ pc_footer | escape }}</p>
        {%- endif -%}
        {%- if pc_note != blank -%}
          <p class="pc__note">{{ pc_note | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

  </div>
</div>

<script>
  (function () {
    var section = document.getElementById('pcta-{{ section.id }}');
    if (!section) return;

    var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduced || !('IntersectionObserver' in window)) return;

    section.querySelectorAll('.pc__head > *, .pc__card, .pc__foot').forEach(function (el, i) {
      el.style.setProperty('--pc-i', i);
    });

    section.classList.add('pc-anim');

    var observer = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          section.classList.add('is-visible');
          observer.unobserve(section);
          window.setTimeout(function () {
            section.classList.add('is-done');
          }, 2200);
        }
      });
    }, { threshold: 0.1 });

    observer.observe(section);
  })();
</script>

{%- elsif request.design_mode -%}
  <div class="page-width" style="padding: 24px 0; text-align: center; opacity: .6;">
    Produkt-CTA: cta-metafelterne er tomme for dette produkt.
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Custom Product CTA",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "paragraph", "content": "Text, cards aur links product ke metafields (custom.cta_*) se aate hain." },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg_color", "label": "Section Background", "default": "#F5F1EA" },
    { "type": "color", "id": "title_color", "label": "Title Color", "default": "#302821" },
    { "type": "color", "id": "desc_color", "label": "Description Color", "default": "#302821" },
    { "type": "color", "id": "card_bg", "label": "Card Background", "default": "#E8DFD3" },
    { "type": "color", "id": "eyebrow_color", "label": "Card Small Heading Color", "default": "#A58C76" },
    { "type": "color", "id": "card_title_color", "label": "Card Title Color", "default": "#302821" },
    { "type": "color", "id": "card_desc_color", "label": "Card Description Color", "default": "#A58C76" },
    { "type": "color", "id": "button_bg", "label": "Button Background", "default": "#302821" },
    { "type": "color", "id": "button_color", "label": "Button Text Color", "default": "#FFFFFF" },
    { "type": "color", "id": "button_hover_bg", "label": "Button Hover Background", "default": "#A58C76" },
    { "type": "color", "id": "button_hover_color", "label": "Button Hover Text Color", "default": "#FFFFFF" },
    { "type": "color", "id": "line_color", "label": "Divider Line Color", "default": "#DED2C3" },

    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "card_radius", "min": 0, "max": 24, "step": 2, "unit": "px", "label": "Card Corner Radius", "default": 12 },
    { "type": "checkbox", "id": "full_width", "label": "Full Width", "default": false },

    { "type": "header", "content": "Section Spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding Top", "default": 48 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding Bottom", "default": 48 }
  ],
  "presets": [
    { "name": "Custom Product CTA" }
  ]
}
{% endschema %}