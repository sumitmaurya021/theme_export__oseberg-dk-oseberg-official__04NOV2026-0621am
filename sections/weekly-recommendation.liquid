{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="weekly-recommendation-section section-{{ section.id }}-padding" style="background: {{ section.settings.background_color }}">
  <div class="page-width">

    <h2 class="weekly-section-heading">{{ section.settings.section_heading }}</h2>
    <div class="weekly-recommendation-contentarea">
    <div class="weekly-recommendation-wrapper">
      
      {% if section.settings.product != blank %}
  {% assign product = all_products[section.settings.product] %}

  <div class="weekly-recommendation-left">
    <a href="{{ product.url }}" class="product-card-link">
      <div class="product-card">
        <div class="product-content">
          <h4 class="product-subtitle">{{ section.settings.elevationssenge }}</h4>
          <h2 class="product-title">{{ product.title }}</h2>
          <p class="product-price">
            {{ product.price | money }}
            {% if product.compare_at_price > product.price %}
              <span class="compare-price">{{ product.compare_at_price | money }}</span>
              <span class="discount-badge">
                {{ 100 | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round }}%
              </span>
            {% endif %}
          </p>
        </div> 
        <div class="product-image">
          <img src="{{ product.featured_image | img_url: '600x600' }}" alt="{{ product.title }}">
        </div>
      </div>
    </a>
  </div>

  <div class="weekly-recommendation-right">
    <a href="{{ product.url }}" class="video-card-link">
      {% if section.settings.video_file != blank %}
        <div class="video-wrapper">
          {{ section.settings.video_file | video_tag: autoplay: true, muted: true, loop: true }}
        </div>
      {% endif %}
      {% if section.settings.tag_text != blank %}
        <span class="recommendation-tag">{{ section.settings.tag_text }}</span>
      {% endif %}
    </a>
  </div>
{% endif %}

    </div>
    <div class="weeky-bottom-note">
         {% if section.settings.product != blank %}
  {% assign product = all_products[section.settings.product] %}
    {% if section.settings.bottom_note != blank %}
      <a href="{{ product.ur }}"><p class="bottom-note">{{ section.settings.bottom_note }}</p></a>
    {% endif %}
           {% endif %}
    </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Weekly Recommendation",
  "settings": [
    {
     "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#bab1a5"
    },
    {
      "type": "text",
      "id": "section_heading",
      "label": "Section Heading"
    },
    {
      "type": "text",
      "id": "elevationssenge",
      "label": "ELEVATIONSSENGE"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Select Product"
    },
    {
      "type": "video",
      "id": "video_file",
      "label": "Upload Video"
    },
    {
      "type": "text",
      "id": "tag_text",
      "label": "Tag Text",
      "default": "Ugens anbefaling"
    },
    {
      "type": "text",
      "id": "bottom_note",
      "label": "Bottom Note",
      "default": "Gælder t.o.m 27/04 eller så længe lager haves."
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Weekly Recommendation"
    }
  ]
}
{% endschema %}

{% style %}
.weekly-recommendation-section .weekly-section-heading {
    margin: 0 0 24px;
    font-family: 'Circular';
    font-weight: 700;
    font-size: 32px;
    line-height: 1.2em;
    letter-spacing: normal;
    color: #000;
}  
.weekly-recommendation-section .weekly-recommendation-contentarea {
    background-color: #fff;
    border-radius: 30px;
} 
.weekly-recommendation-section a {
    text-decoration: none;
}  
.weekly-recommendation-wrapper {
  display: flex;
}
.weekly-recommendation-section .weekly-recommendation-left {
    position: relative;
    width: 33.33%;
}  
.weekly-recommendation-section .weekly-recommendation-right {
  position: relative;
  width: 66.66%;
}  
.weekly-recommendation-section .weekly-recommendation-left .product-card {
    padding: 34px 14px 14px;
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: 20px;
}
.weekly-recommendation-section .weekly-recommendation-left .product-card .product-subtitle {
    margin: 0 0 8px;
    font-family: 'Circular-Regular';
    font-size: 13px;
    line-height: 1em;
    color: #121212bf;
    text-transform: uppercase;
}  
.weekly-recommendation-section .weekly-recommendation-left .product-card  .product-title {
    margin: 0;
    display: inline-block;
    font-family: 'Circular-Bold';
    font-weight: 700;
    font-size: 28px;
    line-height: 1.1em;
    color: #121212;
}
.weekly-recommendation-section .weekly-recommendation-left .product-card .product-price {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0;
    font-family: 'Circular-Bold';
    font-weight: 700;
    font-size: 28px;
    line-height: 1.4em;
    color: var(--color-primary);
}
.weekly-recommendation-section .weekly-recommendation-left .product-card .compare-price {
  text-decoration: line-through;
  font-family: 'Circular-Regular';
  font-size: 24px;
  line-height: normal;
  color: #121212bf;
  font-weight: 600;
}
.weekly-recommendation-section .weekly-recommendation-left .discount-badge {
    position: absolute;
    top: 11px;
    right: 0;
    background: var(--color-primary);
    color: var(--color-white);
    padding: 2px 20px;
    border-radius: 100px 0 0 100px;
    font-family: 'Circular';
    font-size: 18px;
    line-height: 2em;
    font-weight: 700;
}
.weekly-recommendation-section .weekly-recommendation-left .product-image {
    line-height: 0;
    height: 100%;
}
.weekly-recommendation-section .weekly-recommendation-left .product-image img {
    width: 100%;
    height: 100%;
    max-height: 300px;
    object-fit: contain;
}
.weekly-recommendation-section .weekly-recommendation-right .video-wrapper {
    line-height: 0;
    height: 100%;
}  
.weekly-recommendation-section .weekly-recommendation-right .video-wrapper video {
    width: 100%;
    border-radius: 0 30px 0 0;
    height: 100%;
    object-fit: cover;
    aspect-ratio: 16 / 9;
}
.weekly-recommendation-section .weekly-recommendation-right .recommendation-tag {
    position: absolute;
    top: 30px;
    right: 30px;
    background: var(--color-primary);
    color: var(--color-white);
    padding: 8px 12px;
    border-radius: 30px;
    font-family: 'circular-std-medium';
    font-size: 12px;
    font-weight: 500;
    line-height: 1.3em;
}
.weekly-recommendation-section .weekly-recommendation-contentarea .weeky-bottom-note {
    background: var(--color-primary);
    border-radius: 0 0 30px 30px;
}  
.weekly-recommendation-section .weekly-recommendation-contentarea .weeky-bottom-note a {
    color: var(--color-white);
}  
.weekly-recommendation-section .weekly-recommendation-contentarea .weeky-bottom-note .bottom-note {
    text-align: center;
    font-size: 14px;
    line-height: 1em;
    font-weight: 400;
    letter-spacing: normal;
    margin: 0;
    padding: 10px 16px;
}
@media screen and (max-width: 990px) {
  .weekly-recommendation-section .weekly-recommendation-left .discount-badge {
      padding: 0px 12px;
  }
}  
@media screen and (max-width: 767px) {
  .weekly-recommendation-section .weekly-recommendation-contentarea {
      border: 2px solid var(--color-primary);
  }
  .weekly-recommendation-section .weekly-recommendation-wrapper {
      display: flex;
      flex-direction: row;
      position: relative;
  }
  .weekly-recommendation-section .weekly-recommendation-right,
  .weekly-recommendation-section .weekly-recommendation-left {
      width: 100%;
  }
  .weekly-recommendation-section .weekly-recommendation-left {
      position: unset;
  }
  .weekly-recommendation-section .weekly-recommendation-right .video-wrapper video {
      border-radius: 0 28px 0 0;
      height: 100%;
      aspect-ratio: 2 / 1.5;
      object-fit: cover;
  }
  .weekly-recommendation-section .weekly-recommendation-right .recommendation-tag {
      top: 24px;
      left: 16px;
      right: auto;
  }
  .weekly-recommendation-section .weekly-recommendation-left .product-image img {
      border-radius: 16px;
  }
  .weekly-recommendation-section .weekly-recommendation-left .product-card {
      padding: 20px;
      flex-direction: column-reverse;
  }
  .weekly-recommendation-section .weekly-recommendation-left .discount-badge {
      top: 20px;
      padding: 4px 24px;
      z-index: 1;
  }
  .weekly-recommendation-section .weekly-recommendation-left .product-card  .product-title,
  .weekly-recommendation-section .weekly-recommendation-left .product-card .product-price {
      font-size: 20px;
  }
  .weekly-recommendation-section .weekly-recommendation-left .product-card .compare-price {
      font-size: 16px;
  }
  .weekly-recommendation-section .weekly-recommendation-left .product-image {
      z-index: 1;
      /* margin-top: -100px; */
  }
  .weekly-recommendation-section .weekly-recommendation-contentarea .weeky-bottom-note {
      border-radius: 0 0 28px 28px;
  }
}  
@media screen and (max-width: 480px) {
  .weekly-recommendation-section .weekly-recommendation-left .product-card {
    padding: 12px;
  }
  .weekly-recommendation-section .weekly-recommendation-left .product-card .product-price {
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
  }
  .weekly-recommendation-section .weekly-recommendation-left .discount-badge {
    top: 64px;
    font-size: 15px;
    padding: 2px 10px 2px 16px;
  }
}
{% endstyle %}