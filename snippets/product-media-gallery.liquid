{% comment %}
  Renders a product media gallery. Should be used with 'media-gallery.js'
  Also see 'product-media-modal'

  Accepts:
  - product: {Object} Product liquid object
  - variant_images: {Array} Product images associated with a variant
  - limit: {Number} (optional) When passed, limits the number of media items to render

  Usage:
  {% render 'product-media-gallery' %}
{% endcomment %}

{%- liquid
  if section.settings.hide_variants and variant_images.size == product.media.size
    assign single_media_visible = true
  endif

  if limit == 1
    assign single_media_visible = true
  endif

  assign media_count = product.media.size
  if section.settings.hide_variants and media_count > 1 and variant_images.size > 0
    assign media_count = media_count | minus: variant_images.size | plus: 1
  endif

  if media_count == 1 or single_media_visible
    assign single_media_visible_mobile = true
  endif

  if media_count == 0 or single_media_visible_mobile or section.settings.mobile_thumbnails == 'show' or section.settings.mobile_thumbnails == 'columns' and media_count < 3
    assign hide_mobile_slider = true
  endif

  if section.settings.media_size == 'large'
    assign media_width = 0.65
  elsif section.settings.media_size == 'medium'
    assign media_width = 0.55
  elsif section.settings.media_size == 'small'
    assign media_width = 0.45
  endif

  assign has_variant_metafield_images = false
  for v in product.variants
    if v.metafields.custom.variant_images.value != blank
      assign has_variant_metafield_images = true
      break
    endif
  endfor

  assign active_variant = product.selected_or_first_available_variant
  assign active_has_metafield = false
  if active_variant.metafields.custom.variant_images.value != blank
    assign active_has_metafield = true
  endif

  if has_variant_metafield_images and active_has_metafield
    assign initial_media_count = active_variant.metafields.custom.variant_images.value.size
  else
    assign initial_media_count = media_count
  endif
-%}

{%- capture main_sizes -%}
  (min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 | times: media_width | round }}px, (min-width: 990px) calc({{ media_width | times: 100 }}vw - 10rem), (min-width: 750px) calc((100vw - 11.5rem) / 2), calc(100vw - 4rem)
{%- endcapture -%}

<media-gallery
  id="MediaGallery-{{ section.id }}"
  role="region"
  {% if section.settings.enable_sticky_info %}
    class="product__column-sticky"
  {% endif %}
  aria-label="{{ 'products.product.media.gallery_viewer' | t }}"
  data-desktop-layout="{{ section.settings.gallery_layout }}"
>
  <div id="GalleryStatus-{{ section.id }}" class="visually-hidden" role="status"></div>
  <slider-component id="GalleryViewer-{{ section.id }}" class="slider-mobile-gutter">
    <a class="skip-to-content-link button visually-hidden quick-add-hidden" href="#ProductInfo-{{ section.id }}">
      {{ 'accessibility.skip_to_product_info' | t }}
    </a>
      {% comment %} {% if product.metafields.custom.main_image != blank %} {% endcomment %}
        {% comment %} <div class="scrolled_image">
          <li class="custom-image">
              {% comment %} <img src="{{ product.metafields.custom.main_image | img_url:'master' }}" style="height:auto;width:auto;max-width:100%;"> {% endcomment %}
              <img src="{{ product.images.first | img_url:'master' }}" style="height:auto;width:auto;max-width:100%;">
            </li>
        </div> {% endcomment %}
      {% comment %} {% endif %} {% endcomment %}
    <ul
      id="Slider-Gallery-{{ section.id }}"
      class="product__media-list contains-media grid grid--peek list-unstyled slider slider--mobile"
      role="list"
    >
      {%- if has_variant_metafield_images -%}
        {%- for v in product.variants -%}
          {%- if v.metafields.custom.variant_images.value != blank -%}
            {%- assign is_this_var_active = false -%}
            {%- if active_has_metafield and v.id == active_variant.id -%}
              {%- assign is_this_var_active = true -%}
            {%- endif -%}
            {%- for img in v.metafields.custom.variant_images.value -%}
              {%- assign img_source = img.preview_image | default: img -%}
              <li
                id="Slide-{{ section.id }}-var-{{ v.id }}-{{ forloop.index }}"
                class="product__media-item grid__item slider__slide variant-media-item{% if is_this_var_active and forloop.first %} is-active{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}"
                data-media-id="{{ section.id }}-var-{{ v.id }}-{{ forloop.index }}"
                data-variant-id="{{ v.id }}"
                data-variant-color="{{ v.option1 | downcase | strip | escape }}"
                {% unless is_this_var_active %}style="display: none !important;" aria-hidden="true"{% endunless %}
              >
                <div
                  class="product-media-container media-type-image media-fit-{{ section.settings.media_fit }} global-media-settings gradient{% if section.settings.constrain_to_viewport %} constrain-height{% endif %}"
                  style="--ratio: {{ img_source.aspect_ratio | default: 1.0 }}; --preview-ratio: {{ img_source.aspect_ratio | default: 1.0 }};"
                >
                  <modal-opener
                    class="product__modal-opener product__modal-opener--image"
                    data-modal="#ProductModal-{{ section.id }}"
                  >
                    <span
                      class="product__media-icon motion-reduce quick-add-hidden product__media-icon--{{ section.settings.image_zoom }}"
                      aria-hidden="true"
                    >
                      <span class="svg-wrapper">
                        {{- 'icon-zoom.svg' | inline_asset_content -}}
                      </span>
                    </span>
                    {%- render 'loading-spinner' -%}
                    <div class="product__media media media--transparent">
                      {{
                        img_source
                        | image_url: width: 1946
                        | image_tag:
                          class: 'image-magnify-lightbox',
                          loading: 'lazy',
                          sizes: main_sizes,
                          widths: '246, 493, 600, 713, 823, 990, 1100, 1206, 1346, 1426, 1646, 1946',
                          alt: img.alt | default: product.title | escape
                      }}
                    </div>
                    <button
                      class="product__media-toggle quick-add-hidden product__media-zoom-{{ section.settings.image_zoom }}"
                      type="button"
                      aria-haspopup="dialog"
                      data-media-id="{{ section.id }}-var-{{ v.id }}-{{ forloop.index }}"
                    >
                      <span class="visually-hidden">
                        {{ 'products.product.media.open_media' | t: index: forloop.index }}
                      </span>
                    </button>
                  </modal-opener>
                </div>
              </li>
            {%- endfor -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
 
      {%- if product.selected_or_first_available_variant.featured_media != null -%}
        {%- assign featured_media = product.selected_or_first_available_variant.featured_media -%}
        <li
          id="Slide-{{ section.id }}-{{ featured_media.id }}"
          class="product__media-item grid__item slider__slide variant-media-item{% if single_media_visible %} product__media-item--single{% endif %}{% if featured_media.media_type != 'image' %} product__media-item--full{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}{% unless active_has_metafield %} is-active{% endunless %}"
          data-media-id="{{ section.id }}-{{ featured_media.id }}"
          data-variant-id="default"
          data-variant-color="default"
          {% if has_variant_metafield_images and active_has_metafield %}style="display: none !important;" aria-hidden="true"{% endif %}
        >
          {%- assign media_position = 1 -%}
          {% render 'product-thumbnail',
            media: featured_media,
            media_count: media_count,
            position: media_position,
            desktop_layout: section.settings.gallery_layout,
            mobile_layout: section.settings.mobile_thumbnails,
            loop: section.settings.enable_video_looping,
            modal_id: section.id,
            xr_button: true,
            media_width: media_width,
            media_fit: section.settings.media_fit,
            constrain_to_viewport: section.settings.constrain_to_viewport,
            lazy_load: false
          %}
        </li>
      {%- endif -%}
      {% comment %} {%- for media in product.media offset: 1 -%} {% endcomment %}
       {%- for media in product.media -%}
        {% if media_position >= limit
          or media_position >= 1
          and section.settings.hide_variants
          and variant_images contains media.src
        %}
          {% continue %}
        {% endif %}

        {%- unless media.id == product.selected_or_first_available_variant.featured_media.id -%}
          <li
            id="Slide-{{ section.id }}-{{ media.id }}"
            class="product__media-item grid__item slider__slide variant-media-item{% if single_media_visible %} product__media-item--single{% endif %}{% if product.selected_or_first_available_variant.featured_media == nil and forloop.index == 1 and active_has_metafield == false %} is-active{% endif %}{% if media.media_type != 'image' %} product__media-item--full{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}"
            data-media-id="{{ section.id }}-{{ media.id }}"
            data-variant-id="default"
            data-variant-color="default"
            {% if has_variant_metafield_images and active_has_metafield %}style="display: none !important;" aria-hidden="true"{% endif %}
          >
            {%- liquid
              assign media_position = media_position | default: 0 | plus: 1
              assign lazy_load = false
              if media_position > 1
                assign lazy_load = true
              endif
            -%}
            {% render 'product-thumbnail',
              media: media,
              media_count: media_count,
              position: media_position,
              desktop_layout: section.settings.gallery_layout,
              mobile_layout: section.settings.mobile_thumbnails,
              loop: section.settings.enable_video_looping,
              modal_id: section.id,
              xr_button: true,
              media_width: media_width,
              media_fit: section.settings.media_fit,
              constrain_to_viewport: section.settings.constrain_to_viewport,
              lazy_load: lazy_load
            %}
          </li>
        {%- endunless -%}
      {%- endfor -%}
    </ul>
    <div class="slider-buttons quick-add-hidden{% if hide_mobile_slider %} small-hide{% endif %}">
      <button
        type="button"
        class="slider-button slider-button--prev"
        name="previous"
        aria-label="{{ 'general.slider.previous_slide' | t }}"
      >
        <span class="svg-wrapper">
          {{- 'icon-caret.svg' | inline_asset_content -}}
        </span>
      </button>
      <div class="slider-counter caption">
        <span class="slider-counter--current">1</span>
        <span aria-hidden="true"> / </span>
        <span class="visually-hidden">{{ 'general.slider.of' | t }}</span>
        <span class="slider-counter--total">{{ initial_media_count }}</span>
      </div>
      <button
        type="button"
        class="slider-button slider-button--next"
        name="next"
        aria-label="{{ 'general.slider.next_slide' | t }}"
      >
        <span class="svg-wrapper">
          {{- 'icon-caret.svg' | inline_asset_content -}}
        </span>
      </button>
    </div>
  </slider-component>
  {%- if first_3d_model -%}
    <button
      class="button button--full-width product__xr-button"
      type="button"
      aria-label="{{ 'products.product.xr_button_label' | t }}"
      data-shopify-xr
      data-shopify-model3d-id="{{ first_3d_model.id }}"
      data-shopify-title="{{ product.title | escape }}"
      data-shopify-xr-hidden
    >
      <span class="svg-wrapper">
        {{- 'icon-3d-model.svg' | inline_asset_content -}}
      </span>
      {{ 'products.product.xr_button' | t }}
    </button>
  {%- endif -%}
  {%- liquid
    assign is_not_limited_to_single_item = false
    if limit == null or limit > 1
      assign is_not_limited_to_single_item = true
    endif
  -%}
  {%- assign show_thumbnails = false -%}
  {%- if is_not_limited_to_single_item -%}
    {%- if media_count > 1 or has_variant_metafield_images -%}
      {%- if section.settings.gallery_layout contains 'thumbnail' or section.settings.mobile_thumbnails == 'show' -%}
        {%- assign show_thumbnails = true -%}
      {%- endif -%}
    {%- endif -%}
  {%- endif -%}
  {%- if show_thumbnails -%}
    <slider-component
      id="GalleryThumbnails-{{ section.id }}"
      class="thumbnail-slider slider-mobile-gutter quick-add-hidden{% unless section.settings.gallery_layout contains 'thumbnail' %} medium-hide large-up-hide{% endunless %}{% if section.settings.mobile_thumbnails != 'show' %} small-hide{% endif %}{% if media_count <= 3 %} thumbnail-slider--no-slide{% endif %}"
    >
      <button
        type="button"
        class="slider-button slider-button--prev{% if media_count <= 3 %} small-hide{% endif %}{% if media_count <= 4 %} medium-hide large-up-hide{% endif %}"
        name="previous"
        aria-label="{{ 'general.slider.previous_slide' | t }}"
        aria-controls="GalleryThumbnails-{{ section.id }}"
        data-step="3"
      >
        <span class="svg-wrapper">
          {{- 'icon-caret.svg' | inline_asset_content -}}
        </span>
      </button>
      <ul
        id="Slider-Thumbnails-{{ section.id }}"
        class="thumbnail-list list-unstyled slider slider--mobile{% if section.settings.gallery_layout == 'thumbnail_slider' %} slider--tablet-up{% endif %}"
      >
        {%- capture sizes -%}
          (min-width: {{ settings.page_width }}px) calc(({{ settings.page_width | minus: 100 | times: media_width | round }} - 4rem) / 4),
          (min-width: 990px) calc(({{ media_width | times: 100 }}vw - 4rem) / 4),
          (min-width: 750px) calc((100vw - 15rem) / 8),
          calc((100vw - 8rem) / 3)
        {%- endcapture -%}

        {%- if has_variant_metafield_images -%}
          {%- for v in product.variants -%}
            {%- if v.metafields.custom.variant_images.value != blank -%}
              {%- assign is_this_var_active = false -%}
              {%- if active_has_metafield and v.id == active_variant.id -%}
                {%- assign is_this_var_active = true -%}
              {%- endif -%}
              {%- for img in v.metafields.custom.variant_images.value -%}
                {%- assign img_source = img.preview_image | default: img -%}
                <li
                  id="Slide-Thumbnails-{{ section.id }}-var-{{ v.id }}-{{ forloop.index }}"
                  class="thumbnail-list__item slider__slide variant-thumbnail-item{% if section.settings.hide_variants and variant_images contains img_source.src %} thumbnail-list_item--variant{% endif %}"
                  data-target="{{ section.id }}-var-{{ v.id }}-{{ forloop.index }}"
                  data-media-position="{{ forloop.index }}"
                  data-variant-id="{{ v.id }}"
                  data-variant-color="{{ v.option1 | downcase | strip | escape }}"
                  {% unless is_this_var_active %}style="display: none !important;" aria-hidden="true"{% endunless %}
                >
                  {%- capture thumbnail_id -%}Thumbnail-{{ section.id }}-var-{{ v.id }}-{{ forloop.index }}{%- endcapture -%}
                  <button
                    class="thumbnail global-media-settings global-media-settings--no-shadow"
                    aria-label="{{ 'products.product.media.load_image' | t: index: forloop.index }}"
                    {% if is_this_var_active and forloop.first %}aria-current="true"{% endif %}
                    aria-controls="GalleryViewer-{{ section.id }}"
                    aria-describedby="{{ thumbnail_id }}"
                  >
                    {{
                      img_source
                      | image_url: width: 416
                      | image_tag:
                        loading: 'lazy',
                        sizes: sizes,
                        widths: '54, 74, 104, 162, 208, 324, 416',
                        id: thumbnail_id,
                        alt: img.alt | default: product.title | escape
                      | escape
                    }}
                  </button>
                </li>
              {%- endfor -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}

        {%- if featured_media != null -%}
          {%- liquid
            capture media_index
              if featured_media.media_type == 'model'
                increment model_index
              elsif featured_media.media_type == 'video' or featured_media.media_type == 'external_video'
                increment video_index
              elsif featured_media.media_type == 'image'
                increment image_index
              endif
            endcapture
            assign media_index = media_index | plus: 1
          -%}
          <li
            id="Slide-Thumbnails-{{ section.id }}-0"
            class="thumbnail-list__item slider__slide variant-thumbnail-item{% if section.settings.hide_variants and variant_images contains featured_media.src %} thumbnail-list_item--variant{% endif %}"
            data-target="{{ section.id }}-{{ featured_media.id }}"
            data-media-position="{{ media_index }}"
            data-variant-id="default"
            data-variant-color="default"
            {% if has_variant_metafield_images and active_has_metafield %}style="display: none !important;" aria-hidden="true"{% endif %}
          >
            {%- capture thumbnail_id -%}
              Thumbnail-{{ section.id }}-0
            {%- endcapture -%}
            <button
              class="thumbnail global-media-settings global-media-settings--no-shadow"
              aria-label="{%- if featured_media.media_type == 'image' -%}{{ 'products.product.media.load_image' | t: index: media_index }}{%- elsif featured_media.media_type == 'model' -%}{{ 'products.product.media.load_model' | t: index: media_index }}{%- elsif featured_media.media_type == 'video' or featured_media.media_type == 'external_video' -%}{{ 'products.product.media.load_video' | t: index: media_index }}{%- endif -%}"
              aria-current="true"
              aria-controls="GalleryViewer-{{ section.id }}"
              aria-describedby="{{ thumbnail_id }}"
            >
              {{
                featured_media.preview_image
                | image_url: width: 416
                | image_tag:
                  loading: 'lazy',
                  sizes: sizes,
                  widths: '54, 74, 104, 162, 208, 324, 416',
                  id: thumbnail_id,
                  alt: featured_media.alt
                | escape
              }}
            </button>
          </li>
        {%- endif -%}
        {%- for media in product.media offset: 1 -%}
          {%- unless media.id == product.selected_or_first_available_variant.featured_media.id -%}
            {%- liquid
              capture media_index
                if media.media_type == 'model'
                  increment model_index
                elsif media.media_type == 'video' or media.media_type == 'external_video'
                  increment video_index
                elsif media.media_type == 'image'
                  increment image_index
                endif
              endcapture
              assign media_index = media_index | plus: 1
            -%}
            <li
              id="Slide-Thumbnails-{{ section.id }}-{{ forloop.index }}"
              class="thumbnail-list__item slider__slide variant-thumbnail-item{% if section.settings.hide_variants and variant_images contains media.src %} thumbnail-list_item--variant{% endif %}"
              data-target="{{ section.id }}-{{ media.id }}"
              data-media-position="{{ media_index }}"
              data-variant-id="default"
              data-variant-color="default"
              {% if has_variant_metafield_images and active_has_metafield %}style="display: none !important;" aria-hidden="true"{% endif %}
            >
              {%- if media.media_type == 'model' -%}
                <span class="thumbnail__badge" aria-hidden="true">
                  <span class="svg-wrapper">
                    {{- 'icon-3d-model.svg' | inline_asset_content -}}
                  </span>
                </span>
              {%- elsif media.media_type == 'video' or media.media_type == 'external_video' -%}
                <span class="thumbnail__badge" aria-hidden="true">
                  <span class="svg-wrapper">
                    {{- 'icon-play.svg' | inline_asset_content -}}
                  </span>
                </span>
              {%- endif -%}
              {%- capture thumbnail_id -%}
                Thumbnail-{{ section.id }}-{{ forloop.index }}
              {%- endcapture -%}
              <button
                class="thumbnail global-media-settings global-media-settings--no-shadow"
                aria-label="{%- if media.media_type == 'image' -%}{{ 'products.product.media.load_image' | t: index: media_index }}{%- elsif media.media_type == 'model' -%}{{ 'products.product.media.load_model' | t: index: media_index }}{%- elsif media.media_type == 'video' or media.media_type == 'external_video' -%}{{ 'products.product.media.load_video' | t: index: media_index }}{%- endif -%}"
                {% if media == product.selected_or_first_available_variant.featured_media
                  or product.selected_or_first_available_variant.featured_media == null
                  and forloop.index == 1
                %}
                  aria-current="true"
                {% endif %}
                aria-controls="GalleryViewer-{{ section.id }}"
                aria-describedby="{{ thumbnail_id }}"
              >
                {{
                  media.preview_image
                  | image_url: width: 416
                  | image_tag:
                    loading: 'lazy',
                    sizes: sizes,
                    widths: '54, 74, 104, 162, 208, 324, 416',
                    id: thumbnail_id,
                    alt: media.alt
                  | escape
                }}
              </button>
            </li>
          {%- endunless -%}
        {%- endfor -%}
      </ul>
      <button
        type="button"
        class="slider-button slider-button--next{% if media_count <= 3 %} small-hide{% endif %}{% if media_count <= 4 %} medium-hide large-up-hide{% endif %}"
        name="next"
        aria-label="{{ 'general.slider.next_slide' | t }}"
        aria-controls="GalleryThumbnails-{{ section.id }}"
        data-step="3"
      >
        <span class="svg-wrapper">
          {{- 'icon-caret.svg' | inline_asset_content -}}
        </span>
      </button>
    </slider-component>
  {%- endif -%}
  <div class="custom-slider-dots" id="custom-slider-dots"></div>
</media-gallery>

<script>
  (function () {
    function initGalleryController() {
      const gallery = document.getElementById('MediaGallery-{{ section.id }}');
      if (!gallery) return;

      const mainSlider = document.getElementById('Slider-Gallery-{{ section.id }}');
      const thumbSlider = document.getElementById('Slider-Thumbnails-{{ section.id }}');
      const dotContainer = document.getElementById('custom-slider-dots');
      const isMobile = window.matchMedia('(max-width: 768px)').matches;

      let currentIndex = 0;
      let autoSlideInterval = null;

      function getVisibleSlides() {
        if (!mainSlider) return [];
        return Array.from(mainSlider.querySelectorAll('.variant-media-item')).filter(
          (slide) => slide.style.display !== 'none'
        );
      }

      function updateDots() {
        if (!dotContainer) return;
        dotContainer.querySelectorAll('.custom-dot').forEach((dot, i) => {
          dot.classList.toggle('active', i === currentIndex);
        });
      }

      function goToSlide(index) {
        const visibleSlides = getVisibleSlides();
        if (!visibleSlides.length || !visibleSlides[index]) return;
        currentIndex = index;
        visibleSlides[index].scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'start' });
        updateDots();
      }

      function resetAutoSlide() {
        if (!isMobile) return;
        if (autoSlideInterval) clearInterval(autoSlideInterval);
        startAutoSlide();
      }

      function startAutoSlide() {
        if (!isMobile) return;
        const visibleSlides = getVisibleSlides();
        if (visibleSlides.length <= 1) return;
        autoSlideInterval = setInterval(() => {
          const count = getVisibleSlides().length;
          if (count <= 1) return;
          currentIndex = (currentIndex + 1) % count;
          goToSlide(currentIndex);
        }, 3000);
      }

      function reinitMobileDots() {
        if (!dotContainer) return;
        dotContainer.innerHTML = '';
        const visibleSlides = getVisibleSlides();
        if (visibleSlides.length <= 1) return;

        currentIndex = 0;
        visibleSlides.forEach((slide, index) => {
          const dot = document.createElement('span');
          dot.classList.add('custom-dot');
          if (index === 0) dot.classList.add('active');
          dot.addEventListener('click', () => {
            goToSlide(index);
            resetAutoSlide();
          });
          dotContainer.appendChild(dot);
        });

        startAutoSlide();
      }

      // Scroll listener on main slider to update active dot and counter
      if (mainSlider) {
        mainSlider.addEventListener('scroll', () => {
          const visibleSlides = getVisibleSlides();
          if (!visibleSlides.length) return;
          const scrollPos = mainSlider.scrollLeft;
          let closestIdx = 0;
          let minDiff = Infinity;
          visibleSlides.forEach((s, idx) => {
            const diff = Math.abs(s.offsetLeft - scrollPos);
            if (diff < minDiff) {
              minDiff = diff;
              closestIdx = idx;
            }
          });
          currentIndex = closestIdx;
          updateDots();

          const counterCurrent = gallery.querySelector('.slider-counter--current');
          if (counterCurrent) counterCurrent.textContent = currentIndex + 1;
        });

        mainSlider.addEventListener('touchstart', () => {
          if (autoSlideInterval) clearInterval(autoSlideInterval);
        });
        mainSlider.addEventListener('touchend', () => {
          resetAutoSlide();
        });
      }

      // Variant switcher function
      function switchGalleryVariant(variantId, colorName) {
        const slides = gallery.querySelectorAll('#Slider-Gallery-{{ section.id }} .variant-media-item');
        const thumbs = gallery.querySelectorAll('#Slider-Thumbnails-{{ section.id }} .variant-thumbnail-item');
        if (!slides.length) return;

        const normColor = (colorName || '').trim().toLowerCase();

        // Check if there are variant-specific slides matching
        let matchingSlidesCount = 0;
        slides.forEach((slide) => {
          const sVarId = slide.dataset.variantId;
          const sColor = (slide.dataset.variantColor || '').trim().toLowerCase();
          if ((variantId && sVarId === String(variantId)) || (normColor && sColor && sColor === normColor)) {
            matchingSlidesCount++;
          }
        });

        const useDefault = matchingSlidesCount === 0;

        // Toggle slides
        let firstVisibleSlide = null;
        slides.forEach((slide) => {
          const sVarId = slide.dataset.variantId;
          const sColor = (slide.dataset.variantColor || '').trim().toLowerCase();
          const isMatch = useDefault
            ? sVarId === 'default'
            : (variantId && sVarId === String(variantId)) || (normColor && sColor && sColor === normColor);

          if (isMatch) {
            slide.style.removeProperty('display');
            slide.removeAttribute('aria-hidden');
            if (!firstVisibleSlide) firstVisibleSlide = slide;
          } else {
            slide.style.setProperty('display', 'none', 'important');
            slide.setAttribute('aria-hidden', 'true');
            slide.classList.remove('is-active');
          }
        });

        if (firstVisibleSlide) {
          firstVisibleSlide.classList.add('is-active');
        }

        // Toggle thumbnails
        let firstVisibleThumb = null;
        thumbs.forEach((thumb) => {
          const tVarId = thumb.dataset.variantId;
          const tColor = (thumb.dataset.variantColor || '').trim().toLowerCase();
          const isMatch = useDefault
            ? tVarId === 'default'
            : (variantId && tVarId === String(variantId)) || (normColor && tColor && tColor === normColor);

          const btn = thumb.querySelector('button');
          if (isMatch) {
            thumb.style.removeProperty('display');
            thumb.removeAttribute('aria-hidden');
            if (!firstVisibleThumb) firstVisibleThumb = thumb;
          } else {
            thumb.style.setProperty('display', 'none', 'important');
            thumb.setAttribute('aria-hidden', 'true');
            btn?.removeAttribute('aria-current');
          }
        });

        if (firstVisibleThumb) {
          firstVisibleThumb.querySelector('button')?.setAttribute('aria-current', 'true');
        }

        // Reset scroll position
        if (mainSlider) mainSlider.scrollTo({ left: 0, behavior: 'instant' });
        if (thumbSlider) thumbSlider.scrollTo({ left: 0, behavior: 'instant' });

        // Update counter total
        const actualVisible = getVisibleSlides();
        const counterTotal = gallery.querySelector('.slider-counter--total');
        const counterCurrent = gallery.querySelector('.slider-counter--current');
        if (counterTotal) counterTotal.textContent = actualVisible.length;
        if (counterCurrent) counterCurrent.textContent = '1';

        // Reinit dots
        reinitMobileDots();
      }

      // 1. Instant swatch change listener
      document.addEventListener('change', function (e) {
        const target = e.target;
        if (!target || !target.matches || !target.closest('#variant-selects-{{ section.id }}')) return;
        if (target.type === 'radio' || target.tagName === 'SELECT') {
          switchGalleryVariant(null, target.value);
        }
      });

      // 2. Dawn PUB_SUB variantChange subscriber
      if (typeof subscribe !== 'undefined' && typeof PUB_SUB_EVENTS !== 'undefined') {
        subscribe(PUB_SUB_EVENTS.variantChange, function (event) {
          if (!event || !event.data) return;
          const variant = event.data.variant;
          if (variant) {
            const color = variant.options ? variant.options[0] : null;
            switchGalleryVariant(variant.id, color);
          }
        });
      }

      // Initial mobile dots setup
      reinitMobileDots();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initGalleryController);
    } else {
      initGalleryController();
    }
  })();
</script>
