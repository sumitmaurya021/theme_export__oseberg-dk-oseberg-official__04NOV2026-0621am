    document.addEventListener("DOMContentLoaded", function () {

      const code = "Ba%2BZnaTbFpc%3D";
      const pricetagConfigs = [
         {
          type: "product",
          priceContainerSelector: "product-info .custom-title-price-sec",
          primaryPriceSelector: "product-info .custom-title-price-sec .price-item--regular",
          secondaryPriceSelector: "product-info .custom-title-price-sec .price-item--sale",
          style: "display:flex;justify-content:flex-start;"
        },
        {
          type: "mini-basket",
          priceContainerSelector: "cart-drawer .cart-drawer__footer > .totals:last-of-type",
          primaryPriceSelector: "cart-drawer .cart-drawer__footer > .totals:last-of-type .totals__total-value",
