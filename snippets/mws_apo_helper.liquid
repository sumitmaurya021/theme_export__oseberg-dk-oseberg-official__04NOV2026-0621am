<script>
function mwApoCustom() {

  function addDescription() {
    
    function getValue(id) {
      if (typeof mwApoInit.response !== "undefined") {
        for (const val of Object.values(mwApoInit.response)) {
          for (const key in val.values) {
            if (key == id) {
              if (typeof val.values[id]) {
                return val.values[id].value;
              }
            }
          }
        }
      }
    }    
    
    let options = document.querySelectorAll('.mw-option__value');
      options.forEach(element => {
        let id = element.getAttribute('data-value-id');
        let data = getValue(id); 
        let description = data.description;
        
        if (description) {
          let textValue = document.createElement('span');
          let targetItem = element.querySelector('.mw-label .mw-option__button');
  
          textValue.classList.add('mws-text__description');
          textValue.innerHTML = description;
          targetItem?.appendChild(textValue); 
        }
    });
  }
  
  function showDrawer() {
    const drawer = document.getElementById('custom-drawer');
    const drawerContent = drawer.querySelector('.custom-drawer__content');
    const drawerTitle = drawer.querySelector('.custom-drawer__title');
    const backdrop = document.getElementById('custom-backdrop');
    let lastContentContainer = null;
    
    document.querySelectorAll('.mw-option--type-button:not(.not-visible-in-drawer) .mw-collapsible--header').forEach(header => {
      header.addEventListener('click', () => {
        const collapsible = header.closest('.mw-collapsible');
        const content = collapsible.querySelector('.mw-collapsible--content');
        const title = header.querySelector('.mw-collapsible--header_text')?.innerText.trim();
    
        if (content) {
          lastContentContainer = collapsible;
          drawerContent.innerHTML = '';
          drawerContent.appendChild(content);
    
          drawerTitle.textContent = title;
    
          drawer.classList.add('open');
          backdrop.classList.add('active');
      
          const optionValues = document.querySelectorAll('.custom-drawer__content .mw-option__value');
          optionValues.forEach(value => {
              const description = value.querySelector('.mws-text__description');
              const price = value.querySelector('.mw-text.mw-option__price');
              if (description && price) {
                price.classList.add('has-days');
                price.appendChild(description);
              }
          });
 
        }
      });
    });
    
    function closeDrawer() {
      if (drawer.classList.contains('open')) {
        const content = drawerContent.querySelector('.mw-collapsible--content');
        if (lastContentContainer && content) {
          lastContentContainer.appendChild(content);
        }
    
        drawer.classList.remove('open');
        backdrop.classList.remove('active');
        document.body.classList.remove('drawer-open');
      }
    }
    
    document.querySelector('.custom-drawer__close').addEventListener('click', closeDrawer);
    
    backdrop.addEventListener('click', closeDrawer);
    
    document.addEventListener('click', (e) => {
      if (e.target.closest('.mw-option__value')) {
        closeDrawer();
      }
    });

  }

  function addSelectedImg() {  
      function getUrl(id) {
      	if (typeof mwApoInit.response !== "undefined") {
        for (const val of Object.values(mwApoInit.response)) {
          for (const key in val.values) {
            if (key == id) {
              if (
                typeof val.values[id].value.images !== "undefined" &&
                val.values[id].value.images.length
              ) {
                return val.values[id].value.images[0].url;
              }
            }
          }
        }
      }
    }

    document.querySelectorAll('.mw-option.mw-option--type-swatch').forEach(mwContainer => {
    const selected = mwContainer.querySelector('.mw-option__value--selected');
    
    if (selected) {
        const id = selected.getAttribute('data-value-id');
        const url = getUrl(id);

        if (url) {
            let existingImg = mwContainer.querySelector('.mws_img-add');
            if (existingImg) {
                existingImg.src = url;
            } else {
                const img = document.createElement('img');
                img.src = url;
                img.classList.add('mws_img-add');
                mwContainer.insertBefore(img, mwContainer.firstChild);
            }
        }
    }
});  
  }
  
  window.mwApoInit  = window.mwApoInit  || {};
  window.mwApoInit.onEvent = function (event, args) {  
    if (event == "init::finish") {
      setTimeout(function () {
       addDescription();
     }) 
      showDrawer();
   }
    
  };
  window.mwApoInit.onCallback = function (event, data) {
   if (event == "applyAttributeStateToHtml::price") {
     // if (window.innerWidth < 749) {
       addSelectedImg();
     // }
		 
   }
     return data;
  };
}
</script>

