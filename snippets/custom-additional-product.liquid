{% comment %}
This renders the Accessories card. When clicked, it opens a drawer with related products.
{% endcomment %}
{% if product.metafields.custom.tilbehor_products.value %}
<div class="accessory-card-wrapper">
  <!-- Accessory Trigger Card -->
  <div class="accessory-heading">
    <h2>Tilbehør</h2>
  </div>
  <div class="accessory-card" id="open-accessory-drawer">
    <div class="accessory-image">
      <img src="{{ product.metafields.custom.tilbehor_image | img_url: 'master' }}" alt="Accessories">
    </div>
    <div class="accessory-content">
      <p><strong>Spar op til 50% på tilbehør ved sengekøb</strong></p>
      <span class="highlight-text">Spar op til 50%</span>
    </div>
    <div class="accessory-arrow">›</div>
  </div>

  {% comment %}
  <!-- Accessory Drawer -->
  <div class="accessory-drawer hidden" id="accessory-drawer">
    <div class="drawer-header">
      <h4>Tilbehør</h4>
      <p>Spar op til 50% på tilbehør ved sengekøb</p>
      <button id="close-accessory-drawer">✕</button>
    </div>
    <div class="drawer-products">
      {% assign accessories = product.metafields.custom.tilbehor_products.value %}
      {% for accessory in accessories %}
        <div class="accessory-item {% if forloop.index > 2 %}hidden-accessory hidden{% endif %}" data-product-id="{{ accessory.id }}">
          <div class="accessory-thumb">
            <img src="{{ accessory.featured_image | image_url: width: 200 }}" alt="{{ accessory.title }}">
          </div>
          <div class="accessory-info">
            <h5>{{ accessory.title }}</h5>
            <p>Før {{ accessory.compare_at_price | money }}</p>
            <p class="new-price">+ {{ accessory.price | money }}</p>
            {% if accessory.compare_at_price %}<span class="discount-label">
              Spar
              {{
                accessory.compare_at_price
                | minus: accessory.price
                | times: 100
                | divided_by: accessory.compare_at_price
              | round }}%
            </span>{% endif %}
          </div>
          <div class="quantity-wrapper">
            <button class="qty-minus">−</button>
            <input type="number" value="1" min="1">
            <button class="qty-plus">+</button>
          </div>
          <button class="btn add-accessory" data-variant-id="{{ accessory.selected_or_first_available_variant.id }}">
            Tilføj
          </button>
        </div>       
      {% endfor %}
    </div>
    <button id="toggle-accessories" class="btn-see-more">Se mere tilbehør (2)</button>
  </div> 
  {% endcomment %}
</div>
{% endif %}
<!-- Styles -->
<style>
.custom-bundle-addons .accessory-card-wrapper {
  margin-top: 2rem;
  background: #F5F1EA;
  padding: 24px 20px;
  border-radius: 20px;
}
.custom-bundle-addons .accessory-card-wrapper .accessory-heading h2 {
    margin: 0 0 16px;
    font-weight: 700;
    font-size: 18px;
    line-height: 1.5em;
    font-family: 'Playfair Display', Georgia, 'Times New Roman', serif;
    color: #302821;
} 
/* Trigger card */
.custom-bundle-addons .accessory-card-wrapper .accessory-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 16px;
    cursor: pointer;
    border-radius: 8px;
    border: 1px solid #DED2C3;
}
.custom-bundle-addons .accessory-card-wrapper .accessory-card .accessory-image {
    width: 80px;
    height: auto;
    line-height: 0;
}
.custom-bundle-addons .accessory-card-wrapper .accessory-card .accessory-image img {
    width: 100%;
    aspect-ratio: 1/0.8;
    height: 100%;
    border-radius: 6px;
    object-fit: cover;
}
.custom-bundle-addons .accessory-card-wrapper .accessory-card  .accessory-content {
    flex: 1 1 0%;
}
.custom-bundle-addons .accessory-card-wrapper .accessory-card .accessory-content p,
.custom-bundle-addons .accessory-card-wrapper .accessory-card .accessory-content .highlight-text  {
    font-size: 14px;
    line-height: 20px;
    color: #302821;
    font-weight: 700;
    margin: 0;
    font-family: 'Jost', Arial, sans-serif;
}
.custom-bundle-addons .accessory-card-wrapper .accessory-card .accessory-content .highlight-text {
  color: #A58C76;
  font-weight: 400;
}
.custom-bundle-addons .accessory-card-wrapper .accessory-card .accessory-arrow {
    width: 16px;
    height: 16px;
    position: relative;
    font-size: 0;
    justify-content: center;
    display: flex;
    transition: 0.3s all;
}
.custom-bundle-addons .accessory-card-wrapper .accessory-card:hover .accessory-arrow {
    transform: translateX(.5rem);
}  
.custom-bundle-addons .accessory-card-wrapper .accessory-card .accessory-arrow::after {
    content: 'next';
    font-family: 'swiper-icons';
    font-size: 12px;
    font-weight: 700;
    color: #302821bf;
}

.mattress-topper-section .topper-mobile-grid {
    display: none !important;
}

/* Drawer */
.custom-bundle-addons .accessory-drawer {
    position: fixed;
    top: 0;
    right: 0;
    width: 100%;
    max-width: 450px;
    height: 100dvh;
    background: #F5F1EA;
    z-index: 9999;
    padding: 0;
    border-radius: 0;
    transform: translateX(0);
    transition: transform 0.3s ease-in-out;
    visibility: visible;
}
.accessory-drawer.hidden {
  transform: translateX(100%);
  visibility: hidden;
  display: block !important;
}
.custom-bundle-addons .accessory-drawer .accessory-drawer-close-icon {
    text-align: right;
    margin: 0;
    position: absolute;
    right: 20px;
    top: 10px;
}
.custom-bundle-addons .accessory-drawer .accessory-drawer-close-icon button {
    border: 0px;
    background-color: #302821;
    width: 35px;
    height: 35px;
    border-radius: 100%;
    font-family: 'swiper-icons';
    font-size: 20px;
    line-height: 20px;
    color: #FFFFFF;
    padding: 0px;
    cursor: pointer;
}  
.custom-bundle-addons .accessory-drawer .accessory-drawer-overflow {
    overflow-y: auto !important;
    height: 100%;
    margin-top: 34px;
} 
.custom-bundle-addons .accessory-drawer .accessory-drawer-main-content {
    /* border: 1px solid #dfdfdf; */
    background-color: #F5F1EA;
    /* border-radius: 20px; */
    padding: 0 20px;
}  
.custom-bundle-addons .accessory-drawer .accessory-drawer-main-content .drawer-header {
    padding-bottom: 8px;
}
.custom-bundle-addons .accessory-drawer .accessory-drawer-main-content .drawer-header h4 {
    font-size: 20px;
    line-height: 28px;
    font-weight: 700;
    margin: 0;
    color: #302821;
    font-family: 'Playfair Display', Georgia, 'Times New Roman', serif;
}
.custom-bundle-addons .accessory-drawer .accessory-drawer-main-content .drawer-header p {
    margin: 0px;
    font-size: 16px;
    line-height: 22.4px;
    font-family: 'Jost', Arial, sans-serif;
    color: #302821;
}  
.drawer-header button {
  background: none;
  border: none;
  font-size: 1.5rem;
  position: absolute;
  top: 0;
  right: 0;
  cursor: pointer;
}

/* Product card inside drawer */
.custom-bundle-addons .accessory-drawer .accessory-drawer-main-content .drawer-products {
    display: flex;
    flex-direction: column;
    gap: 8px;
}
.custom-bundle-addons .accessory-drawer .accessory-drawer-main-content .drawer-products .accessory-item {
    padding: 16px;
    border-radius: 16px;
    border: 1px solid #DED2C3;
}
.custom-bundle-addons .accessory-drawer .accessory-drawer-main-content .drawer-products .accessory-item .accessory-item-content {
    display: flex;
    gap: 16px;
}
.custom-bundle-addons .accessory-drawer .accessory-drawer-main-content .drawer-products .accessory-item .accessory-thumb {
    width: 118px;
}
.custom-bundle-addons .accessory-drawer .accessory-drawer-main-content .drawer-products .accessory-item img {
    border-radius: 6px;
    height: auto;
    width: 100%;
}
.custom-bundle-addons .accessory-drawer .accessory-drawer-main-content .drawer-products .accessory-item span {
    border-radius: 6px;
}
.custom-bundle-addons .accessory-drawer .accessory-drawer-main-content .drawer-products .accessory-item .accessory-info {
    flex: 1 1 0%;
}
.custom-bundle-addons .accessory-drawer .accessory-drawer-main-content .drawer-products .accessory-item .accessory-info h5 {
    margin: 0;
    font-size: 14px;
    line-height: 20px;
    color: #302821;
    font-family: 'Jost', Arial, sans-serif;
}
.custom-bundle-addons .accessory-drawer .accessory-drawer-main-content .drawer-products .accessory-item .accessory-info-prices {
    display: flex;
    gap: 12px;
}  
.custom-bundle-addons .accessory-drawer .accessory-drawer-main-content .drawer-products .accessory-item .accessory-info-prices .accessory-info-prices-left,
.custom-bundle-addons .accessory-drawer .accessory-drawer-main-content .drawer-products .accessory-item .accessory-info-prices .accessory-info-prices-right {
    width: 100%;
}
.custom-bundle-addons .accessory-drawer .accessory-drawer-main-content .drawer-products .accessory-item .accessory-info-prices .accessory-info-prices-right {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
}
.custom-bundle-addons .accessory-drawer .accessory-drawer-main-content .drawer-products .accessory-item .accessory-info-prices:has(:not(.accessory-info-prices-left)) .accessory-info-prices-right {
    width: 100% !important;
}  
.custom-bundle-addons .accessory-drawer .accessory-item .accessory-info-prices p {
    font-size: 14px;
    line-height: 20px;
    margin: 0;
    color: #302821;
    font-family: 'Jost', Arial, sans-serif;
}
.custom-bundle-addons .accessory-drawer .accessory-item .accessory-info-prices .accessory-info-prices-right p {
    font-weight: 400;
    color: #302821;
}
.custom-bundle-addons .accessory-drawer .accessory-item .accessory-info-prices .accessory-info-prices-right .discount-label {
    background-color: #A58C76;
    color: #fff;
    margin: 0px;
    /* border-radius: 100px; */
    padding: 4px 8px;
    display: block;
    font-size: 12px;
    line-height: 16px;
    display: inline-block;
    font-family: 'Jost', Arial, sans-serif;
}
.custom-bundle-addons .accessory-drawer .accessory-item .accessory-info-prices .accessory-info-prices-right .discount-label {
    border-radius: 6px;
}
.custom-bundle-addons .accessory-drawer .drawer-products .accessory-item .product-buttons {
    display: flex;
    gap: 16px;
    padding-top: 16px;
}  
/* Quantity stepper */
.custom-bundle-addons .accessory-drawer .drawer-products .accessory-item .product-buttons .quantity-wrapper {
    width: 50%;
    gap: 0;
    min-height: 42px;
    border: 1px solid #DED2C3;
    border-radius: 20px;
    margin: 0px;
    display: flex;
    align-items: center;
}
.custom-bundle-addons .accessory-drawer .drawer-products .accessory-item .product-buttons .quantity-wrapper button {
    /* padding: 8px 16px; */
    width: 33.33%;
    font-size: 24px;
    line-height: 1em;
    background-color: transparent;
    border: 0;
    cursor: pointer;
    color: #302821;
    font-family: 'Jost', Arial, sans-serif;
}
.custom-bundle-addons .accessory-drawer .drawer-products .accessory-item .product-buttons .quantity-wrapper input {
    border: 0px;
    text-align: center;
    font-size: 16px;
    line-height: 22.4px;
    color: #302821;
    width: 33.33%;
    font-family: 'Jost', Arial, sans-serif;
}

/* Add button */
.custom-bundle-addons .accessory-drawer .drawer-products .accessory-item .product-buttons .btn.add-accessory {
    width: 50%;
    border-radius: 60px;
    color: #fff;
    min-height: 42px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    grid-gap: 8px;
    margin: 0;
    padding: 12px 20px;
    font-size: 16px;
    line-height: 1;
    font-weight: 500;
    background-color: #302821;
    border: 1px solid #302821;
    text-decoration: none;
    overflow: hidden;
    position: relative;
    cursor: pointer;
    transition: all .1s;
    font-family: 'Jost', Arial, sans-serif;
}
.custom-bundle-addons .accessory-drawer .drawer-products .accessory-item .product-buttons .btn.add-accessory span {
    transition: all .3s;
    position: relative;
    top: 0;
}  
.custom-bundle-addons .accessory-drawer .drawer-products .accessory-item .product-buttons .btn.add-accessory::before {
    content: attr(title);
    position: absolute;
    transform: translateY(40px);
    left: 0;
    right: 0;
    transition: all .3s;
}  
.custom-bundle-addons .accessory-drawer .drawer-products .accessory-item .product-buttons .btn.add-accessory:hover::before {
    transform: translateY(0);
}  
.custom-bundle-addons .accessory-drawer .drawer-products .accessory-item .product-buttons .btn.add-accessory:hover span {
    top: -40px;
}  
.custom-bundle-addons .accessory-drawer .drawer-products .accessory-item .product-buttons .btn.add-accessory:hover {
    background-color: #302821;
    color: #fff;
}  

/* Toggle */
.custom-bundle-addons .accessory-drawer .accessory-drawer-main-content .btn-see-more {
    display: block;
    width: 100%;
    padding: 0px;
    margin-top: 24px;
    font-size: 16px;
    line-height: 22.4px;
    color: #302821;
    font-weight: 400;
    border: 0;
    background-color: transparent;
    position: relative;
    font-family: 'Jost', Arial, sans-serif;
}
.custom-bundle-addons .accessory-drawer .accessory-drawer-main-content .btn-see-more span {
    position: relative;
    padding: 7.5px 40px 7.5px 0;
    cursor: pointer;
}
.custom-bundle-addons .accessory-drawer .accessory-drawer-main-content .btn-see-more span::before {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    background: url(https://cdn.shopify.com/s/files/1/0903/5877/6187/files/black-arrow.svg?v=1743760026 ) no-repeat center;
    /* background-size: contain; */
    width: 18px;
    height: 18px;
    padding: 15px;
    border: 1px solid #DED2C3;
    border-radius: 100px;
}
.custom-bundle-addons .accessory-drawer .accessory-drawer-main-content .btn-see-more span.active::before {
    transform: rotate(180deg);
}  
@media screen and (max-width: 1023px) {
  .custom-bundle-addons .accessory-drawer {
      max-width: 100%;
  }
  .mattress-topper-section .topper-grid {
      display: none !important;
  }
  .mattress-topper-section .topper-mobile-grid {
      display: block !important;
  }
}
  
/* Utility */
.hidden {
  display: none !important;
}
</style>

<!-- Scripts -->
<script>
document.addEventListener('DOMContentLoaded', function () {
  {% comment %} const toggleBtn = document.getElementById('toggle-accessories');
  const toggleBtnText = toggleBtn.querySelector('span');
  const hiddenItems = document.querySelectorAll('.hidden-accessory');
  let expanded = false;

  if (toggleBtn) {
    toggleBtn.addEventListener('click', function () {
      expanded = !expanded;
      hiddenItems.forEach(item => {
        item.classList.toggle('hidden', !expanded);
      });
      toggleBtnText.innerText = expanded
        ? 'Se mindre (2)'
        : `Se mere tilbehør (2)`;

    toggleBtnText.classList.toggle('active', expanded);
    });
  } {% endcomment %}

  const drawer = document.getElementById('accessory-drawer');
  const openBtn = document.getElementById('open-accessory-drawer');
  const closeBtn = document.getElementById('close-accessory-drawer');

  openBtn?.addEventListener('click', () => drawer.classList.remove('hidden'));
  closeBtn?.addEventListener('click', () => drawer.classList.add('hidden'));

  document.querySelectorAll('.qty-plus').forEach(btn => {
    btn.addEventListener('click', e => {
      const input = e.target.previousElementSibling;
      input.value = parseInt(input.value) + 1;
    });
  });

  document.querySelectorAll('.qty-minus').forEach(btn => {
    btn.addEventListener('click', e => {
      const input = e.target.nextElementSibling;
      if (parseInt(input.value) > 1) input.value = parseInt(input.value) - 1;
    });
  });

  document.querySelectorAll('.add-accessory').forEach(button => {
    button.addEventListener('click', function () {
      const variantId = this.dataset.variantId;
      const quantity = this.parentElement.querySelector('input[type="number"]').value;

      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: variantId, quantity: parseInt(quantity) })
      })
        .then(res => res.json())
        {% comment %} .then(() => alert('Tilføjet til kurven!')) {% endcomment %}
        .catch(() => alert('Noget gik galt. Prøv igen.'));
    });
  });
});
</script>
