o_show":100,"columns_desktop":3,"full_width":false,"show_view_all":true,"view_all_style":"solid","enable_desktop_slider":false,"color_scheme":"scheme-2","enable_load_more":true,"image_ratio":"adapt","image_shape":"default","show_secondary_image":false,"show_vendor":false,"show_rating":false,"quick_add":"none","columns_mobile":"2","swipe_on_mobile":false,"padding_top":36,"padding_bottom":36}},"custom_collection_product_8bh7Pk":{"type":"custom-collection-product","disabled":true,"settings":{"subtext_heading":"Vores søvnhack","main_heading":"Bambus Exclusive Sengetøj","main_description":"<p><strong>Bambus – Exclusive Sengesæt<\/strong><\/p><p>Vores bambus sengesæt er skabt til dig, der ønsker en silkeblød og temperaturregulerende soveløsning. Stoffet er vævet af naturlig bambusviskose, som føles let og glat mod huden – perfekt til både varme og kølige nætter. Det elegante udtryk kombineres med høj funktionalitet og gør sengesættet til en luksuriøs tilføjelse i soveværelset.<\/p>","collections":["striped-exclusive","striped-exclusive_140x220","striped-exclusive_200x220","striped-exclusive_240x220"],"show_collection_tabs":true,"image_ratio":"adapt","image_shape":"default","show_secondary_image":false,"show_vendor":false,"show_rating":false,"quick_add":"none","background_color":"#f1efec","padding_top":40,"padding_bottom":40}},"custom_img_txt_accordion_P4UKFY":{"type":"custom-img-txt-accordion","blocks":{"content_block_8kLwk6":{"type":"content_block","settings":{"heading":"Lagner","description":"<p>Det rette lagen gør en større forskel, end man måske tror. Det skaber ikke kun en glat og indbydende overflade i sengen – det er også med til at forbedre komforten og beskytte madrassen. Vores lagner er udvalgt med fokus på pasform, åndbarhed og holdbar kvalitet, så de ligger flot på madrassen og føles behagelige mod huden. Når lagnet sidder perfekt, mærker du forskellen fra første nat.<\/p>"}},"accordion_block_w89zFW":{"type":"accordion_block","settings":{"accordion_heading":"Hvad er forskellen på kuvert- og faconlagner?","accordion_content":"<p>Kuvertlagner passer til topmadrasser, mens faconlagner er til madrasser med mere højde. Begge findes i forskellige størrelser og kvaliteter.<\/p>"}},"accordion_block_EzTFkh":{"type":"accordion_block","settings":{"accordion_heading":"Hvordan vedligeholder jeg mit lagen bedst?","accordion_content":"<p>Vask lagnet ved op til 60 °C for optimal hygiejne. Det bevarer sin blødhed og glans vask efter vask, især hvis du undgår overdreven tørretumbling. På den måde holder både pasform og komfort i mange år.<\/p>"}},"accordion_block_kmfVWQ":{"type":"accordion_block","settings":{"accordion_heading":"Er lagnerne Øko-Tex eller bæredygtigt?","accordion_content":"<p>Ja, vi fører flere varianter i økologiske og certificerede materialer. Spørg os endelig – vi guider dig gerne til det rette valg.<\/p>"}}},"block_order":["content_block_8kLwk6","accordion_block_w89zFW","accordion_block_EzTFkh","accordion_block_kmfVWQ"],"settings":{"custom_id":"","background_color":"#ffffff","padding_top":65,"padding_bottom":65}}},"order":["main","custom_breadcrumb_section_feTXA9","custom_rich_main_page_ArNEbc","weekly_recommendation_8i8AVp","choose_size_GBN788","featured_collection_4jrwwJ","custom_collection_product_8bh7Pk","custom_img_txt_accordion_P4UKFY"]}