    "custom_img_txt_accordion_4KVBPc": {
      "type": "custom-img-txt-accordion",
      "blocks": {
        "content_block_rqdFcb": {
          "type": "content_block",
          "settings": {
            "heading": "Ofte stillede spørgsmål",
