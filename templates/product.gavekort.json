      "blocks": {
        "question_caMHQJ": {
          "type": "question",
          "settings": {
            "question_text": "Hvorfor er et gavekort en god gave?",
            "answer_text": "<p>Et gavekort er en fleksibel gave, hvor modtageren selv kan vælge præcis det, de ønsker. Det gør det nemt at give en gave, der altid rammer rigtigt.</p>"
          }
        },
        "question_hzXz9J": {
          "type": "question",
          "settings": {
            "question_text": "Hvornår er et gavekort en god løsning?",
            "answer_text": "<p>Gavekort er ideelle, når du er i tvivl om størrelse, stil eller behov – eller hvis du mangler en gave i sidste øjeblik, da de kan købes og sendes hurtigt digitalt.</p>"
          }
        },
        "question_x6eEaL": {
          "type": "question",
          "settings": {
            "question_text": "Hvor længe er et gavekort gyldigt?",
            "answer_text": "<p>Som udgangspunkt er gavekort gyldige i op til <strong>3 år</strong>, medmindre andet er oplyst ved køb. Det giver modtageren god tid til at bruge gaven. </p>"
          }
        },
        "question_9xGqqe": {
          "type": "question",
          "settings": {
            "question_text": "Hvad er fordelene ved gavekort for modtageren?",
            "answer_text": "<p>Modtageren får frihed til selv at vælge produkter, hvilket giver en mere personlig oplevelse og sikrer, at gaven faktisk bliver brugt. </p>"
          }
        }
      },
